#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Pre-commit validation and translation generation..."

# 1) Validate content & update registry if needed
echo "📋 Validating content structure..."
tsx scripts/validation/validate-content-precommit-simple.ts

if [ -f "data/content-registry.json.updated" ]; then
  git add data/content-registry.json
  rm data/content-registry.json.updated
fi

# 2) Only proceed if MD/MDX staged
if ! git diff --cached --name-only | grep -E '^src/content/.*\.(md|mdx)$' >/dev/null; then
  echo "ℹ️  No content files staged, skipping translation generation"
  exit 0
fi

# 3) Detect missing/stale translations (registry-based)
echo "🔍 Detecting translation tasks..."
if tsx scripts/translations/check_translations_registry.ts > translation-tasks.json 2>/dev/null; then
  echo "✅ Translation detection completed"
else
  echo "⚠️  Translation detection failed, creating empty task list"
  echo "[]" > translation-tasks.json
fi

# 4) Generate translations (but don't block commit)
if [ -s translation-tasks.json ]; then
  # Check if file contains valid JSON (starts with [ or {)
  first_char=$(head -c 1 translation-tasks.json)
  if [[ "$first_char" == "[" ]] || [[ "$first_char" == "{" ]]; then
    if [ "$(cat translation-tasks.json)" != "[]" ]; then
      echo "🤖 Generating AI translations (will be marked as draft and require review)..."
      cat translation-tasks.json | tsx scripts/translations/generate_translations_registry.ts
      echo "✅ Translations generated successfully"
      echo "📋 Note: Generated translations are marked as draft and require human review"
      echo "   • Review the translations in the generated files"
      echo "   • Set draft=false and status.review.translation=true when ready"
      git add src/content
    else
      echo "ℹ️ No translation tasks found"
    fi
  else
    echo "⚠️  Invalid JSON in translation-tasks.json, skipping translation generation"
    echo "Content preview: $(head -n 1 translation-tasks.json)"
  fi
else
  echo "ℹ️ No translation tasks file created"
fi

rm -f translation-tasks.json

echo "✅ Pre-commit processing completed"
echo "💡 Reminder: Review generated translations before pushing!"
