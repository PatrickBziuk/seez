# Environment-specific content configuration

# URL Strategy (production only)
# Set to 'true' to use canonical IDs in URLs for immutable links
# Set to 'false' (default) to use human-readable slugs
USE_CANONICAL_URLS=false

# Content validation level
# 'strict' - Require all metadata fields (production default)
# 'relaxed' - Allow missing optional fields (development default)  
CONTENT_VALIDATION=relaxed

# Canonical ID auto-generation (development only)
# 'true' - Auto-generate missing canonical IDs with warning
# 'false' - Fail validation if canonical ID missing
AUTO_GENERATE_CANONICAL_IDS=true
