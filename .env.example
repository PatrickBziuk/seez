# Environment Variables for Local Development
# Copy this file to .env.local and add your actual values
# DO NOT commit .env.local to version control
# as it will reveal your secrets to the public (and you dont want that to happen)
# Trust me Bro

# OpenAI API Key for local translation generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Translation quality threshold (default: 70)
TRANSLATION_QUALITY_THRESHOLD=70

# GitHub token for local development (optional)
# Only needed if you want to test GitHub API features locally
# GITHUB_TOKEN=ghp_your-github-token-here

# Example configuration:
# OPENAI_API_KEY=sk-proj-abcd1234...
# TRANSLATION_QUALITY_THRESHOLD=75
