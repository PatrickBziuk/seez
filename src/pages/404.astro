---
/**
 * 404 - bilingual, in the site frame (one 404.html serves every path on GitHub Pages).
 * Decoration: the fish-dragon from the early drawing "Elysium" (Skizzenbuch 2011–2013).
 */
import Layout from '~/layouts/PageLayout.astro';
import FigureGlyph from '~/components/seez/FigureGlyph.astro';
import SketchInk from '~/components/seez/sketch/SketchInk.astro';
import { INK } from '~/data/sketches';
import { sectionUrl } from '~/utils/routes';

const metadata = { title: 'Seite nicht gefunden · Page not found', robots: { index: false, follow: true } };
---

<Layout metadata={metadata}>
  <section class="sz-container nf">
    <SketchInk ink={INK.fischdrache} class="nf__ink" colour="var(--text-faint)" />
    <p class="sz-label">Fehler 404 · Error 404</p>
    <h1 class="sz-display nf__title">Hier ist nichts.</h1>
    <p class="sz-lead">Diese Seite gibt es nicht oder nicht mehr. Vielleicht ist sie umgezogen.</p>
    <div class="sz-btn-row nf__actions">
      <a class="sz-btn sz-btn--primary" href="/de">Zur Startseite</a>
      <a class="sz-btn" href={sectionUrl('de', 'music')}>Musik</a>
      <a class="sz-btn" href={sectionUrl('de', 'fragments')}>Fragmente</a>
    </div>

    <div class="nf__en" lang="en">
      <p class="sz-h2">Nothing here.</p>
      <p class="sz-lead">This page does not exist, or not any more. Maybe it moved.</p>
      <div class="sz-btn-row nf__actions">
        <a class="sz-btn" href="/en">Home</a>
        <a class="sz-btn" href={sectionUrl('en', 'music')}>Music</a>
        <a class="sz-btn" href={sectionUrl('en', 'fragments')}>Fragments</a>
      </div>
    </div>
    <p class="nf__glitch" aria-hidden="true"><FigureGlyph id="gl1tch" size={28} /></p>
  </section>
</Layout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    padding-top: var(--sp-8);
    padding-bottom: var(--sp-8);
  }
  /* The fish-dragon sits behind the text: faint, never in the way of reading */
  .nf :global(.nf__ink) {
    position: absolute;
    z-index: -1;
    top: var(--sp-6);
    right: var(--gutter);
    width: min(62vw, 520px);
    opacity: 0.14;
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .nf :global(.nf__ink) {
      opacity: 0.22;
    }
  }
  .nf__title {
    margin: var(--sp-3) 0 var(--sp-5);
  }
  .nf__actions {
    margin-top: var(--sp-5);
  }
  .nf__en {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }
  .nf__glitch {
    margin-top: var(--sp-7);
    color: #3fd8f0;
  }
</style>
