---
import type { GetStaticPaths } from 'astro';
import FigurePage from '~/components/pages/FigurePage.astro';
import { getFigureDossiers, type FigureDossier } from '~/utils/fragments';

export const getStaticPaths = (async () => {
  const dossiers = await getFigureDossiers('en');
  return dossiers.map((d) => ({ params: { slug: d.figure.id }, props: { ...d } }));
}) satisfies GetStaticPaths;

const { figure, entry } = Astro.props as FigureDossier;
---

<FigurePage lang="en" figure={figure} entry={entry} />
