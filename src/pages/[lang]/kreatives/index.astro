---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = (() => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

const metadata = {
  title: lang === 'de' ? 'Creative Core' : 'Creative Core',
  description:
    lang === 'de'
      ? 'Die kreative Engine hinter Seez: Visuals, Narrative und Audio in einem verbundenen Prozess.'
      : 'The creative engine behind Seez: visuals, narrative, and audio in one connected process.',
};
---

<Layout metadata={metadata}>
  <section class="core-shell min-h-screen px-4 sm:px-6 py-10 md:py-16">
    <div class="grid-bg" aria-hidden="true"></div>

    <header class="mb-16 flex flex-col items-center text-center max-w-4xl mx-auto relative z-10">
      <div class="text-xs text-cyan-300 mb-2 border border-cyan-400/30 px-2 py-1 rounded">&gt; MODULE: CREATIVE_ENGINE</div>
      <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight uppercase">THE BLACK BOX</h1>
      <p class="max-w-2xl text-gray-300 text-sm leading-relaxed">
        {
          lang === 'de'
            ? 'Ein Prozess statt einem Tool-Stack: Emotion, Iteration und Produktion greifen ineinander. KI bleibt Verstärker, nicht Ursprung.'
            : 'A process, not a tool stack: emotion, iteration, and production work as one. AI stays amplifier, not origin.'
        }
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs uppercase tracking-wide">
        <a class="chip" href={`/${lang}/system-logs`}>System Logs</a>
        <a class="chip" href={`/${lang}/musik`}>Sonic Archive</a>
        <a class="chip" href={`/${lang}/blog`}>Blog</a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto relative min-h-[720px] z-10">
      <div class="absolute left-1/2 top-3 -translate-x-1/2 z-20">
        <div class="relative w-24 h-24 bg-black border-2 border-white rounded-full flex items-center justify-center">
          <div class="pulse-ring w-full h-full"></div>
          <span class="font-bold text-xl">SEEZ</span>
        </div>
      </div>

      <svg class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-40" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M50 12 L20 40" stroke="#00f3ff" stroke-width="0.2" fill="none" />
        <path d="M50 12 L50 40" stroke="#00f3ff" stroke-width="0.2" fill="none" />
        <path d="M50 12 L80 40" stroke="#00f3ff" stroke-width="0.2" fill="none" />
        <path d="M20 56 L50 86" stroke="#22d3ee" stroke-width="0.2" fill="none" />
        <path d="M50 56 L50 86" stroke="#22d3ee" stroke-width="0.2" fill="none" />
        <path d="M80 56 L50 86" stroke="#22d3ee" stroke-width="0.2" fill="none" />
      </svg>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 absolute top-[210px] w-full z-10">
        <article class="process-card p-5 rounded-lg">
          <p class="text-xs text-cyan-300 mb-2">VISUAL CORE</p>
          <h2 class="text-xl font-bold mb-2">ComfyUI + ControlNet</h2>
          <p class="text-xs text-gray-400 mb-4">
            {lang === 'de'
              ? 'Skizzen werden in visuelle Identitäten gerendert. Die Handschrift bleibt menschlich, die Ausführung wird präziser.'
              : 'Sketches are rendered into visual identities. Human signature stays; execution gets sharper.'}
          </p>
          <div class="h-1 w-full bg-gray-800 rounded overflow-hidden"><div class="h-full bg-cyan-400 w-2/3 animate-pulse"></div></div>
        </article>

        <article class="process-card p-5 rounded-lg">
          <p class="text-xs text-cyan-300 mb-2">NARRATIVE CORE</p>
          <h2 class="text-xl font-bold mb-2">LLM Iteration</h2>
          <p class="text-xs text-gray-400 mb-4">
            {lang === 'de'
              ? 'Sätze werden hundertfach geschliffen, bis sie tragen. Nicht der erste Output gewinnt, sondern der ehrlichste.'
              : 'Lines are iterated heavily until they hold. Not first output wins, the most honest one does.'}
          </p>
          <div class="h-1 w-full bg-gray-800 rounded overflow-hidden"><div class="h-full bg-cyan-400 w-full animate-pulse" style="animation-duration: 2.6s"></div></div>
        </article>

        <article class="process-card p-5 rounded-lg">
          <p class="text-xs text-cyan-300 mb-2">AUDIO CORE</p>
          <h2 class="text-xl font-bold mb-2">Suno + Logic Pro</h2>
          <p class="text-xs text-gray-400 mb-4">
            {lang === 'de'
              ? 'Ideen starten digital und enden in menschlichem Feintuning. Layering, Rauschen und Haltung machen den Unterschied.'
              : 'Ideas start digitally and finish with human refinement. Layering, noise, and intent create the difference.'}
          </p>
          <div class="h-1 w-full bg-gray-800 rounded overflow-hidden"><div class="h-full bg-cyan-400 w-1/2 animate-pulse" style="animation-duration: 1.4s"></div></div>
        </article>
      </div>

      <div class="absolute top-[610px] left-1/2 -translate-x-1/2 w-full max-w-4xl text-center z-20 pb-8">
        <h3 class="text-2xl font-bold mb-6">RESULT: THE SPLINTERS</h3>
        <div class="flex justify-center gap-3 flex-wrap text-xs uppercase tracking-wide">
          <a href={`/${lang}/fragmente/drift`} class="tag-chip">DRIFT</a>
          <a href={`/${lang}/fragmente/splinter`} class="tag-chip">SPLINTER</a>
          <a href={`/${lang}/fragmente/shift`} class="tag-chip">SHIFT</a>
          <a href={`/${lang}/fragmente/lume`} class="tag-chip">LUME</a>
          <a href={`/${lang}/fragmente/sz-006-unknown`} class="tag-chip">UNKNOWN</a>
          <a href={`/${lang}/fragmente/gl1tch`} class="tag-chip">GL1TCH</a>
        </div>
      </div>
    </main>
  </section>
</Layout>

<style>
  .core-shell {
    --bg-color: #030305;
    background: radial-gradient(circle at 20% 0%, rgba(14, 116, 144, 0.25), transparent 30%), var(--bg-color);
    color: #e5e7eb;
    position: relative;
    overflow: hidden;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(0, 243, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 243, 255, 0.06) 1px, transparent 1px);
    background-size: 38px 38px;
    transform: perspective(500px) rotateX(60deg) translateY(-100px) scale(2);
    animation: grid-move 18s linear infinite;
    opacity: 0.32;
    pointer-events: none;
  }

  @keyframes grid-move {
    0% {
      transform: perspective(500px) rotateX(60deg) translateY(0) scale(2);
    }
    100% {
      transform: perspective(500px) rotateX(60deg) translateY(38px) scale(2);
    }
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1px solid #22d3ee;
    animation: pulse-out 2s infinite ease-out;
    opacity: 0;
  }

  @keyframes pulse-out {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .process-card {
    background: rgba(6, 10, 15, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(4px);
    transition: 0.25s ease;
  }

  .process-card:hover {
    border-color: #22d3ee;
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.2);
    transform: translateY(-2px);
  }

  .chip,
  .tag-chip {
    border: 1px solid #334155;
    padding: 0.4rem 0.7rem;
    transition: 0.2s ease;
  }

  .chip:hover,
  .tag-chip:hover {
    border-color: #22d3ee;
    color: #67e8f9;
  }

  .tag-chip:hover {
    background: #f8fafc;
    color: #020617;
  }
</style>
