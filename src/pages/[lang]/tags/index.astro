---
import { getPublicCollection } from '~/utils/publication';
/**
 * TagsIndex - Overview page showing all available tags
 * @props lang: SupportedLanguage - Current language from route params
 * @behavior Lists all unique tags from all content collections, grouped and sorted
 * @dependencies getCollection, SUPPORTED_LANGUAGES, getTranslations
 * @usedBy Direct navigation to /[lang]/tags
 */
import Layout from '../../../layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import { SUPPORTED_LANGUAGES, getTranslations } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';
import { getPermalink } from '../../../utils/permalinks';

export const getStaticPaths = () => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
};

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = await getTranslations(lang);

// Get content from relevant collections
// Same collections as /[lang]/tags/[tag] (projects have no pages any more), so every tag links somewhere.
const [music, texts, figures] = await Promise.all([
  getPublicCollection('music'),
  getPublicCollection('texts'),
  getPublicCollection('fragments'),
]);

// Combine and filter by language
const allContent = [...music, ...texts, ...figures].filter((item) => item.data.language === lang);

// Extract unique tags
const tagCounts = new Map<string, number>();
allContent.forEach((item) => {
  item.data.tags?.forEach((tag: string) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Sort tags alphabetically
const sortedTags = Array.from(tagCounts.entries()).sort(([a], [b]) => a.localeCompare(b));

const metadata = {
  title: `${t.navigation?.tags || 'Tags'} - ${lang === 'de' ? 'Alle Themen' : 'All Topics'}`,
  description:
    lang === 'de'
      ? 'Entdecke alle verfügbaren Themen und Tags auf dieser Website.'
      : 'Discover all available topics and tags on this website.',
};
---

<Layout metadata={metadata}>
  <PageHead
    title={lang === 'de' ? 'Themen' : 'Topics'}
    label={lang === 'de' ? `${sortedTags.length} Schlagworte` : `${sortedTags.length} keywords`}
    crumbs={[{ href: `/${lang}/${lang === 'de' ? 'archiv' : 'archive'}`, text: lang === 'de' ? 'Archiv' : 'Archive' }, { text: lang === 'de' ? 'Themen' : 'Topics' }]}
  />
  <section class="sz-container tags">
    <label class="sz-label" for="tag-filter">{lang === 'de' ? 'Filtern' : 'Filter'}</label>
    <input id="tag-filter" type="search" class="tags__filter" autocomplete="off" />
    <ul id="tag-list" class="tags__list">
      {
        sortedTags.map(([tag, count]) => (
          <li>
            <a href={getPermalink(`/${lang}/tags/${encodeURIComponent(tag)}`)}>
              {tag} <span class="sz-mono tags__n">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  const input = document.getElementById('tag-filter') as HTMLInputElement | null;
  const list = document.getElementById('tag-list');
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    list?.querySelectorAll('li').forEach((li) => {
      li.hidden = !(li.textContent || '').toLowerCase().includes(q);
    });
  });
</script>

<style>
  .tags {
    padding-bottom: var(--section-gap);
  }
  .tags__filter {
    display: block;
    width: 100%;
    max-width: 420px;
    min-height: 44px;
    margin: var(--sp-2) 0 var(--sp-6);
    padding: 0 var(--sp-3);
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .tags__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tags__list a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }
  .tags__list a:hover {
    border-color: var(--text);
  }
  .tags__n {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
</style>
