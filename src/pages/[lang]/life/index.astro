---
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Life Archive', 'Life Archive'),
  description: t('Persönliche Fragmente erscheinen nur, wenn sie Teil des Seez-Kosmos sind.', 'Personal fragments appear only when they are part of the Seez cosmos.'),
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-[#07080b] px-4 py-14 text-slate-100 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs uppercase tracking-[0.28em] text-lime-300">&gt; LIFE_ROUTE / FILTERED</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{t('Kein Tagebuch. Nur Fragmente.', 'No diary. Only fragments.')}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">
        {t(
          'Private Texte werden nicht als eigener Lifestyle-Bereich ausgespielt. Was öffentlich ist, muss Seez tragen: Figuren, Songs, Logs, Splitter.',
          'Private writing is not published as a lifestyle section. Public material must serve Seez: figures, songs, logs, fragments.'
        )}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="portal" href={`/${lang}/fragmente`}>{t('Fragmente öffnen', 'Open fragments')}</a>
        <a class="portal" href={`/${lang}/lyrics`}>Lyrics Vault</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .portal {
    border: 1px solid rgba(190, 242, 100, 0.35);
    color: #d9f99d;
    display: inline-block;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.8rem 1rem;
    text-transform: uppercase;
  }
</style>
