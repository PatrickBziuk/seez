---
import Layout from '../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../utils/i18n';
import type { SupportedLanguage } from '../../utils/i18n';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Werkzeuge', 'Tools'),
  description: t('Die Werkzeuge hinter Seez werden als Produktionsnotizen eingeordnet.', 'The tools behind Seez are framed as production notes.'),
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-[#07080b] px-4 py-14 text-slate-100 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs uppercase tracking-[0.28em] text-cyan-300">&gt; TOOLCHAIN / ART_CONTEXT</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{t('Werkzeuge sind nicht der Ursprung.', 'Tools are not the origin.')}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">
        {t(
          'KI, Webtechnik und Automatisierung sind Produktionsmittel im Seez-Kosmos. Die Hauptsache bleibt: Stimme, Figur, Song, Fragment.',
          'AI, web tech, and automation are production means inside the Seez cosmos. The core remains voice, figure, song, fragment.'
        )}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="portal" href={`/${lang}/system-logs`}>System Logs</a>
        <a class="portal" href={`/${lang}/kreatives`}>Creative Core</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .portal {
    border: 1px solid rgba(34, 211, 238, 0.35);
    color: #a5f3fc;
    display: inline-block;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.8rem 1rem;
    text-transform: uppercase;
  }
</style>
