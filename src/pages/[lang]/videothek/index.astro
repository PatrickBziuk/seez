---
/**
 * Videothek — the music videos of the Seelensplitter figures (KONZEPT B9/B10).
 * Public build: only films pinned in src/data/videothek/releases.json; no page at all
 * until the first release. Local `pnpm dev:drafts`: every film from the catalog, drafts
 * marked. Tests and discarded versions are shown with a label.
 *
 * Look: a shop at night in the brand frame – white sign instead of neon red, one shelf
 * per figure with its accent label, 2:3 sleeves, a rental slip as dialog.
 * Easter eggs (decorative, static text, nothing unreleased): a small sticker per shelf
 * in the figure's medium, and the Konami code switches Gl1tch's terminal light on.
 * Films play in SzPlayer (own controls, wide view toggle on the slip).
 * Motion (motion.css): shelves and rows reveal on scroll, sleeves are pulled off the shelf
 * on hover, the sticker of a shelf wiggles once when you point at it, the rental slip
 * opens with a short rise. None of it with reduced motion.
 */
import type { GetStaticPaths } from 'astro';
import '@fontsource/caveat/latin-500';
import Layout from '~/layouts/PageLayout.astro';
import FigureChip from '~/components/seez/FigureChip.astro';
import FigureGlyph from '~/components/seez/FigureGlyph.astro';
import Notice from '~/components/seez/Notice.astro';
import SzPlayer from '~/components/seez/media/SzPlayer.astro';
import { SUPPORTED_LANGUAGES } from '~/utils/i18n';
import { isPreview } from '~/utils/publication';
import { getVisibleFilms, showVideothek, variantsForSong, type Film } from '~/utils/videothek';
import { FIGURES, getFigure } from '~/data/figures';
import { EP_TRACKS } from '~/data/songs';
import { getSongRecords } from '~/utils/music';
import { sectionUrl, type Lang } from '~/utils/routes';

// No page at all until the first film is released (local draft preview excepted).
export const getStaticPaths = (() =>
  showVideothek() ? SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } })) : []) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
const de = lang === 'de';
const preview = isPreview();
// Every released version stands on the shelf, tests and discarded ones too (marked as such).
const films = getVisibleFilms();
const current = films.filter((f) => f.workStatus === 'final');
const records = await getSongRecords();
const songLink = (f: Film) => {
  const t = EP_TRACKS.find((x) => x.filmKey === f.song?.key);
  return t && records.some((r) => r.slug === t.slug) ? { href: sectionUrl(lang, 'music', t.slug), title: t.title } : undefined;
};
const songLinks = new Map(films.map((f) => [f.id, songLink(f)]));
const tip = current.find((f) => f.released) || films[0];
const fresh = current.slice(0, 6);
const variants = new Map(films.map((f) => [f.id, variantsForSong(f.song?.key)]));
const shelves = FIGURES.map((fig) => ({ fig, films: films.filter((f) => f.characters[0] === fig.id) })).filter((s) => s.films.length);

const WORK_LABEL: Record<string, string> = {
  final: de ? 'fertig' : 'final',
  draft: de ? 'Entwurf' : 'draft',
  test: 'Test',
  dropped: de ? 'verworfen' : 'discarded',
};
const rate = (f: { rating?: unknown }, k: string) => (f.rating as Record<string, number> | undefined)?.[k];
const ASPECTS = [
  ['g', de ? 'Gesamt' : 'Overall'],
  ['w', de ? 'Welt' : 'World'],
  ['c', de ? 'Figur' : 'Character'],
  ['l', 'Lyrics'],
  ['s', 'Sync'],
] as const;
const firstSentence = (s?: string) => (s ? s.split(/(?<=[.!?])\s/)[0] : '');
const sticker: Record<string, string> = {
  splinter: de ? 'Bitte zurückspulen' : 'Be kind, rewind',
  lume: de ? '▶ Speicherpunkt' : '▶ Save point',
  drift: '23:50 · 0',
  shift: '04:30',
  gl1tch: '> ok_',
  unknown: de ? 'UNBEKANNT verliehen' : 'lent to UNKNOWN',
};

const metadata = {
  title: 'Videothek',
  description: de
    ? 'Musikvideos der Seelensplitter-Figuren: gebaut im Browser, Bild für Bild, mit eigener Engine.'
    : 'Music videos of the Seelensplitter figures: built in the browser, frame by frame, with our own engine.',
};
---

<Layout metadata={metadata} mainClass="vt">
  {
    preview && (
      <div class="sz-container vt__preview">
        <Notice title={de ? 'Entwurfsvorschau' : 'Draft preview'}>
          {de
            ? 'Nur lokal. Nicht freigegebene Filme sind markiert und erscheinen nicht auf seez.eu.'
            : 'Local only. Unreleased films are marked and never appear on seez.eu.'}
        </Notice>
      </div>
    )
  }

  <header class="sz-container sz-container--wide vt__front">
    <h1 class="vt__sign" data-vt-sign><span>Videothek</span></h1>
    <div class="vt__intro">
      <p class="sz-label">Seelensplitter · {de ? 'Musikvideos' : 'music videos'}</p>
      <p class="sz-lead">
        {
          de
            ? 'Musikvideos zu den Songs der Figuren. Jedes Video ist eine eigene kleine Welt, gebaut im Browser mit unserer Canvas-Engine, Bild für Bild auf den Gesang gelegt.'
            : 'Music videos for the figures’ songs. Each one is its own small world, built in the browser with our canvas engine and timed to the vocals frame by frame.'
        }
      </p>
      <p class="sz-label vt__count">
        {films.length} {films.length === 1 ? 'Film' : de ? 'Filme' : 'films'} · {shelves.length}
        {de ? (shelves.length === 1 ? ' Abteilung' : ' Abteilungen') : shelves.length === 1 ? ' section' : ' sections'}
      </p>
      {!de && <p class="sz-muted">Film notes are in German.</p>}
    </div>
  </header>

  {
    tip && (
      <section class="sz-container sz-container--wide sz-section vt__tip reveal" aria-labelledby="tip-h" style={`--fig:${getFigure(tip.characters[0])?.accent.dark}`}>
        <p class="sz-label">{de ? 'Tipp des Hauses' : 'Staff pick'}</p>
        <div class="vt__tipgrid">
          <button type="button" class="vt__tipposter" data-film={tip.id} aria-haspopup="dialog">
            <img src={tip.media.poster} alt="" loading="eager" />
            <span class="vt__play" aria-hidden="true">▶</span>
            <span class="sr-only">{de ? `${tip.title} ansehen` : `Watch ${tip.title}`}</span>
          </button>
          <div>
            <h2 class="sz-h1" id="tip-h">
              {tip.title}
            </h2>
            <p class="sz-muted">{tip.subtitle}</p>
            <div class="vt__chips">
              {tip.characters.map((c) => (
                <FigureChip figure={c} lang={lang} />
              ))}
            </div>
            <p class="vt__tiptext" lang="de">
              {firstSentence(tip.how)}
            </p>
            <button type="button" class="sz-btn sz-btn--primary" data-film={tip.id} aria-haspopup="dialog">
              {de ? 'Leihen' : 'Rent'}
            </button>
          </div>
        </div>
      </section>
    )
  }

  <section class="sz-container sz-container--wide sz-section" aria-labelledby="new-h">
    <h2 class="sz-h2 reveal" id="new-h">{de ? 'Neuheiten' : 'New arrivals'}</h2>
    <ul class="vt__row sz-snap-row reveal-stagger">
      {
        fresh.map((f) => (
          <li>
            <button type="button" class="vt__card" data-film={f.id} aria-haspopup="dialog" style={`--fig:${getFigure(f.characters[0])?.accent.dark}`}>
              <span class="vt__sleeve">
                <img src={f.media.cover} alt="" loading="lazy" width="400" height="600" />
                <video muted loop playsinline preload="none" data-clip={f.media.clip} />
                {!f.released && <span class="vt__draft">{de ? 'Entwurf' : 'Draft'}</span>}
              </span>
              <span class="vt__title">{f.title}</span>
              <span class="vt__meta">
                {f.characters.map((c) => getFigure(c)?.name || c).join(' · ')} · {f.length}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  {
    shelves.map(({ fig, films: list }) => (
      <section class="sz-container sz-container--wide vt__shelf reveal" aria-labelledby={`shelf-${fig.id}`} style={`--fig:${fig.accent.dark}`} id={`regal-${fig.id}`}>
        <h2 class="vt__shelflabel" id={`shelf-${fig.id}`}>
          <FigureGlyph id={fig.id} size={18} />
          <span class="vt__sz">{fig.sz}</span>
          <span class="vt__name">{fig.name}</span>
          <span class="vt__medium">· {fig.medium[lang]}</span>
          <span class:list={['vt__sticker', `vt__sticker--${fig.id}`]} aria-hidden="true">
            {sticker[fig.id]}
          </span>
        </h2>
        <ul class="vt__row sz-snap-row">
          {list.map((f) => (
            <li>
              <button type="button" class="vt__card" data-film={f.id} aria-haspopup="dialog">
                <span class="vt__sleeve">
                  <img src={f.media.cover} alt="" loading="lazy" width="400" height="600" />
                  <video muted loop playsinline preload="none" data-clip={f.media.clip} />
                  {!f.released && <span class="vt__draft">{de ? 'Entwurf' : 'Draft'}</span>}
                  {f.released && f.workStatus !== 'final' && <span class="vt__state">{WORK_LABEL[f.workStatus] || f.workStatus}</span>}
                </span>
                <span class="vt__title">{f.title}</span>
                <span class="vt__meta">
                  {f.subtitle} · {f.length}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="sz-container sz-container--wide sz-section vt__back reveal" aria-labelledby="back-h">
    <p class="sz-label">{de ? 'Hinterzimmer' : 'Back room'}</p>
    <h2 class="sz-h2" id="back-h">{de ? 'Wie die Filme gebaut werden' : 'How the films are made'}</h2>
    <p class="sz-muted">
      {
        de
          ? 'Engine, Bausteine und Konzepte sind offen auf GitHub. Hier im Regal stehen nur die Filme, die freigegeben sind.'
          : 'Engine, building blocks and concepts are open on GitHub. Only released films stand on this shelf.'
      }
    </p>
    <a class="sz-btn" href={sectionUrl(lang, 'workshop')}>{de ? 'Zur Werkstatt' : 'To the workshop'}</a>
  </section>

  <p class="sr-only" aria-live="polite" data-vt-live></p>

  <dialog class="vt__dialog" aria-labelledby="vt-dlg-title" data-vt-dialog>
    <div hidden data-vt-store>
    {
      films.map((f) => (
          <div hidden data-film-detail={f.id}>
            <div class="slip" style={`--fig:${getFigure(f.characters[0])?.accent.dark}`} data-szp-theater>
              <div class="slip__stage">
                <SzPlayer
                  lazySrc={f.media.full}
                  poster={f.media.poster}
                  label={f.title}
                  lang={lang}
                  length={f.length}
                  accent={getFigure(f.characters[0])?.accent.dark}
                  theater
                  defer
                />
              </div>
              <div class="slip__info">
                <p class="sz-label">
                  {de ? 'Leihschein' : 'Rental slip'} · {f.length}
                  {f.released && f.release && <> · v{f.release.version}</>}
                  {f.released && f.workStatus !== 'final' && <span class="vt__draft vt__draft--inline">{WORK_LABEL[f.workStatus] || f.workStatus}</span>}
                  {!f.released && (
                    <span class="vt__draft vt__draft--inline">
                      {de ? 'Entwurf' : 'Draft'} · {WORK_LABEL[f.workStatus] || f.workStatus}
                    </span>
                  )}
                </p>
                <h2 class="sz-h2" data-slip-title>
                  {f.title}
                </h2>
                <p class="sz-muted">{f.subtitle}</p>
                <div class="vt__chips">
                  {f.characters.map((c) => (
                    <FigureChip figure={c} lang={lang} />
                  ))}
                </div>
                {songLinks.get(f.id) && (
                  <p class="slip__song">
                    Song: <a href={songLinks.get(f.id)!.href}>{songLinks.get(f.id)!.title}</a>
                  </p>
                )}
                <p class="slip__how" lang="de">
                  {f.how}
                </p>
                {(variants.get(f.id)?.length || 0) > 1 && (
                  <section class="slip__versions" aria-label={de ? 'Alle Fassungen zu diesem Song' : 'All versions for this song'}>
                    <p class="sz-label">
                      {de ? 'Alle Fassungen zu diesem Song' : 'All versions for this song'} · {variants.get(f.id)!.length}
                    </p>
                    <ol>
                      {variants.get(f.id)!.map((v, i) => (
                        <li>
                          <button type="button" data-film={v.id} aria-current={v.id === f.id ? 'true' : undefined}>
                            <span class="slip__vno">{i + 1}</span>
                            <img src={v.media.poster} alt="" loading="lazy" width="96" height="54" />
                            <span class="slip__vtext">
                              <span lang="de">{v.subtitle || v.title}</span>
                              <span class="slip__vmeta">
                                {(v.date || '').slice(0, 10)} · {WORK_LABEL[v.workStatus] || v.workStatus}
                              </span>
                            </span>
                          </button>
                        </li>
                      ))}
                    </ol>
                  </section>
                )}
                {f.rating && (
                  <section class="slip__rating" aria-label={de ? 'Eigene Bewertung' : 'Own rating'} lang="de">
                    <p class="sz-label">{de ? 'Eigene Kritik' : 'Own critique'}</p>
                    <dl>
                      {ASPECTS.map(([k, label]) => (
                        <div>
                          <dt>{label}</dt>
                          <dd>{rate(f, k)}/10</dd>
                        </div>
                      ))}
                    </dl>
                    <p class="sz-muted">{f.rating.why}</p>
                  </section>
                )}
                <p class="slip__credits">
                  {de
                    ? 'Musik und Figurenbilder KI-gestützt · Apps und Marken im Bild sind erfunden'
                    : 'Music and figure art AI-assisted · apps and brands shown are fictional'}
                </p>
                <a class="sz-link" href={`${sectionUrl(lang, 'workshop')}#log-${f.id}`}>
                  {de ? 'So ist der Film entstanden' : 'How this film was made'} →
                </a>
              </div>
            </div>
          </div>
      ))
    }
    </div>
    <div class="vt__dlgbody" data-vt-body></div>
    <form method="dialog" class="vt__close">
      <button class="sz-btn" aria-label={de ? 'Schließen' : 'Close'}>×</button>
    </form>
  </dialog>
</Layout>

<script>
  import { mountPlayer } from '~/scripts/sz-player';

  const dlg = document.querySelector<HTMLDialogElement>('[data-vt-dialog]');
  const body = dlg?.querySelector<HTMLElement>('[data-vt-body]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let opener: HTMLElement | null = null;

  function openFilm(id: string, push = true) {
    if (!dlg || !body) return;
    const src = dlg.querySelector<HTMLElement>(`[data-vt-store] [data-film-detail="${CSS.escape(id)}"]`);
    if (!src) return;
    const slip = src.cloneNode(true) as HTMLElement;
    slip.hidden = false;
    slip.removeAttribute('data-film-detail');
    slip.querySelector('[data-slip-title]')?.setAttribute('id', 'vt-dlg-title');
    body.replaceChildren(slip);
    const v = body.querySelector<HTMLVideoElement>('video[data-src]');
    if (v) v.src = v.dataset.src || '';
    const player = body.querySelector<HTMLElement>('[data-szp]');
    if (player) mountPlayer(player);
    if (!dlg.open) dlg.showModal();
    if (push) history.replaceState(null, '', `#${id}`);
  }
  dlg?.addEventListener('close', () => {
    body?.querySelector('video')?.pause();
    body?.replaceChildren();
    history.replaceState(null, '', location.pathname);
    opener?.focus();
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) return dlg.close();
    // switch between the versions of a song inside the slip
    const pick = (e.target as HTMLElement).closest<HTMLElement>('[data-vt-body] [data-film]');
    if (pick && pick.getAttribute('aria-current') !== 'true') {
      body?.querySelector('video')?.pause();
      openFilm(pick.dataset.film || '');
      body?.scrollTo?.({ top: 0 });
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-film]').forEach((btn) => {
    btn.addEventListener('click', () => {
      opener = btn;
      openFilm(btn.dataset.film || '');
    });
    const clip = btn.querySelector<HTMLVideoElement>('video[data-clip]');
    if (!clip || reduce) return;
    const start = () => {
      if (!clip.src) clip.src = clip.dataset.clip || '';
      clip
        .play()
        .then(() => btn.classList.add('is-playing'))
        .catch(() => {});
    };
    const stop = () => {
      clip.pause();
      btn.classList.remove('is-playing');
    };
    btn.addEventListener('mouseenter', start);
    btn.addEventListener('focus', start);
    btn.addEventListener('mouseleave', stop);
    btn.addEventListener('blur', stop);
  });
  const m = /^#(?:film-)?([a-z0-9_]+)$/.exec(location.hash);
  if (m && !m[1].startsWith('regal')) openFilm(m[1], false);

  // Easter egg (Gl1tch): the Konami code turns on the terminal light. Keyboard only, announced.
  const seq = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let pos = 0;
  const live = document.querySelector<HTMLElement>('[data-vt-live]');
  document.addEventListener('keydown', (e) => {
    pos = e.key === seq[pos] ? pos + 1 : e.key === seq[0] ? 1 : 0;
    if (pos === seq.length) {
      pos = 0;
      const on = document.documentElement.classList.toggle('vt-sz-os');
      if (live) live.textContent = on ? 'SZ OS: Videothek mounted.' : 'SZ OS: unmounted.';
    }
  });
</script>

<style>
  .vt__preview {
    margin-top: var(--sp-5);
  }
  .vt__front {
    display: grid;
    gap: var(--sp-6);
    padding-top: var(--sp-7);
    align-items: center;
  }
  /* The sign: white, soft glow, flickers once on load (never with reduced motion) */
  .vt__sign {
    margin: 0;
    justify-self: start;
    border: 3px solid var(--text);
    padding: 10px 24px 6px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 9vw, 112px);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow:
      0 0 6px rgba(255, 255, 255, 0.55),
      0 0 22px rgba(255, 255, 255, 0.25);
    box-shadow:
      0 0 18px rgba(255, 255, 255, 0.18),
      inset 0 0 18px rgba(255, 255, 255, 0.08);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vt__sign span {
      animation: vt-flicker 1.2s steps(1) 1;
    }
  }
  @keyframes vt-flicker {
    0%,
    12%,
    20% {
      opacity: 0.25;
    }
    8%,
    16%,
    100% {
      opacity: 1;
    }
  }
  .vt__count {
    margin-top: var(--sp-4);
  }
  .vt__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0;
  }
  .vt__tipgrid {
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-4);
    align-items: center;
  }
  .vt__tipposter {
    position: relative;
    display: block;
    padding: 0;
    border: 1px solid var(--line);
    border-top: 4px solid var(--fig);
    background: #000;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    cursor: pointer;
  }
  .vt__tipposter img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vt__play {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: var(--invert-bg);
    color: var(--invert-text);
    font-size: 22px;
  }
  .vt__tiptext {
    max-width: 60ch;
    margin-bottom: var(--sp-5);
  }
  .vt__row {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0 0 var(--sp-3);
    grid-auto-columns: 140px;
  }
  .vt__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }
  .vt__sleeve {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-left: 6px solid var(--fig, var(--line-strong));
    overflow: hidden;
  }
  .vt__sleeve img,
  .vt__sleeve video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vt__sleeve video {
    opacity: 0;
    transition: opacity var(--t-fade) var(--ease);
  }
  .vt__card.is-playing video {
    opacity: 1;
  }
  .vt__card:hover .vt__sleeve,
  .vt__card:focus-visible .vt__sleeve {
    box-shadow: 0 0 0 1px var(--fig, var(--text)), 0 0 24px rgba(255, 255, 255, 0.08);
  }
  .vt__sleeve {
    transition:
      transform var(--motion-base) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }
  .vt__tipposter img,
  .vt__play {
    transition: transform var(--motion-slow) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* the tape is pulled a little off the shelf */
    .vt__card:is(:hover, :focus-visible) .vt__sleeve {
      transform: translateY(-4px) rotate(-0.6deg);
    }
    .vt__tipposter:is(:hover, :focus-visible) img {
      transform: scale(1.03);
    }
    .vt__tipposter:is(:hover, :focus-visible) .vt__play {
      transform: scale(1.08);
    }
    /* each shelf's sticker wiggles once when the shelf is pointed at */
    .vt__shelf:hover .vt__sticker {
      animation: vt-wiggle 480ms var(--ease-stamp) 1;
    }
    .vt__dialog[open] {
      animation: vt-slip-in var(--motion-slow) var(--ease-out) both;
    }
    .vt__dialog[open]::backdrop {
      animation: vt-fade-in var(--motion-base) var(--ease-out) both;
    }
  }
  @keyframes vt-wiggle {
    30% {
      translate: 0 -2px;
      rotate: 3deg;
    }
    65% {
      rotate: -2deg;
    }
  }
  @keyframes vt-slip-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.99);
    }
  }
  @keyframes vt-fade-in {
    from {
      opacity: 0;
    }
  }
  .vt__draft {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--bg);
    border: 1px dashed var(--text-muted);
    color: var(--text);
    font: 500 var(--fs-xs) / 1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 6px;
  }
  .vt__state {
