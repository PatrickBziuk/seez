---
/**
 * About Seez (KONZEPT B10, rebuilt in the new frame). Wording kept from the former page;
 * "System Logs" now points to the Werkstatt, which replaced it.
 * Motion (motion.css): head strip fills on load, the three pillars reveal in sequence.
 * "Ursprung": the torn profile photo (src/data/sketches.ts, caption in the artist's words).
 * "Skizzenbuch 2011–2013": early drawings, original next to the traced ink version.
 */
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import FigureStrip from '~/components/seez/FigureStrip.astro';
import SketchBook from '~/components/seez/sketch/SketchBook.astro';
import { Image } from 'astro:assets';
import { PROFILE } from '~/data/sketches';
import { SUPPORTED_LANGUAGES } from '~/utils/i18n';
import { sectionUrl, type Lang } from '~/utils/routes';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: Lang };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Über Seez', 'About Seez'),
  description: t(
    'Seez ist ein kreativer Kosmos aus Musik, Figuren, Texten, Werkstatt und visuellen Fragmenten.',
    'Seez is a creative cosmos of music, figures, texts, workshop notes, and visual fragments.'
  ),
};

const pillars = [
  {
    label: t('Musik', 'Music'),
    title: t('Songs als Beweisstücke', 'Songs as evidence pieces'),
    text: t(
      'GENERIERUNG LÄUFT ist der öffentliche Einstieg: sechs Tracks, sechs Stimmen, ein Systembruch.',
      'GENERIERUNG LÄUFT is the public entry point: six tracks, six voices, one system fracture.'
    ),
  },
  {
    label: t('Figuren', 'Figures'),
    title: t('Figuren statt Persona', 'Figures instead of persona'),
    text: t(
      'Drift, Splinter, Shift, Lume, Unknown und Gl1tch sind Perspektiven, keine Maskottchen.',
      'Drift, Splinter, Shift, Lume, Unknown, and Gl1tch are perspectives, not mascots.'
    ),
  },
  {
    label: t('Werkstatt', 'Workshop'),
    title: t('Prozess bleibt sichtbar', 'The process stays visible'),
    text: t(
      'Werkstatt, Fragmente und Lyrics zeigen nicht nur Ergebnisse, sondern auch Brüche, Methoden und Entscheidungen.',
      'Workshop, fragments, and lyrics show not only results, but fractures, methods, and decisions.'
    ),
  },
];

const links = [
  { text: t('Musik', 'Music'), href: sectionUrl(lang, 'music') },
  { text: 'Lyrics', href: sectionUrl(lang, 'lyrics') },
  { text: t('Fragmente', 'Fragments'), href: sectionUrl(lang, 'fragments') },
  { text: t('Werkstatt', 'Workshop'), href: sectionUrl(lang, 'workshop') },
  { text: t('Zeitstrahl', 'Timeline'), href: sectionUrl(lang, 'timeline') },
];
---

<Layout metadata={metadata}>
  <PageHead
    title={t('Seez ist kein Nebenprojekt.', 'Seez is not a side project.')}
    label={t('Über Seez', 'About Seez')}
    lead={t(
      'Seez ist der kreative Kosmos, in dem Musik, Figuren, Texte, KI-Werkzeuge und alte Fragmente zu einer zusammenhängenden Welt werden.',
      'Seez is the creative cosmos where music, figures, texts, AI tools, and legacy fragments become one connected world.'
    )}
  >
    <FigureStrip height={6} class="about__strip" motion="boot" />
  </PageHead>

  <section class="sz-section sz-container">
    <ul class="about__pillars reveal-stagger">
      {
        pillars.map((p) => (
          <li class="sz-panel">
            <p class="sz-label">{p.label}</p>
            <h2 class="sz-h3">{p.title}</h2>
            <p class="sz-muted">{p.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="sz-btn-row about__links reveal">
      {
        links.map((l) => (
          <a class="sz-btn" href={l.href}>
            {l.text}
          </a>
        ))
      }
    </div>
  </section>

  <section class="sz-container sz-section origin" aria-labelledby="ursprung">
    <figure class="origin__fig reveal">
      <div class="origin__photo">
        <Image
          src={PROFILE.image}
          alt={PROFILE.alt[lang]}
          widths={[600, 1200]}
          sizes="(min-width: 900px) 480px, calc(100vw - 32px)"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="origin__text">
        <p class="sz-label">{t('Ursprung', 'Origin')}</p>
        <h2 class="sz-h2" id="ursprung">{t('Das zerrissene Profilbild', 'The torn profile picture')}</h2>
        <figcaption class="sz-lead origin__cap">{PROFILE.caption[lang]}</figcaption>
      </div>
    </figure>
  </section>

  <SketchBook lang={lang} />
</Layout>

<style>
  .about__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .about__pillars .sz-h3,
  .about__pillars .sz-muted {
    margin-top: var(--sp-3);
  }
  .origin__fig {
    margin: 0;
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }
  .origin__photo {
    max-width: 480px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .origin__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .origin__text .sz-h2 {
    margin-top: var(--sp-2);
  }
  .origin__cap {
    margin-top: var(--sp-4);
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .origin__fig {
      grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
      gap: var(--sp-7);
    }
  }
  .about__links {
    margin-top: var(--sp-6);
  }
  :global(.about__strip) {
    margin-top: var(--sp-5);
    max-width: 420px;
  }
  @media (min-width: 768px) {
    .about__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
