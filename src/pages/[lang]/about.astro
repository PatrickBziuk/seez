---
import Layout from '../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../utils/i18n';
import type { SupportedLanguage } from '../../utils/i18n';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Über Seez', 'About Seez'),
  description: t(
    'Seez ist ein kreativer Kosmos aus Musik, Figuren, Texten, System Logs und visuellen Fragmenten.',
    'Seez is a creative cosmos of music, figures, texts, system logs, and visual fragments.'
  ),
};

const pillars = [
  {
    label: 'MUSIC',
    title: t('Songs als Beweisstücke', 'Songs as evidence pieces'),
    text: t(
      'GENERIERUNG LÄUFT ist der öffentliche Einstieg: sieben Tracks, sechs Stimmen, ein Systembruch.',
      'GENERIERUNG LÄUFT is the public entry point: seven tracks, six voices, one system fracture.'
    ),
  },
  {
    label: 'FIGURES',
    title: t('Figuren statt Persona', 'Figures instead of persona'),
    text: t(
      'Drift, Splinter, Shift, Lume, Unknown und Gl1tch sind Perspektiven, keine Maskottchen.',
      'Drift, Splinter, Shift, Lume, Unknown, and Gl1tch are perspectives, not mascots.'
    ),
  },
  {
    label: 'LOGS',
    title: t('Prozess bleibt sichtbar', 'The process stays visible'),
    text: t(
      'System Logs, Fragmente und Lyrics zeigen nicht nur Ergebnisse, sondern auch Brüche, Methoden und Entscheidungen.',
      'System logs, fragments, and lyrics show not only results, but fractures, methods, and decisions.'
    ),
  },
];
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-[#06070a] text-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <header class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.28em] text-lime-300">&gt; SEEZ_ARCHIVE / ABOUT</p>
        <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{t('Seez ist kein Nebenprojekt.', 'Seez is not a side project.')}</h1>
        <p class="mt-5 border-l border-lime-400 pl-4 text-base leading-7 text-slate-300 md:text-lg">
          {t(
            'Seez ist der kreative Kosmos, in dem Musik, Figuren, Texte, KI-Werkzeuge und alte Fragmente zu einer zusammenhängenden Welt werden.',
            'Seez is the creative cosmos where music, figures, texts, AI tools, and legacy fragments become one connected world.'
          )}
        </p>
      </header>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {pillars.map((pillar) => (
          <article class="border border-slate-800 bg-slate-950/70 p-5">
            <p class="text-xs font-bold tracking-[0.22em] text-cyan-300">{pillar.label}</p>
            <h2 class="mt-4 text-xl font-bold">{pillar.title}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-400">{pillar.text}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a class="portal" href={`/${lang}/musik`}>Sonic Archive</a>
        <a class="portal" href={`/${lang}/lyrics`}>Lyrics Vault</a>
        <a class="portal" href={`/${lang}/fragmente`}>{t('Fragmente', 'Fragments')}</a>
        <a class="portal" href={`/${lang}/system-logs`}>System Logs</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .portal {
    border: 1px solid rgba(190, 242, 100, 0.32);
    background: rgba(15, 23, 42, 0.72);
    color: #ecfccb;
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.95rem 1rem;
    text-align: center;
    text-transform: uppercase;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .portal:hover {
    border-color: #bef264;
    transform: translateY(-1px);
  }
</style>
