---
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Locked Archive', 'Locked Archive'),
  description: t('Dieser Archivbereich bleibt bis zur Freigabe geschlossen.', 'This archive stays closed until release approval.'),
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-[#06070a] px-4 py-14 text-slate-100 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs uppercase tracking-[0.28em] text-red-300">&gt; ARCHIVE_LOCKED</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{t('Dieser Bereich bleibt geschlossen.', 'This area stays locked.')}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">
        {t(
          'Auf den Hauptseiten stehen aktuell nur EP, Songs, Figuren, Lyrics, Fragmente und System Logs. Nicht freigegebene Artefakte werden hier nicht vorgezogen.',
          'The main pages currently focus on EP, songs, figures, lyrics, fragments, and system logs. Unreleased artifacts are not surfaced here early.'
        )}
      </p>
      <a class="portal mt-8 inline-block" href={`/${lang}/musik`}>Sonic Archive</a>
    </div>
  </section>
</Layout>

<style>
  .portal {
    border: 1px solid rgba(248, 113, 113, 0.35);
    color: #fecaca;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.8rem 1rem;
    text-transform: uppercase;
  }
</style>
