---
import Layout from '../../../layouts/PageLayout.astro';
import ContentCard from '../../../components/content/cards/ContentCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SUPPORTED_LANGUAGES, getTranslations } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = () => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
};

const { lang } = Astro.params as { lang: SupportedLanguage };

// Load translations for the current language
const t = await getTranslations(lang);

// Get all books content and filter by language
const allBooks = (await getCollection('books')) as CollectionEntry<'books'>[];
const filteredBooks = allBooks.filter(
  (item) => !item.data.draft && (item.data.language === lang || (!item.data.language && lang === 'en'))
);

const metadata = {
  title: t.navigation.Books,
  description: 'Book reviews, summaries, and reading notes.',
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
        📚 {t.navigation.Books}
      </h1>
      <p class="text-xl text-muted dark:text-slate-400">Book reviews, summaries, and reading notes</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filteredBooks.map((item) => <ContentCard item={item} lang={lang} basePath="books" />)}
    </div>

    {
      filteredBooks.length === 0 && (
        <div class="text-center py-12">
          <p class="text-muted dark:text-slate-400">No content available in this language yet.</p>
        </div>
      )
    }
  </section>
</Layout>
