---
/**
 * Canonical ID Router - Redirects canonical IDs to human-readable URLs
 * @props canonicalId - The canonical identifier to resolve
 * @behavior Looks up canonical ID in registry and redirects to proper URL
 * @dependencies canonical-urls.ts, content collections
 * @usedBy Direct canonical ID links, content management systems
 */

import type { SupportedLanguage } from '~/utils/i18n';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: SupportedLanguage; collection: string; canonicalId: string };
    props: { redirectUrl: string };
  }> = [];

  return paths;
}

return Astro.redirect('/de', 301);
---
