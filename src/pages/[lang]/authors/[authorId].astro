---
import { getPublicCollection } from '~/utils/publication';
import { render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import { Image } from 'astro:assets';
import { PROFILE } from '~/data/sketches';

export async function getStaticPaths() {
  const authors = await getPublicCollection('authors');
  const languages = ['en', 'de'];

  const paths = [];

  // One page per author id and language: prefer the entry written in that language
  // (seez.mdx / seez-de.mdx share the id "seez"; before, the first match won and the
  // German page showed the English text).
  for (const lang of languages) {
    const ids = [...new Set(authors.map((a) => a.data.id))];
    for (const id of ids) {
      const author =
        authors.find((a) => a.data.id === id && a.data.language === lang) || authors.find((a) => a.data.id === id)!;
      paths.push({
        params: {
          lang: lang,
          authorId: author.data.id,
        },
        props: {
          author,
          lang,
        },
      });
    }
  }

  return paths;
}

const { author, lang } = Astro.props;
const { Content } = await render(author);
const de = lang === 'de';
const name: string = author.data.displayName || author.data.name || author.data.id || 'Seez';
// Avatar: Seez uses the torn profile photo (src/data/sketches.ts), shown as scanned.
const avatar = author.data.id === 'seez' ? PROFILE : undefined;

const metadata = {
  title: de ? `Über ${name}` : `About ${name}`,
  description: author.data.bio,
};
---

<Layout metadata={metadata}>
  <PageHead
    title={name}
    label={author.data.status?.authoring === 'AI'
      ? de
        ? 'Autor · KI-Mitarbeit'
        : 'Author · AI collaboration'
      : de
        ? 'Autor'
        : 'Author'}
    lead={author.data.bio}
    crumbs={[{ href: `/${lang}/${de ? 'archiv' : 'archive'}`, text: de ? 'Archiv' : 'Archive' }, { text: name }]}
  >
    {
      avatar && (
        <a class="author__avatar" href={`/${lang}/about#ursprung`}>
          <Image
            src={avatar.image}
            alt={avatar.alt[de ? 'de' : 'en']}
            widths={[160, 320]}
            sizes="160px"
            format="webp"
            quality={80}
            loading="eager"
          />
        </a>
      )
    }
  </PageHead>
  <div class="sz-container author">
    <div class="sz-prose">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .author__avatar {
    display: block;
    width: 160px;
    margin-top: var(--sp-5);
    border: 1px solid var(--line);
  }
  .author__avatar :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .author {
    padding-bottom: var(--section-gap);
  }
</style>
