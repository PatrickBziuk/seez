---
import { getPublicCollection } from '~/utils/publication';
/**
 * Unified Blog – Aggregates entries from all content collections and sorts by date.
 * Route: /[lang]/blog
 */
import Layout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';
import PageHead from '~/components/seez/PageHead.astro';
import { sectionUrl } from '~/utils/routes';
import { epTrack, musicSlug } from '~/data/songs';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };

// Projects and life entries no longer have their own pages (redirected to the workshop / start),
// so the timeline lists only what can be opened: songs and texts.
const collections = ['music', 'texts'] as const;

type Coll = (typeof collections)[number];
type Entry = Awaited<ReturnType<typeof getCollection<Coll>>>[number];
type EntryData = {
  title?: string;
  description?: string;
  language?: 'en' | 'de';
  tags?: string[];
  draft?: boolean;
  publicationStatus?: 'draft' | 'published' | 'archived';
  firstPublishedAt?: string;
  publishDate?: string;
  date?: Date | string;
};

const lowQualityPattern = /(coming soon|placeholder|demo page|sample\b|tbd|lorem ipsum|stay tuned)/i;

function isLowQualityEntry(data: EntryData): boolean {
  const title = (data.title || '').trim();
  const description = (data.description || '').trim();
  const combined = `${title} ${description}`;
  if (!title) return true;
  return lowQualityPattern.test(combined);
}

function toDate(entry: Entry): Date | null {
  const data = entry.data as unknown as EntryData;
  const d = data.firstPublishedAt || data.publishDate || data.date;
  if (!d) return null;
  try {
    return d instanceof Date ? d : new Date(d as string);
  } catch {
    return null;
  }
}

function toUrl(entry: Entry): string {
  const data = entry.data as unknown as EntryData;
  const itemLang = (data.language || 'en') as SupportedLanguage;
  const slug = entry.id.replace(/\.(md|mdx)$/i, '').replace(/^[a-z]{2}\//, '');
  return entry.collection === 'music' ? sectionUrl(itemLang, 'music', slug) : `/${itemLang}/texte/${slug}`;
}

// Load, filter by language and publication state, then sort
const items = (await Promise.all(collections.map((c) => getPublicCollection(c))))
  .flat()
  .filter((e) => {
    const data = e.data as unknown as EntryData;
    return data.language === lang && !data.draft && data.publicationStatus === 'published' && !isLowQualityEntry(data);
  })
  .map((e) => {
    const data = e.data as unknown as EntryData;
    return {
      title: (data.title || '').toString(),
      description: data.description,
      url: toUrl(e),
      date: toDate(e),
      collection: e.collection,
      track: e.collection === 'music' ? epTrack(musicSlug(e.id)) : undefined,
      tags: data.tags,
    };
  })
  .filter((it) => !!it.date)
  .sort((a, b) => b.date!.getTime() - a.date!.getTime());

const de = lang === 'de';
const label = (c: string) => (c === 'music' ? 'Song' : 'Text');
const fmt = new Intl.DateTimeFormat(de ? 'de-DE' : 'en-GB', { dateStyle: 'medium' });

const metadata = {
  title: de ? 'Chronik' : 'Timeline',
  description: de
    ? 'Alle veröffentlichten Songs und Texte von Seez, nach Datum sortiert.'
    : 'All published Seez songs and texts, sorted by date.',
};
---

<Layout metadata={metadata}>
  <PageHead
    title={de ? 'Chronik' : 'Timeline'}
    label={de ? 'Neu' : 'New'}
    lead={de
      ? 'Alle veröffentlichten Songs und Texte, nach Datum sortiert.'
      : 'All published songs and texts, sorted by date.'}
  >
    <p class="ch__rss"><a class="sz-link" href={`/${lang}/rss.xml`}>RSS</a></p>
  </PageHead>

  <section class="sz-section sz-container">
    {
      items.length === 0 ? (
        <p class="sz-muted">{de ? 'Noch keine veröffentlichten Beiträge.' : 'No published entries yet.'}</p>
      ) : (
        <ol class="ch__list">
          {items.map((it) => (
            <li class="ch__item">
              <p class="sz-label">
                <time datetime={it.date!.toISOString().slice(0, 10)}>{fmt.format(it.date!)}</time> ·{' '}
                {label(it.collection)}
                {it.collection === 'music' &&
                  (it.track ? ` · EP Track ${it.track.no}` : de ? ' · in Arbeit' : ' · in progress')}
              </p>
              <h2 class="ch__title">
                <a href={it.url}>{it.title}</a>
              </h2>
              {it.description && <p class="sz-muted ch__desc">{it.description}</p>}
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Layout>

<style>
  .ch__rss {
    margin-top: var(--sp-4);
  }
  .ch__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .ch__item {
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--line);
  }
  .ch__title {
    margin-top: var(--sp-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1.1;
  }
  .ch__title a {
    color: var(--text);
    text-decoration: none;
  }
  .ch__title a:hover {
    text-decoration: underline;
  }
  .ch__desc {
    margin-top: var(--sp-2);
    max-width: 65ch;
  }
</style>
