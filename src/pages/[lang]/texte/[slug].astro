---
/**
 * Text page in the new frame (KONZEPT B10): breadcrumb, mono date line, one H1,
 * reading column, then the songs and figures the text belongs to.
 * Dropped from the former AstroWind layout: share bar, emoji meta line, tag cloud.
 */
import { getPublicCollection } from '~/utils/publication';
import { type CollectionEntry, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import FigureChip from '~/components/seez/FigureChip.astro';
import { musicSlug } from '~/data/songs';
import { getFigure } from '~/data/figures';
import { sectionUrl } from '~/utils/routes';
import { SUPPORTED_LANGUAGES } from '~/utils/i18n';
import type { SupportedLanguage } from '~/utils/i18n';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: SupportedLanguage; slug: string };
    props: { entry: CollectionEntry<'texts'> };
  }> = [];
  for (const lang of SUPPORTED_LANGUAGES) {
    const items = (await getPublicCollection('texts')) as CollectionEntry<'texts'>[];
    const langItems = items.filter((it) => it.data.language === lang || (!it.data.language && lang === 'en'));
    for (const it of langItems) {
      const cleanSlug = it.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '');
      paths.push({ params: { lang, slug: cleanSlug }, props: { entry: it } });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as SupportedLanguage;
const de = lang === 'de';
const { Content } = await render(entry);

const music = await getPublicCollection('music');
const songs = (entry.data.songRefs || [])
  .map((ref) => {
    const slug = musicSlug(ref.id);
    const m = music.find((x) => musicSlug(x.id) === slug);
    return m ? { slug, title: m.data.title as string } : undefined;
  })
  .filter(Boolean) as Array<{ slug: string; title: string }>;
const figures = (entry.data.figureRefs || [])
  .map((ref) => getFigure(ref.id.replace(/^(de|en)\//, '').replace(/\.mdx?$/, '')))
  .filter(Boolean);

const date = entry.data.firstPublishedAt
  ? new Date(entry.data.firstPublishedAt).toLocaleDateString(de ? 'de-DE' : 'en-GB', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    })
  : undefined;
const kind = (entry.data as { type?: string }).type;

const metadata = {
  title: entry.data.title,
  description: entry.data.excerpt || entry.data.description,
};
---

<Layout metadata={metadata}>
  <article>
    <PageHead
      title={entry.data.title}
      label={[de ? 'Text' : 'Text', kind && kind !== 'text' ? kind : undefined, date].filter(Boolean).join(' · ')}
      crumbs={[{ href: `/${lang}/texte`, text: de ? 'Texte' : 'Texts' }, { text: entry.data.title }]}
    />
    <div class="sz-container text__body">
      <div class="sz-prose">
        <Content />
      </div>
    </div>

    {
      (songs.length > 0 || figures.length > 0) && (
        <section class="sz-section sz-container" aria-labelledby="context">
          <h2 class="sz-h2" id="context">
            {de ? 'Gehört zu' : 'Belongs to'}
          </h2>
          <ul class="text__refs">
            {songs.map((s) => (
              <li>
                <span class="sz-label">Song</span>
                <a class="sz-link text__song" href={sectionUrl(lang, 'music', s.slug)}>
                  {s.title}
                </a>
              </li>
            ))}
            {figures.map((f) => (
              <li>
                <span class="sz-label">{de ? 'Figur' : 'Figure'}</span>
                <FigureChip figure={f!.id} lang={lang} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .text__body {
    padding-bottom: var(--section-gap);
  }
  .text__refs {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .text__refs li {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .text__refs .sz-label {
    min-width: 4.5em;
  }
  .text__song {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    text-transform: uppercase;
  }
</style>
