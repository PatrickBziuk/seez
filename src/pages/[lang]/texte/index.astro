---
/**
 * Texts collection listing - Creative Cosmos texts interface
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PageLayout.astro';
import { getPermalink } from '../../../utils/permalinks';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

const items = await getCollection('texts');
type TextEntry = (typeof items)[number];
const filtered = items.filter((it: TextEntry) => it.data.language === lang || (!it.data.language && lang === 'en'));

const metadata = {
  title: lang === 'de' ? 'Texte' : 'Texts',
  description:
    lang === 'de'
      ? 'Prosa, Gedichte und Notizen aus dem kreativen Kosmos'
      : 'Prose, poems and notes from the creative cosmos',
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <header class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">{lang === 'de' ? 'Texte' : 'Texts'}</h1>
      <p class="text-muted">{lang === 'de' ? 'Prosa, Gedichte und Notizen' : 'Prose, poems and notes'}</p>
    </header>

    {
      filtered.length > 0 ? (
        <ul class="space-y-3">
          {filtered.map((it) => (
            <li>
              <a
                class="underline hover:no-underline"
                href={getPermalink(`/${lang}/texte/${it.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '')}`)}
              >
                {it.data.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted text-center">{lang === 'de' ? 'Noch keine Texte veröffentlicht.' : 'No texts yet.'}</p>
      )
    }
  </section>
</Layout>
