---
import { getPublicCollection } from '~/utils/publication';
/**
 * Texts collection listing - Creative Cosmos texts interface
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/PageLayout.astro';
import { getPermalink } from '../../../utils/permalinks';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';
import PageHead from '~/components/seez/PageHead.astro';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

const items = await getPublicCollection('texts');
type TextEntry = (typeof items)[number];
const own = items.filter((it: TextEntry) => it.data.language === lang || (!it.data.language && lang === 'en'));
// Texts exist only in German so far: the English index lists them with a language note instead of "No texts yet".
const filtered = own.length > 0 ? own : items.filter((it: TextEntry) => it.data.language === 'de');
const slugOf = (it: TextEntry) => it.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '');
const hrefOf = (it: TextEntry) => `/${it.data.language === 'de' && own.length === 0 ? 'de' : lang}/texte/${slugOf(it)}`;

const metadata = {
  title: lang === 'de' ? 'Texte' : 'Texts',
  description:
    lang === 'de'
      ? 'Prosa, Gedichte und Notizen aus dem kreativen Kosmos'
      : 'Prose, poems and notes from the creative cosmos',
};
---

<Layout metadata={metadata}>
  <PageHead
    title={lang === 'de' ? 'Texte' : 'Texts'}
    lead={lang === 'de' ? 'Prosa, Gedichte und Notizen' : 'Prose, poems and notes'}
  />
  <section class="sz-section sz-container tx">
    {
      filtered.length > 0 ? (
        <ul class="tx__list">
          {filtered.map((it) => (
            <li class="tx__item">
              <a href={getPermalink(hrefOf(it))} hreflang={it.data.language}>
                {it.data.title}
              </a>
              {it.data.language !== lang && <span class="sz-label tx__lang">{lang === 'en' ? 'German only' : 'nur Englisch'}</span>}
              {(it.data.excerpt || it.data.description) && (
                <p class="sz-muted" lang={it.data.language}>
                  {it.data.excerpt || it.data.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="sz-muted">{lang === 'de' ? 'Noch keine Texte veröffentlicht.' : 'No texts yet.'}</p>
      )
    }
  </section>
</Layout>

<style>
  .tx {
    padding-top: 0;
  }
  .tx__lang {
    margin-left: var(--sp-3);
  }
  .tx__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .tx__item {
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--line);
  }
  .tx__item a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1.1;
    color: var(--text);
  }
  .tx__item p {
    margin-top: var(--sp-2);
    max-width: 65ch;
  }
</style>
