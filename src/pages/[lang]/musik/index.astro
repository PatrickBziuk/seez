---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = (() => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

function normalizeFigureRef(value: unknown): string {
  if (!value) return 'SEEZ';
  if (typeof value === 'string') return value.split('/').pop()?.toUpperCase() || 'SEEZ';
  if (typeof value === 'object' && value !== null && 'id' in value) {
    const id = String((value as { id: string }).id);
    return id.split('/').pop()?.toUpperCase() || 'SEEZ';
  }
  return 'SEEZ';
}

const contentTracks = (await getCollection('music'))
  .filter((item) => !item.data.draft && item.data.publicationStatus !== 'draft')
  .map((item, index) => {
    const slug = item.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '');
    const entryLang = item.data.language || 'en';
    return {
      id: slug,
      title: item.data.title,
      subtitle: item.data.description || item.data.subtitle || '',
      lang: entryLang,
      href: `/${entryLang}/music/${slug}`,
      audioUrl: item.data.audioUrl || '',
      figure: normalizeFigureRef(item.data.figureRef),
      index: String(index + 1).padStart(2, '0'),
    };
  });

const tracksById = new Map<string, (typeof contentTracks)[number]>();
for (const track of contentTracks) {
  const existing = tracksById.get(track.id);
  if (!existing || track.lang === lang) {
    tracksById.set(track.id, track);
  }
}
const spotifyEpUrl = 'https://open.spotify.com/intl-de/album/47aAj0XEtEJnmJqFDswAp0?si=BrvL2mSxQNWD7ER5QBa7MA';

const curatedTrackSpecs = [
  {
    id: 'scherbenprotokoll',
    title: 'Scherbenprotokoll',
    figure: 'SPLINTER / UNKNOWN / GL1TCH',
    subtitle:
      lang === 'de'
        ? 'Crossover-Protokoll: soziale Sortierung, Systembruch und beweisbarer Schmerz.'
        : 'Crossover protocol: social sorting, system fracture, and documented pain.',
  },
  {
    id: 'aufstiegstraum',
    title: 'Aufstiegstraum',
    figure: 'SHIFT',
    subtitle:
      lang === 'de'
        ? 'Arbeiterklasse, Elternarbeit und der Traum, sich freizustempeln.'
        : 'Working-class origin, parental labor, and the dream of clocking out for good.',
  },
  {
    id: 'als-sie-kamen',
    title: 'Als sie kamen',
    figure: 'UNKNOWN',
    subtitle:
      lang === 'de'
        ? 'Politische Angst, Schweigen und die Kosten bedingter Zugehörigkeit.'
        : 'Political fear, silence, and the cost of conditional belonging.',
  },
  {
    id: 'kiffen-kippen-alk',
    title: 'Kiffen Kippen Alk',
    figure: 'DRIFT',
    subtitle:
      lang === 'de'
        ? 'Rausch als schlechtes Werkzeug gegen Kälte, Leere und frühe Haltlosigkeit.'
        : 'Intoxication as a broken tool against coldness, emptiness, and early instability.',
  },
  {
    id: 'questlog',
    title: 'Questlog',
    figure: 'LUME',
    subtitle:
      lang === 'de'
        ? 'Games, Backlogs, Discord und Neugier als Restlicht-Methode.'
        : 'Games, backlogs, Discord, and curiosity as a residual-light method.',
  },
  {
    id: 'spiegelkrise',
    title: 'Spiegelkrise',
    figure: 'SPLINTER',
    subtitle:
      lang === 'de'
        ? 'Fanliebe, Selbsthass und Sichtbarkeit, die nicht automatisch heilt.'
        : 'Fan love, self-hate, and visibility that does not automatically heal.',
  },
  {
    id: 'fck-suno',
    title: 'FCK SUNO',
    figure: 'GL1TCH',
    subtitle:
      lang === 'de'
        ? 'Meta-Track über KI-Musik, Zugang und das Werkzeug, das zugleich Stimme gibt.'
        : 'Meta track about AI music, access, and the tool that also gives a voice.',
  },
];

const tracks = curatedTrackSpecs.map((spec, index) => {
  const contentTrack = tracksById.get(spec.id);
  return {
    ...spec,
    title: contentTrack?.title || spec.title,
    subtitle: contentTrack?.subtitle || spec.subtitle,
    href: contentTrack?.href || `/${lang}/music/${spec.id}`,
    audioUrl: contentTrack?.audioUrl || '',
    index: String(index + 1).padStart(2, '0'),
  };
});

const epQuotes = [
  {
    quote: 'Bevor er schrieb, wurde er beschrieben.',
    song: 'Scherbenprotokoll',
    href: `/${lang}/music/scherbenprotokoll`,
  },
  {
    quote: 'Aufstiegstraum, ich stempel mich frei.',
    song: 'Aufstiegstraum',
    href: `/${lang}/music/aufstiegstraum`,
  },
  {
    quote: 'Doch die Zeilen halten dicht, wenn sonst keiner mit mir spricht.',
    song: 'Als sie kamen',
    href: `/${lang}/music/als-sie-kamen`,
  },
  {
    quote: 'Jeder Rausch ein Versuch, doch er heilt mich nicht.',
    song: 'Kiffen Kippen Alk',
    href: `/${lang}/music/kiffen-kippen-alk`,
  },
  {
    quote: 'Ich verliere mich, doch nie die Lust am Suchen.',
    song: 'Questlog',
    href: `/${lang}/music/questlog`,
  },
  {
    quote: 'Ich wollte jemand sein, den man versteht.',
    song: 'Spiegelkrise',
    href: `/${lang}/music/spiegelkrise`,
  },
  {
    quote: 'Suno singt die Zeilen, die Seele kommt von mir.',
    song: 'FCK SUNO',
    href: `/${lang}/music/fck-suno`,
  },
];

const initialTrack = tracks.find((track) => track.audioUrl) || tracks[0];

const metadata = {
  title: lang === 'de' ? 'Sonic Archive' : 'Sonic Archive',
  description:
    lang === 'de'
      ? 'GENERIERUNG LÄUFT, die Seez-EP auf Spotify, plus die geplanten Seelensplitter-Songs.'
      : 'GENERIERUNG LÄUFT, the Seez EP on Spotify, plus the planned Seelensplitter songs.',
};
---

<Layout metadata={metadata}>
  <section class="sonic-shell px-4 sm:px-6 py-10 md:py-16 min-h-screen">
    <header class="mb-12 flex flex-col md:flex-row md:justify-between md:items-end gap-4 max-w-6xl mx-auto">
      <div>
        <p class="text-xs text-green-400 mb-1">&gt; MOUNTING: GENERIERUNG_LAEUFT</p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight uppercase">SONIC ARCHIVE</h1>
        <p class="text-gray-400 mt-3 max-w-2xl">
          {
            lang === 'de'
              ? 'Die EP ist seit dem 27.06.2026 live. Dieses Archiv verbindet den Spotify-Release mit den Figuren, Themen und geplanten Albumknoten von SEELENSPLITTER PHASE 1.'
              : 'The EP has been live since 2026-06-27. This archive connects the Spotify release with the figures, themes, and planned album nodes of SEELENSPLITTER PHASE 1.'
          }
        </p>
      </div>
      <div class="text-left md:text-right text-sm">
        <p class="text-gray-500">{lang === 'de' ? 'Aktueller Release' : 'Current release'}</p>
        <p class="text-green-400 font-bold">EP LIVE [27.06.2026]</p>
        <a class="text-xs text-lime-300 hover:underline" href={spotifyEpUrl}>Spotify</a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">
      <section class="sticky top-8 h-fit">
        <div class="player-frame">
          <div id="vinyl" class="vinyl paused">
            <div class="label">SEEZ<br/>ARCHIVE</div>
          </div>

          <div class="now-playing">
            <div class="flex justify-between items-center mb-2 text-xs">
              <span id="player-char" class="text-cyan-300">CHARACTER: {initialTrack?.figure || 'SEEZ'}</span>
              <span id="player-time" class="text-gray-500">00:00</span>
            </div>
            <h2 id="player-title" class="text-xl font-bold">{initialTrack?.title || (lang === 'de' ? 'Track wählen' : 'Select a track')}</h2>
            <p id="player-subtitle" class="text-xs text-gray-400 mt-1">{initialTrack?.subtitle}</p>
            <div class="visualizer mt-3" id="visualizer">
              <span style="animation-duration:0.4s"></span>
              <span style="animation-duration:0.6s"></span>
              <span style="animation-duration:0.3s"></span>
              <span style="animation-duration:0.7s"></span>
              <span style="animation-duration:0.5s"></span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mt-4 text-center text-sm uppercase tracking-wide">
          <button class="ctrl" id="prev-btn">[Prev]</button>
          <button class="ctrl ctrl-active" id="play-btn">[Play]</button>
          <button class="ctrl" id="next-btn">[Next]</button>
        </div>

        <div class="release-panel mt-4">
          <p class="text-xs text-amber-300 uppercase tracking-wide">{lang === 'de' ? 'Out now' : 'Out now'}</p>
          <h2>GENERIERUNG LÄUFT</h2>
          <p>
            {
              lang === 'de'
                ? 'Sechs Stimmen. Ein Bruch. Die Frage ist nicht, warum du zersplitterst, sondern was du aus den Splittern baust.'
                : 'Six voices. One fracture. The question is not why you splinter, but what you build from the shards.'
            }
          </p>
          <a href={spotifyEpUrl}>{lang === 'de' ? 'Auf Spotify hören' : 'Listen on Spotify'}</a>
        </div>

        {initialTrack?.audioUrl && <audio id="archive-audio" src={initialTrack.audioUrl} preload="metadata"></audio>}
      </section>

      <section>
        <div class="flex gap-3 text-xs uppercase tracking-wide border-b border-gray-800 pb-3 mb-4">
          <span class="text-white border-b border-green-400 pb-2">PHASE 1</span>
          <span class="text-gray-600">PHASE 2 [LOCKED]</span>
          <span class="text-gray-600">PHASE 3 [LOCKED]</span>
        </div>

        {
          tracks.length === 0 ? (
            <p class="text-sm text-gray-400">{lang === 'de' ? 'Noch keine Tracks veröffentlicht.' : 'No tracks published yet.'}</p>
          ) : (
            <ul id="track-list" class="space-y-2">
              {tracks.map((track) => (
                <li>
                  <button
                    class="track-item w-full text-left"
                    data-title={track.title}
                    data-subtitle={track.subtitle}
                    data-figure={track.figure || 'SEEZ'}
                    data-audio={track.audioUrl}
                    data-href={track.href}
                    type="button"
                  >
                    <span class="track-index">{track.index}</span>
                    <span class="track-main">
                      <strong class="block text-lg">{track.title}</strong>
                      <span class="block text-xs text-gray-500 line-clamp-1">{track.subtitle || (lang === 'de' ? 'Song verfügbar' : 'Track available')}</span>
                    </span>
                    <span class="track-open text-xs text-cyan-300">OPEN</span>
                  </button>
                </li>
              ))}
            </ul>
          )
        }

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a class="spotify-link block text-center" href={spotifyEpUrl}>
            {lang === 'de' ? 'EP auf Spotify >>' : 'EP on Spotify >>'}
          </a>
          <a class="spotify-link block text-center" href={`/${lang}/lyrics`}>
            {lang === 'de' ? 'Zum Lyrics Vault >>' : 'Open Lyrics Vault >>'}
          </a>
        </div>

        <section class="quote-strip mt-8" aria-labelledby="ep-quotes-title">
          <div class="quote-strip-head">
            <p>{lang === 'de' ? 'Tumblr-Potenzial' : 'Quote layer'}</p>
            <h2 id="ep-quotes-title">{lang === 'de' ? 'Zitate aus der EP' : 'Quotes from the EP'}</h2>
          </div>
          <div class="grid grid-cols-1 gap-3">
            {epQuotes.map((item) => (
              <a class="quote-card" href={item.href}>
                <blockquote>“{item.quote}”</blockquote>
                <span>{item.song} →</span>
              </a>
            ))}
          </div>
        </section>
      </section>
    </main>
  </section>
</Layout>

<script>
  const tracks = Array.from(document.querySelectorAll<HTMLButtonElement>('.track-item'));
  const vinyl = document.getElementById('vinyl');
  const playBtn = document.getElementById('play-btn');
  const playerTitle = document.getElementById('player-title');
  const playerSubtitle = document.getElementById('player-subtitle');
  const playerChar = document.getElementById('player-char');
  const visualizer = document.getElementById('visualizer');
  const audio = document.getElementById('archive-audio') as HTMLAudioElement | null;
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');

  let currentIndex = tracks.length > 0 ? 0 : -1;
  let isPlaying = false;

  function syncVisualState() {
    if (!vinyl || !playBtn || !visualizer) return;

    if (isPlaying) {
      vinyl.classList.remove('paused');
      vinyl.classList.add('spinning');
      playBtn.textContent = '[Pause]';
      visualizer.classList.add('active');
    } else {
      vinyl.classList.add('paused');
      playBtn.textContent = '[Play]';
      visualizer.classList.remove('active');
    }
  }

  function loadTrack(index: number, shouldNavigate = false) {
    if (index < 0 || index >= tracks.length) return;
    currentIndex = index;

    const btn = tracks[index];
    const title = btn.dataset.title || 'Track';
    const subtitle = btn.dataset.subtitle || '';
    const figure = btn.dataset.figure || 'SEEZ';
    const audioSrc = btn.dataset.audio || '';
    const href = btn.dataset.href;

    tracks.forEach((item) => item.classList.remove('is-active'));
    btn.classList.add('is-active');

    if (playerTitle) playerTitle.textContent = title;
    if (playerSubtitle) playerSubtitle.textContent = subtitle;
    if (playerChar) playerChar.textContent = `CHARACTER: ${figure}`;

    if (audio && audioSrc) {
      audio.src = audioSrc;
      if (isPlaying) {
        audio.play().catch(() => {
          isPlaying = false;
          syncVisualState();
        });
      }
    }

    if (shouldNavigate && !audioSrc && href) {
      window.location.href = href;
    }
  }

  tracks.forEach((track, idx) => {
    track.addEventListener('click', () => {
      loadTrack(idx, true);
      if (audio && track.dataset.audio) {
        isPlaying = true;
        audio.play().catch(() => {
          isPlaying = false;
        });
        syncVisualState();
      }
    });
  });

  playBtn?.addEventListener('click', () => {
    if (!audio) return;

    if (audio.paused) {
      isPlaying = true;
      audio.play().catch(() => {
        isPlaying = false;
      });
    } else {
      isPlaying = false;
      audio.pause();
    }

    syncVisualState();
  });

  prevBtn?.addEventListener('click', () => {
    if (tracks.length === 0) return;
    const nextIndex = currentIndex <= 0 ? tracks.length - 1 : currentIndex - 1;
    loadTrack(nextIndex, false);
  });

  nextBtn?.addEventListener('click', () => {
    if (tracks.length === 0) return;
    const nextIndex = currentIndex >= tracks.length - 1 ? 0 : currentIndex + 1;
    loadTrack(nextIndex, false);
  });

  audio?.addEventListener('ended', () => {
    isPlaying = false;
    syncVisualState();
  });

  if (tracks.length > 0) {
    loadTrack(0, false);
  }

  syncVisualState();
</script>

<style>
  .sonic-shell {
    --bg: #080808;
    background: radial-gradient(circle at 85% -5%, rgba(34, 197, 94, 0.15), transparent 30%),
      radial-gradient(circle at 10% 8%, rgba(217, 119, 6, 0.13), transparent 26%), var(--bg);
    color: #e5e7eb;
  }

  .player-frame {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 0.6rem;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .vinyl {
    width: 65%;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    border: 3px solid #1f2937;
    background: #020617;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vinyl::before,
  .vinyl::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.26);
  }

  .vinyl::before {
    inset: 18%;
  }

  .vinyl::after {
    inset: 32%;
  }

  .label {
    width: 34%;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    background: #ef4444;
    color: #020617;
    display: grid;
    place-content: center;
    font-size: 0.56rem;
    line-height: 1.1;
    text-align: center;
    font-weight: 700;
  }

  .spinning {
    animation: spin 3s linear infinite;
  }

  .paused {
    animation-play-state: paused;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .now-playing {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    background: rgba(2, 6, 23, 0.82);
    border: 1px solid #334155;
    padding: 0.7rem;
  }

  .visualizer {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 1.9rem;
    opacity: 0.28;
  }

  .visualizer.active {
    opacity: 1;
  }

  .visualizer span {
    width: 4px;
    height: 30%;
    background: #22c55e;
    animation: bounce 0.5s infinite ease-in-out alternate;
  }

  @keyframes bounce {
    0% {
      height: 0.3rem;
      opacity: 0.35;
    }
    100% {
      height: 1.7rem;
      opacity: 1;
    }
  }

  .ctrl {
    border: 1px solid #374151;
    padding: 0.5rem;
    transition: 0.2s ease;
  }

  .ctrl:hover {
    border-color: #22d3ee;
    color: #22d3ee;
  }

  .ctrl-active {
    border-color: #22c55e;
    color: #22c55e;
  }

  .release-panel {
    border: 1px solid rgba(190, 242, 100, 0.35);
    background: linear-gradient(135deg, rgba(20, 83, 45, 0.55), rgba(69, 26, 3, 0.55));
    padding: 1rem;
  }

  .release-panel h2 {
    color: white;
    font-weight: 800;
    font-size: 1.25rem;
    margin-top: 0.25rem;
  }

  .release-panel p {
    color: #d1d5db;
    font-size: 0.86rem;
    margin-top: 0.5rem;
    line-height: 1.55;
  }

  .release-panel a {
    display: inline-block;
    margin-top: 0.75rem;
    color: #bef264;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
  }

  .quote-strip {
    border-top: 1px solid #1f2937;
    padding-top: 1.5rem;
  }

  .quote-strip-head {
    margin-bottom: 0.9rem;
  }

  .quote-strip-head p {
    color: #bef264;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .quote-strip-head h2 {
    color: #fff;
    font-size: 1.35rem;
    font-weight: 900;
    margin-top: 0.25rem;
  }

  .quote-card {
    border: 1px solid rgba(34, 211, 238, 0.22);
    background: rgba(15, 23, 42, 0.72);
    color: #e5e7eb;
    display: block;
    padding: 0.95rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .quote-card:hover {
    border-color: #22d3ee;
    transform: translateY(-1px);
  }

  .quote-card blockquote {
    color: white;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0;
  }

  .quote-card span {
    color: #67e8f9;
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-top: 0.7rem;
    text-transform: uppercase;
  }

  .track-item {
    border-left: 2px solid transparent;
    background: rgba(2, 6, 23, 0.6);
    padding: 0.75rem;
    display: grid;
    grid-template-columns: 3.1rem 1fr auto;
    gap: 0.75rem;
    align-items: center;
    transition: 0.2s ease;
  }

  .track-item:hover,
  .track-item.is-active {
    border-left-color: #22c55e;
    background: rgba(15, 23, 42, 0.95);
  }

  .track-index {
    color: #22d3ee;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .spotify-link {
    border: 1px solid #16a34a;
    color: #16a34a;
    padding: 0.75rem;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .spotify-link:hover {
    background: #16a34a;
    color: #03120a;
  }
</style>
