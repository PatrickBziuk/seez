---
/**
 * Contact (rebuilt in the new frame). Wording kept; English UI labels on the German page
 * translated, "System Logs" renamed to Werkstatt.
 */
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import { SUPPORTED_LANGUAGES } from '~/utils/i18n';
import { EP } from '~/data/songs';
import type { Lang } from '~/utils/routes';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: Lang };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

// Static build: the subject is fixed (the former ?topic= parameter only worked in SSR).
const subject = encodeURIComponent('SEEZ // seez');

const metadata = {
  title: t('Kontakt', 'Contact'),
  description: t(
    'Kontakt für Seez: Presse, Musik, visuelle Kollaboration, Releasefragen und Updates.',
    'Contact for Seez: press, music, visual collaboration, release questions, and updates.'
  ),
};

const lanes = [
  {
    title: t('Presse & Kontext', 'Press & context'),
    text: t(
      'Releaseinfos, Projektbeschreibung, Bild-/Textanfragen.',
      'Release info, project context, image and text requests.'
    ),
  },
  {
    title: t('Musik & Kollab', 'Music & collabs'),
    text: t(
      'Feature-Ideen, Visuals, Remixe, Kuratierung, Playlists.',
      'Feature ideas, visuals, remixes, curation, playlists.'
    ),
  },
  {
    title: t('Rückmeldungen', 'Feedback'),
    text: t('Feedback, Fehlerfunde und Community-Spuren.', 'Feedback, corrections, and community traces.'),
  },
];
---

<Layout metadata={metadata}>
  <PageHead
    title={t('Kontakt zum Kosmos', 'Contact the cosmos')}
    label={t('Kontakt', 'Contact')}
    lead={t(
      'Für alles, was direkt mit Seez zu tun hat: EP, Figuren, Lyrics, visuelle Zusammenarbeit, Presse und Werkstatt.',
      'For everything directly tied to Seez: EP, figures, lyrics, visual collaboration, press, and the workshop.'
    )}
  />

  <section class="sz-section sz-container">
    <ul class="ct__lanes">
      {
        lanes.map((l) => (
          <li class="sz-panel">
            <h2 class="sz-h3">{l.title}</h2>
            <p class="sz-muted">{l.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="sz-panel ct__mail">
      <p class="sz-label">{t('Direkt', 'Direct')}</p>
      <a class="ct__address" href={`mailto:info@seez.eu?subject=${subject}`}>info@seez.eu</a>
      <p class="sz-muted">
        {
          t(
            'Der Link öffnet dein Mailprogramm mit einem Seez-Betreff. Diese Seite nutzt kein eigenes Kontakttracking.',
            'The link opens your mail app with a Seez subject. This page does not use contact tracking.'
          )
        }
      </p>
    </div>

    <div class="sz-btn-row ct__links">
      <a class="sz-btn" href={EP.spotify} rel="noopener">Spotify · EP</a>
      <a class="sz-btn" href="https://www.instagram.com/seezerino/" rel="noopener">Instagram</a>
      <a class="sz-btn" href="https://www.tiktok.com/@seezerino" rel="noopener">TikTok</a>
      <a class="sz-btn" href={`/${lang}/press`}>{t('Presse', 'Press')}</a>
    </div>
  </section>
</Layout>

<style>
  .ct__lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .ct__lanes p,
  .ct__mail p:last-child {
    margin-top: var(--sp-3);
  }
  .ct__mail {
    margin-top: var(--sp-6);
  }
  .ct__mail .sz-label {
    display: block;
  }
  .ct__address {
    display: inline-block;
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-xl);
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .ct__links {
    margin-top: var(--sp-6);
  }
  @media (min-width: 768px) {
    .ct__lanes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
