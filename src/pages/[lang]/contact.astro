---
import Layout from '../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES, getTranslations } from '../../utils/i18n';
import type { SupportedLanguage } from '../../utils/i18n';

export const getStaticPaths = () => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
};

const { lang } = Astro.params as { lang: SupportedLanguage };

// Load translations for the current language
const t = await getTranslations(lang);

const metadata = {
  title: t.navigation.Contact,
  description: lang === 'de' 
    ? 'Kontaktiere mich für Fragen, Kooperationen oder einfach um Hallo zu sagen.'
    : 'Get in touch with me for questions, collaborations, or just to say hello.',
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-2xl">
    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
        📧 {t.navigation.Contact}
      </h1>
      <p class="text-xl text-muted dark:text-slate-400">
        {lang === 'de' 
          ? 'Kontaktiere mich für Fragen, Kooperationen oder einfach um Hallo zu sagen.'
          : 'Get in touch for questions, collaborations, or just to say hello.'
        }
      </p>
    </header>

    <!-- Contact Form -->
    <form 
      action="https://formspree.io/f/mwkgbkkp" 
      method="POST"
      class="space-y-6 bg-white dark:bg-gray-800 p-8 rounded-lg border border-gray-200 dark:border-gray-700 shadow-lg"
    >
      <!-- Honeypot field for spam protection -->
      <input type="text" name="_gotcha" style="display:none" />
      
      <!-- Subject line (hidden) -->
      <input type="hidden" name="_subject" value={`New contact form submission from seez.eu (${lang})`} />
      
      <!-- Name Field -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          {lang === 'de' ? 'Name' : 'Name'} <span class="text-red-500" aria-label="required">*</span>
        </label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder={lang === 'de' ? 'Ihr Name' : 'Your name'}
        />
      </div>

      <!-- Email Field -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          {lang === 'de' ? 'E-Mail' : 'Email'} <span class="text-red-500" aria-label="required">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="_replyto" 
          required 
          class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder={lang === 'de' ? 'ihre.email@beispiel.de' : 'your.email@example.com'}
        />
      </div>

      <!-- Subject Field -->
      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          {lang === 'de' ? 'Betreff' : 'Subject'}
        </label>
        <input 
          type="text" 
          id="subject" 
          name="subject" 
          class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder={lang === 'de' ? 'Worum geht es?' : "What's this about?"}
        />
      </div>

      <!-- Message Field -->
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          {lang === 'de' ? 'Nachricht' : 'Message'} <span class="text-red-500" aria-label="required">*</span>
        </label>
        <textarea 
          id="message" 
          name="message" 
          rows="6" 
          required 
          class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-vertical"
          placeholder={lang === 'de' ? 'Ihre Nachricht...' : 'Your message...'}
        ></textarea>
      </div>

      <!-- Privacy Notice -->
      <div class="text-sm text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-700 p-4 rounded-md">
        {lang === 'de' ? (
          <>
            <p class="mb-2">
              <strong>Datenschutzhinweis:</strong> Dieses Formular wird von Formspree verarbeitet. Ihre Daten werden ausschließlich zur Beantwortung Ihrer Anfrage verwendet und nicht an Dritte weitergegeben oder für Marketingzwecke genutzt.
            </p>
            <p>
              Diese Website verwendet keine Tracking-Cookies. Mit dem Absenden dieses Formulars stimmen Sie der Verarbeitung Ihrer personenbezogenen Daten zum Zweck der Beantwortung Ihrer Nachricht zu.
            </p>
          </>
        ) : (
          <>
            <p class="mb-2">
              <strong>Privacy Notice:</strong> This form is processed by Formspree. Your data will be used solely to respond to your inquiry and will not be shared with third parties or used for marketing purposes.
            </p>
            <p>
              No tracking cookies are used on this website. By submitting this form, you consent to the processing of your personal data for the purpose of responding to your message.
            </p>
          </>
        )}
      </div>

      <!-- Submit Button -->
      <div class="text-center">
        <button 
          type="submit"
          class="inline-flex items-center px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          {lang === 'de' ? 'Nachricht senden' : 'Send Message'}
        </button>
      </div>
    </form>

    <!-- Alternative Contact Methods -->
    <div class="mt-12 text-center">
      <h2 class="text-xl font-semibold mb-6 dark:text-gray-200">
        {lang === 'de' ? 'Weitere Kontaktmöglichkeiten' : 'Other Ways to Reach Me'}
      </h2>
      <div class="flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-8">
        <!-- Email -->
        <a 
          href="mailto:hello@seez.eu" 
          class="flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          hello@seez.eu
        </a>
        
        <!-- GitHub -->
        <a 
          href="https://github.com/PatrickBziuk" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center text-gray-700 dark:text-gray-300 hover:text-black dark:hover:text-white transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Enhanced form styling */
  form {
    position: relative;
  }
  
  /* Focus indicator improvements */
  input:focus,
  textarea:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
  
  /* Form validation styling */
  input:valid {
    border-color: #10b981;
  }
  
  input:invalid:not(:placeholder-shown) {
    border-color: #ef4444;
  }
  
  /* Loading state for submit button */
  button[type="submit"]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  
  /* Hover effects for contact links */
  a:hover svg {
    transform: translateY(-1px);
    transition: transform 0.2s ease;
  }
</style>

<!-- Client-side form enhancement -->
<script>
  // Enhanced form submission with loading state
  const form = document.querySelector('form');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  
  if (form && submitButton) {
    form.addEventListener('submit', function() {
      submitButton.disabled = true;
      submitButton.innerHTML = `
        <svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        ${document.documentElement.lang === 'de' ? 'Wird gesendet...' : 'Sending...'}
      `;
    });
  }
  
  // Simple form validation feedback
  const inputs = form?.querySelectorAll('input[required], textarea[required]');
  inputs?.forEach((input) => {
    input.addEventListener('blur', function(this: HTMLInputElement | HTMLTextAreaElement) {
      if (this.value.trim() === '') {
        this.setAttribute('aria-invalid', 'true');
      } else {
        this.setAttribute('aria-invalid', 'false');
      }
    });
  });
</script>
