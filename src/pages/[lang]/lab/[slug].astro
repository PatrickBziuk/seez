---
import { getCollection } from 'astro:content';
import SeezRedirect from '../../../components/SeezRedirect.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('lab');
  return SUPPORTED_LANGUAGES.flatMap((lang) =>
    entries
      .filter((item) => !item.data.draft && (item.data.language === lang || (!item.data.language && lang === 'en')))
      .map((item) => ({
        params: { lang, slug: item.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '') },
      }))
  );
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<SeezRedirect target={`/${lang}/system-logs`} title="SEEZ System Logs" />
