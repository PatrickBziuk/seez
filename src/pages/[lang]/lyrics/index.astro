const metadata = {
  title: t('Lyrics Vault', 'Lyrics Vault'),
  description: t('Vollstaendiges Songtext-Archiv, gruppiert nach Phase und Charakter.', 'Full song archive grouped by phase and character.'),
};

const phaseLabel = (phase: 1 | 2) =>
  phase === 1 ? t('Phase 1 - Ursprung', 'Phase 1 - Origin') : t('Phase 2 - Suche und Bruch', 'Phase 2 - Search and fracture');

const phaseGroups = [1, 2].map((phase) => {
  const songsInPhase = songs.filter((song) => song.phase === phase);

  const byCharacter = characterOrder
    .map((character) => ({
      character,
      songs: songsInPhase.filter((song) => song.character === character),
    }))
    .filter((entry) => entry.songs.length > 0);

  return { phase: phase as 1 | 2, byCharacter };
});
---

<Layout metadata={metadata}>
  <section class="lyrics-shell min-h-screen px-4 sm:px-6 py-10 md:py-14">
    <header class="max-w-6xl mx-auto mb-8">
      <p class="boot">LYRICS_ARCHIVE // PHASE_INDEX // LATEST_ONLY</p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight uppercase">Lyrics Vault</h1>
      <p class="mt-3 text-sm text-gray-300 max-w-3xl">
        {t(
          'Alle Songtexte in deutscher Originalfassung. Die UI ist bilingual, die Lyrics bleiben bewusst im Original.',
          'All song texts are kept in original German. The UI shell is bilingual.'
        )}
      </p>

      <div class="route-links">
        <a href={`/${lang}/system-logs`}>{t('Zurueck zu System Logs', 'Back to System Logs')}</a>
        <a href={`/${lang}/musik`}>{t('Zurueck zu Sonic Archive', 'Back to Sonic Archive')}</a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto space-y-8">
      <section class="toolbar" aria-label={t('Lyrics Filter', 'Lyrics filter')}>
        <div class="chip-row" id="character-chips">
          <button type="button" class="chip active" data-character="ALL">ALL</button>
          {characterOrder.map((character) => (
            <button type="button" class="chip" data-character={character}>{character}</button>
          ))}
        </div>
        <div class="toolbar-actions">
          <button type="button" class="tool-btn" id="expand-all">{t('Alle aufklappen', 'Expand all')}</button>
          <button type="button" class="tool-btn" id="collapse-all">{t('Alle einklappen', 'Collapse all')}</button>
        </div>
      </section>

      {
        phaseGroups.map((group) => (
          <section class="phase-block" data-phase={group.phase}>
            <header class="phase-head">
              <h2>{phaseLabel(group.phase)}</h2>
            </header>

            <div class="character-columns">
              {
                group.byCharacter.map((bucket) => (
                  <section class="character-group" data-character-group={bucket.character}>
                    <h3>{bucket.character}</h3>
                    <div class="songs-grid">
                      {
                        bucket.songs.map((song) => (
                          <article class="song-card" data-song-card data-character={song.character} id={song.id}>
                            <details>
                              <summary>
                                <span class="title-wrap">
                                  <strong>{song.title}</strong>
                                  <small>{song.character}</small>
                                </span>
                                <a class="anchor-link" href={`#${song.id}`} aria-label={`${song.title} anchor`}>#</a>
                              </summary>
                              <pre>{song.text}</pre>
                            </details>
                          </article>
                        ))
                      }
                    </div>
                  </section>
                ))
              }
            </div>
          </section>
        ))
      }
    </main>
  </section>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll('#character-chips .chip'));
  const cards = Array.from(document.querySelectorAll('[data-song-card]'));
  const groups = Array.from(document.querySelectorAll('[data-character-group]'));
  const expandAll = document.getElementById('expand-all');
  const collapseAll = document.getElementById('collapse-all');

  const applyFilter = (character: string) => {
    cards.forEach((card) => {
      const show = character === 'ALL' || card.getAttribute('data-character') === character;
      card.classList.toggle('hidden', !show);
    });

    groups.forEach((group) => {
      const charName = group.getAttribute('data-character-group');
      const groupVisible = character === 'ALL' || charName === character;
      group.classList.toggle('hidden', !groupVisible);
    });
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((node) => node.classList.remove('active'));
      chip.classList.add('active');
      applyFilter(chip.getAttribute('data-character') || 'ALL');
    });
  });

  expandAll?.addEventListener('click', () => {
    document.querySelectorAll('.song-card details').forEach((node) => node.setAttribute('open', 'true'));
  });

  collapseAll?.addEventListener('click', () => {
    document.querySelectorAll('.song-card details').forEach((node) => node.removeAttribute('open'));
  });
</script>

