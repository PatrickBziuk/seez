---
/**
 * Lyrics index (KONZEPT B8): every lyric from src/data/lyrics.json, filterable by figure.
 * EP songs link to their song page (lyrics live there); all others open in place and are
 * marked "in Arbeit" – only the EP is released.
 */
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import FigureChip from '~/components/seez/FigureChip.astro';
import FigureGlyph from '~/components/seez/FigureGlyph.astro';
import LyricsBlock from '~/components/seez/LyricsBlock.astro';
import { SUPPORTED_LANGUAGES } from '~/utils/i18n';
import { FIGURES, getFigure } from '~/data/figures';
import { EP, EP_TRACKS, LYRICS, songSlugForLyrics } from '~/data/songs';
import { getSongRecords } from '~/utils/music';
import { sectionUrl, type Lang } from '~/utils/routes';

export const getStaticPaths = (() => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
const de = lang === 'de';
const records = await getSongRecords();
const epLyrics = new Set(EP_TRACKS.map((t) => t.lyricsId).filter(Boolean));
const order = new Map(FIGURES.map((f, i) => [f.id, i]));
const items = LYRICS.map((l) => {
  const slug = songSlugForLyrics(l.id);
  return {
    ...l,
    onEp: epLyrics.has(l.id),
    href: slug && records.some((r) => r.slug === slug) ? `${sectionUrl(lang, 'music', slug)}#lyrics` : undefined,
  };
}).sort(
  (a, b) =>
    Number(b.onEp) - Number(a.onEp) || (order.get(a.figure) ?? 9) - (order.get(b.figure) ?? 9) || a.title.localeCompare(b.title, 'de')
);

const metadata = {
  title: 'Lyrics',
  description: de
    ? 'Alle Songtexte von Seez, nach Figur sortiert. Die EP GENERIERUNG LÄUFT und die Songs, an denen gearbeitet wird.'
    : 'All Seez lyrics, sorted by figure: the EP GENERIERUNG LÄUFT and the songs still in progress.',
};
---

<Layout metadata={metadata}>
  <PageHead
    title="Lyrics"
    label={`${items.length} ${de ? 'Songtexte' : 'lyrics'}`}
    lead={de
      ? `Die Texte der EP ${EP.title} stehen auf den Songseiten. Alle anderen Songs sind in Arbeit; ihre Texte sind Entwürfe.`
      : `The lyrics of the EP ${EP.title} live on the song pages. All other songs are in progress; their lyrics are drafts.`}
  />
  {!de && <p class="sz-container sz-muted">Lyrics are in German.</p>}

  <div class="sz-container">
    <div class="ly__filter" role="group" aria-label={de ? 'Nach Figur filtern' : 'Filter by figure'} data-ly-filter hidden>
      <button type="button" aria-pressed="true" data-fig="">{de ? 'Alle' : 'All'}</button>
      {
        FIGURES.map((f) => (
          <button type="button" aria-pressed="false" data-fig={f.id} style={`--fig:${f.accent.dark}`}>
            <FigureGlyph id={f.id} size={16} />
            {f.name}
          </button>
        ))
      }
    </div>
    <p class="sz-muted ly__count" aria-live="polite" data-ly-count></p>

    <ul class="ly__list" lang="de">
      {
        items.map((l) => (
          <li class="ly__item" data-fig={l.figure} style={`--fig:${getFigure(l.figure)?.accent.dark}`}>
            <div class="ly__head">
              <h2 class="ly__title">{l.title}</h2>
              <FigureChip figure={l.figure} lang={lang} />
              <span class="sz-label" lang={lang}>
                {l.onEp ? `EP · ${EP.title}` : de ? 'in Arbeit' : 'in progress'}
              </span>
            </div>
            {l.href ? (
              <a class="sz-link ly__go" href={l.href} lang={lang}>
                {de ? 'Text auf der Songseite' : 'Lyrics on the song page'} →
              </a>
            ) : (
              <details class="ly__details">
                <summary lang={lang}>{de ? 'Text anzeigen' : 'Show lyrics'}</summary>
                <LyricsBlock text={l.text} idPrefix={l.id} />
              </details>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<script is:inline define:vars={{ de }}>
  (() => {
    const bar = document.querySelector('[data-ly-filter]');
    const count = document.querySelector('[data-ly-count]');
    if (!bar) return;
    bar.hidden = false;
    const items = [...document.querySelectorAll('.ly__item')];
    const apply = (fig) => {
      let n = 0;
      items.forEach((li) => {
        const show = !fig || li.dataset.fig === fig;
        li.hidden = !show;
        if (show) n += 1;
      });
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.fig || '') === fig)));
      if (count) count.textContent = fig ? (de ? `${n} Texte` : `${n} lyrics`) : '';
    };
    bar.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (b) apply(b.dataset.fig || '');
    });
  })();
</script>

<style>
  .ly__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .ly__filter button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--sp-4);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--fig, var(--line-strong));
    border-radius: var(--radius);
    font: 500 var(--fs-sm) / 1 var(--font-sans);
    cursor: pointer;
  }
  .ly__filter button :global(.sz-glyph) {
    color: var(--fig);
  }
  .ly__filter button[aria-pressed='true'] {
    background: var(--invert-bg);
    color: var(--invert-text);
  }
  .ly__filter button[aria-pressed='true'] :global(.sz-glyph) {
    color: var(--invert-text);
  }
  .ly__count {
    min-height: 1.6em;
    margin-top: var(--sp-3);
  }
  .ly__list {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .ly__item {
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--line);
  }
  .ly__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .ly__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1.1;
    margin-right: var(--sp-2);
  }
  .ly__go {
    display: inline-block;
    margin-top: var(--sp-3);
  }
  .ly__details {
    margin-top: var(--sp-3);
  }
  .ly__details summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ly__details[open] summary {
    margin-bottom: var(--sp-4);
  }
</style>
