---
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = (de: string, en: string) => (lang === 'de' ? de : en);

const metadata = {
  title: t('Projektindex', 'Project Index'),
  description: t(
    'Der alte Projektbereich wurde in den Seez-Kosmos überführt.',
    'The old project area has been folded into the Seez cosmos.'
  ),
  robots: { index: true, follow: true },
};

const portals = [
  { label: 'Creative Core', href: `/${lang}/kreatives` },
  { label: 'System Logs', href: `/${lang}/system-logs` },
  { label: 'Sonic Archive', href: `/${lang}/musik` },
  { label: t('Fragmente', 'Fragments'), href: `/${lang}/fragmente` },
];
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-[#06070a] px-4 py-14 text-slate-100 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs uppercase tracking-[0.28em] text-lime-300">&gt; ROUTE_MERGED / PROJECTS</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{t('Projekte sind jetzt Artefakte.', 'Projects are now artifacts.')}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">
        {t(
          'Dieser Bereich zeigt keine separaten Softwareprojekte mehr. Alles Öffentliche wurde in Creative Core, System Logs, Sonic Archive und Fragmente eingeordnet.',
          'This area no longer lists separate software projects. Everything public now lives in Creative Core, System Logs, Sonic Archive, and Fragments.'
        )}
      </p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2">
        {portals.map((portal) => (
          <a class="border border-slate-800 bg-slate-950/70 p-5 font-bold text-slate-100 hover:border-lime-300" href={portal.href}>
            {portal.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
