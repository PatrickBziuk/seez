---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = (() => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

const all = await getCollection('fragments');
type Entry = (typeof all)[number];

const byBase = new Map<string, { de?: Entry; en?: Entry }>();
for (const entry of all) {
  const isEnPath = entry.id.startsWith('en/');
  const baseSlug = isEnPath ? entry.id.replace(/^en\//, '') : entry.id;
  const langKey = (entry.data.language || 'de') as 'de' | 'en';
  const rec = byBase.get(baseSlug) || {};
  rec[langKey] = entry;
  byBase.set(baseSlug, rec);
}

const cards = Array.from(byBase.entries())
  .map(([baseSlug, rec]) => {
    const entry = lang === 'en' ? rec.en || rec.de : rec.de || rec.en;
    return { baseSlug, entry };
  })
  .filter((item): item is { baseSlug: string; entry: Entry } => !!item.entry)
  .sort((a, b) => (a.entry.data.designation || '').localeCompare(b.entry.data.designation || ''));

const toneBySlug: Record<
  string,
  { color: string; glow: string; quoteDe: string; quoteEn: string; energy: number; stability: number }
> = {
  drift: {
    color: '#ff0055',
    glow: 'rgba(255,0,85,0.25)',
    quoteDe: 'Stille ist lauter als jeder Absturz.',
    quoteEn: 'Silence is louder than any crash.',
    energy: 92,
    stability: 18,
  },
  splinter: {
    color: '#a3a3a3',
    glow: 'rgba(163,163,163,0.25)',
    quoteDe: 'Ich katalogisiere, was mich zerstoert.',
    quoteEn: 'I catalog what destroys me.',
    energy: 85,
    stability: 28,
  },
  shift: {
    color: '#4b5563',
    glow: 'rgba(75,85,99,0.25)',
    quoteDe: 'Wir arbeiten fuer ein Leben, das wir verpassen.',
    quoteEn: 'We work for a life we keep missing.',
    energy: 78,
    stability: 61,
  },
  lume: {
    color: '#ffd700',
    glow: 'rgba(255,215,0,0.25)',
    quoteDe: 'Ich glaube an Restlicht im dunkelsten Raum.',
    quoteEn: 'I believe in leftover light in the darkest room.',
    energy: 88,
    stability: 70,
  },
  'sz-006-unknown': {
    color: '#ffffff',
    glow: 'rgba(255,255,255,0.2)',
    quoteDe: 'Ich bin das Update, das niemand bestellt hat.',
    quoteEn: 'I am the update nobody ordered.',
    energy: 82,
    stability: 74,
  },
  gl1tch: {
    color: '#00f3ff',
    glow: 'rgba(0,243,255,0.25)',
    quoteDe: 'Fehler sind meine Handschrift.',
    quoteEn: 'Errors are my handwriting.',
    energy: 95,
    stability: 56,
  },
};

const portraitBySlug: Record<string, string> = {
  drift: '/images/figures/drift.png',
  splinter: '/images/figures/splinter.png',
  shift: '/images/figures/shift_work.png',
  lume: '/images/figures/lume.png',
  'sz-006-unknown': '/images/figures/unknown.png',
  gl1tch: '/images/figures/gl1tch_at_home.png',
};

const metadata = {
  title: lang === 'de' ? 'The Fragments' : 'The Fragments',
  description:
    lang === 'de'
      ? 'Identitaetsfragmente als visuelle Dossiers mit Portraits und Direktzugriff auf jede Figuren-Seite.'
      : 'Identity fragments as visual dossiers with portraits and direct links to every character page.',
};
---

<Layout metadata={metadata}>
  <section class="fragment-shell min-h-screen">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="top-glow" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14 relative z-10">
      <header class="mb-10 md:mb-12 text-center max-w-4xl mx-auto">
        <p class="boot">IDENTITY_KERNEL // FRAGMENT_PROTOCOL_V3</p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight uppercase">FRAGMENT Dossiers</h1>
        <p class="text-gray-400 text-sm md:text-base mt-3 max-w-2xl mx-auto">
          {
            lang === 'de'
              ? 'Identitaet als System. Jeder Splitter hat sein eigenes Portrait, Muster und Dossier.'
              : 'Identity as system. Every splinter has its own portrait, pattern, and dossier.'
          }
        </p>
      </header>

      <nav class="quick-nav mb-8 md:mb-10" aria-label={lang === 'de' ? 'Schnellzugriff Fragmente' : 'Quick access fragments'}>
        {
          cards.map(({ baseSlug, entry }) => {
            const href = `/${lang}/fragmente/${baseSlug}`;
            return (
              <a href={href} class="quick-link">
                <span>{entry.data.designation || 'SZ-000'}</span>
                <strong>{entry.data.title}</strong>
              </a>
            );
          })
        }
      </nav>

      <main class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          cards.map(({ baseSlug, entry }) => {
            const tone = toneBySlug[baseSlug] || toneBySlug['gl1tch'];
            const portrait = (entry.data.image as string | undefined) || portraitBySlug[baseSlug] || '';
            const href = `/${lang}/fragmente/${baseSlug}`;
            const quote = lang === 'de' ? tone.quoteDe : tone.quoteEn;

            return (
              <article class="dossier-card" style={`--char-color:${tone.color};--char-glow:${tone.glow};`}>
                <div class="portrait-wrap">
                  {portrait ? (
                    <img src={portrait} alt={entry.data.title} class="portrait" loading="lazy" />
                  ) : (
                    <div class="placeholder">[NO PORTRAIT]</div>
                  )}
                  <div class="portrait-overlay"></div>
                  <a href={href} class="portrait-link">
                    {lang === 'de' ? 'Dossier oeffnen' : 'Open dossier'}
                  </a>
                </div>

                <div class="p-5">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="text-xs tracking-[0.16em] text-gray-500 uppercase">{entry.data.designation || 'SZ-000'}</p>
                      <h2 class="char-title mt-1">{entry.data.title}</h2>
                      {entry.data.alias && <p class="text-xs text-gray-400 mt-1">{entry.data.alias}</p>}
                    </div>
                    <span class="id-dot" aria-hidden="true"></span>
                  </div>

                  <p class="text-sm text-gray-300 mt-4 italic">"{quote}"</p>

                  <div class="mt-5 space-y-3 text-[11px] text-gray-400">
                    <div>
                      <div class="flex justify-between"><span>ENERGY</span><span>{tone.energy}%</span></div>
                      <div class="stat-bar"><div class="stat-fill" style={`--stat-value:${tone.energy}%`}></div></div>
                    </div>
                    <div>
                      <div class="flex justify-between"><span>STABILITY</span><span>{tone.stability}%</span></div>
                      <div class="stat-bar"><div class="stat-fill" style={`--stat-value:${tone.stability}%`}></div></div>
                    </div>
                  </div>

                  <div class="mt-5 flex items-center justify-between gap-3">
                    <a href={href} class="cta-link">
                      {lang === 'de' ? 'Zur Charakterseite' : 'To character page'}
                    </a>
                    <a href={`/${lang}/blog`} class="text-xs text-cyan-300 hover:text-cyan-200 transition-colors">
                      {lang === 'de' ? 'Stories' : 'Stories'}
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </main>

      <footer class="mt-12 md:mt-14 text-center">
        <a class="footer-cta" href={`/${lang}/blog`}>
          {lang === 'de' ? 'Alle Splinter Stories im Blog' : 'Open full splinter stories in the blog'}
        </a>
      </footer>
    </div>
  </section>
</Layout>

<style>
  .fragment-shell {
    --bg: #05070d;
    --line: rgba(79, 117, 163, 0.24);
    --panel: rgba(8, 10, 17, 0.86);
    --text: #d9e2ec;
    color: var(--text);
    background:
      radial-gradient(circle at 20% -20%, rgba(0, 194, 255, 0.2), transparent 35%),
      radial-gradient(circle at 90% 10%, rgba(14, 165, 233, 0.16), transparent 28%),
      var(--bg);
    position: relative;
    overflow: hidden;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.35;
  }

  .top-glow {
    position: absolute;
    inset: auto 0 0 0;
    height: 240px;
    pointer-events: none;
    background: linear-gradient(to top, rgba(2, 6, 23, 0.7), transparent);
  }

  .boot {
    color: #67e8f9;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    margin-bottom: 0.95rem;
  }

  .quick-nav {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.55rem;
  }

  @media (min-width: 768px) {
    .quick-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .quick-link {
    border: 1px solid #243047;
    background: rgba(8, 10, 17, 0.7);
    padding: 0.7rem 0.8rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    font-size: 0.78rem;
    color: #cbd5e1;
    transition: 0.2s ease;
  }

  .quick-link strong {
    font-size: 0.82rem;
    color: #f8fafc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .quick-link:hover {
    border-color: #67e8f9;
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(103, 232, 249, 0.15);
  }

  .dossier-card {
    border: 1px solid #243047;
    background: var(--panel);
    overflow: hidden;
    transition: 0.25s ease;
  }

  .dossier-card:hover {
    border-color: var(--char-color);
    box-shadow: 0 0 26px var(--char-glow);
    transform: translateY(-2px);
  }

  .portrait-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-bottom: 1px solid #243047;
    background: #090e17;
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.08);
    transition: 0.35s ease;
  }

  .dossier-card:hover .portrait {
    filter: grayscale(12%) contrast(1.05);
    transform: scale(1.03);
  }

  .portrait-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(2, 6, 23, 0.85) 100%);
    pointer-events: none;
  }

  .portrait-link {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #67e8f9;
    border: 1px solid rgba(103, 232, 249, 0.45);
    background: rgba(2, 6, 23, 0.72);
    padding: 0.34rem 0.55rem;
    transition: 0.2s ease;
  }

  .portrait-link:hover {
    background: rgba(34, 211, 238, 0.2);
    border-color: #67e8f9;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: #64748b;
    font-size: 0.76rem;
  }

  .char-title {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.25rem;
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.15;
  }

  .id-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    border: 1px solid var(--char-color);
    box-shadow: 0 0 14px var(--char-glow);
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .stat-bar {
    height: 4px;
    width: 100%;
    background: #374151;
    overflow: hidden;
    margin-top: 5px;
  }

  .stat-fill {
    height: 100%;
    width: var(--stat-value);
    background: var(--char-color);
  }

  .cta-link {
    border: 1px solid #2b374e;
    color: #e2e8f0;
    padding: 0.45rem 0.68rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: 0.2s ease;
  }

  .cta-link:hover {
    border-color: var(--char-color);
    color: var(--char-color);
  }

  .footer-cta {
    border: 1px solid #2b374e;
    color: #67e8f9;
    padding: 0.6rem 0.95rem;
    font-size: 0.8rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: 0.2s ease;
    display: inline-block;
  }

  .footer-cta:hover {
    border-color: #67e8f9;
    background: rgba(34, 211, 238, 0.15);
  }
</style>
