---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export const getStaticPaths = (() => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: SupportedLanguage };

const all = await getCollection('fragments');
type Entry = (typeof all)[number];

const byBase = new Map<string, { de?: Entry; en?: Entry }>();
for (const entry of all) {
  const isEnPath = entry.id.startsWith('en/');
  const baseSlug = isEnPath ? entry.id.replace(/^en\//, '') : entry.id;
  const langKey = (entry.data.language || 'de') as 'de' | 'en';
  const rec = byBase.get(baseSlug) || {};
  rec[langKey] = entry;
  byBase.set(baseSlug, rec);
}

const cards = Array.from(byBase.entries())
  .map(([baseSlug, rec]) => {
    const entry = lang === 'en' ? rec.en || rec.de : rec.de || rec.en;
    return { baseSlug, entry };
  })
  .filter((item): item is { baseSlug: string; entry: Entry } => !!item.entry)
  .sort((a, b) => (a.entry.data.designation || '').localeCompare(b.entry.data.designation || ''));

const toneBySlug: Record<string, { color: string; glow: string; quote: string }> = {
  drift: { color: '#ff0055', glow: 'rgba(255,0,85,0.25)', quote: 'Stille ist lauter als jeder Absturz.' },
  splinter: { color: '#a3a3a3', glow: 'rgba(163,163,163,0.25)', quote: 'Ich katalogisiere, was mich zerstoert.' },
  shift: { color: '#4b5563', glow: 'rgba(75,85,99,0.25)', quote: 'Wir arbeiten fuer ein Leben, das wir verpassen.' },
  lume: { color: '#ffd700', glow: 'rgba(255,215,0,0.25)', quote: 'Ich glaube an Restlicht im dunkelsten Raum.' },
  'sz-006-unknown': { color: '#ffffff', glow: 'rgba(255,255,255,0.2)', quote: 'Ich bin das Update, das niemand bestellt hat.' },
  gl1tch: { color: '#00f3ff', glow: 'rgba(0,243,255,0.25)', quote: 'Fehler sind meine Handschrift.' },
};

const metadata = {
  title: lang === 'de' ? 'The Fragments' : 'The Fragments',
  description:
    lang === 'de'
      ? 'RPG-artige Uebersicht aller Fragmente mit Stat-Visualisierung und Direktzugriff auf jedes Dossier.'
      : 'RPG-like overview of all fragments with stat visualizations and direct links to every dossier.',
};
---

<Layout metadata={metadata}>
  <section class="fragment-shell px-4 sm:px-6 py-10 md:py-16 min-h-screen">
    <div class="noise" aria-hidden="true"></div>

    <header class="mb-12 text-center relative z-10 max-w-4xl mx-auto">
      <div class="inline-block border border-gray-700 px-4 py-1 text-xs text-gray-500 mb-4 rounded-full">
        SELECT_IDENTITY // PROTOCOL_V2
      </div>
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4 uppercase">THE FRAGMENTS</h1>
      <p class="text-gray-400 max-w-xl mx-auto text-sm">
        {lang === 'de'
          ? 'Identitaet als System: Jede Karte steht fuer einen Splitter mit eigenem Profil, eigener Energie und eigener Stimme.'
          : 'Identity as system: each card represents one splinter with its own profile, energy, and voice.'}
      </p>
    </header>

    <main class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
      {
        cards.map(({ baseSlug, entry }) => {
          const tone = toneBySlug[baseSlug] || toneBySlug['gl1tch'];
          const title = entry.data.alias || entry.data.title || baseSlug;
          const subtitle = entry.data.designation || '';
          const image = entry.data.image || '';
          const href = `/${lang}/fragmente/${baseSlug}`;

          return (
            <a href={href} class="char-card group" style={`--char-color:${tone.color};--char-color-dim:${tone.glow};`}>
              <div class="char-img-container">
                {image ? (
                  <img src={image} alt={entry.data.title} class="char-img" loading="lazy" />
                ) : (
                  <div class="placeholder">[IMG: {baseSlug.toUpperCase()}]</div>
                )}
                <div class="char-overlay"></div>
              </div>
              <div class="p-5">
                <h2 class="char-title text-3xl text-white mb-1 group-hover:opacity-90">{title}</h2>
                <p class="text-xs text-gray-500 mb-4">{subtitle}</p>

                <div class="space-y-3 text-[10px] text-gray-400">
                  <div>
                    <div class="flex justify-between"><span>ENERGY</span><span>90%</span></div>
                    <div class="stat-bar"><div class="stat-fill" style="--stat-value:90%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between"><span>STABILITY</span><span>45%</span></div>
                    <div class="stat-bar"><div class="stat-fill" style="--stat-value:45%"></div></div>
                  </div>
                </div>

                <p class="mt-5 text-sm text-gray-300 italic">"{tone.quote}"</p>
              </div>
            </a>
          );
        })
      }
    </main>

    <footer class="mt-16 border-t border-gray-800 pt-10 text-center relative z-10">
      <a class="inline-block text-sm border border-cyan-400 text-cyan-300 px-4 py-2 hover:bg-cyan-400 hover:text-black transition" href={`/${lang}/blog`}>
        {lang === 'de' ? 'Alle Splinter Stories im Blog' : 'Open full splinter stories in the blog'}
      </a>
    </footer>
  </section>
</Layout>

<style>
  .fragment-shell {
    background: #050505;
    color: #e5e7eb;
    position: relative;
    overflow: hidden;
  }

  .noise {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.5) 0.5px, transparent 0.5px);
    background-size: 2px 2px;
  }

  .char-card {
    background: #0a0a0a;
    border: 1px solid #222;
    transition: 0.35s ease;
    overflow: hidden;
    min-height: 430px;
  }

  .char-card:hover {
    transform: scale(1.02);
    border-color: var(--char-color);
    box-shadow: 0 0 28px var(--char-color-dim);
  }

  .char-title {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .char-img-container {
    height: 50%;
    min-height: 200px;
    border-bottom: 1px solid #1f2937;
    position: relative;
    overflow: hidden;
  }

  .char-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
    transition: 0.4s ease;
  }

  .char-card:hover .char-img {
    filter: grayscale(0%) contrast(1.05);
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    color: #4b5563;
    font-size: 0.74rem;
  }

  .char-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 50%, rgba(0, 0, 0, 0.55) 50%);
    background-size: 100% 4px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .char-card:hover .char-overlay {
    opacity: 0.3;
  }

  .stat-bar {
    height: 4px;
    width: 100%;
    background: #374151;
    overflow: hidden;
    margin-top: 5px;
  }

  .stat-fill {
    height: 100%;
    width: 0;
    background: var(--char-color);
    transition: width 0.8s ease;
  }

  .char-card:hover .stat-fill {
    width: var(--stat-value);
  }
</style>
