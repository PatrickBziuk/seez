---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import MarkdownLayout from '../../../layouts/MarkdownLayout.astro';
import MediaPlayer from '../../../components/content/media/MediaPlayer.astro';
import RelatedContent from '../../../components/content/RelatedContent.astro';
import { getPermalink } from '../../../utils/permalinks';
import { SUPPORTED_LANGUAGES } from '../../../utils/i18n';
import type { SupportedLanguage } from '../../../utils/i18n';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: SupportedLanguage; slug: string };
    props: { entry: CollectionEntry<'music'> };
  }> = [];

  for (const lang of SUPPORTED_LANGUAGES) {
    const allMusic = (await getCollection('music')) as CollectionEntry<'music'>[];
    const langMusic = allMusic.filter(
      (item) => !item.data.draft && (item.data.language === lang || (!item.data.language && lang === 'en'))
    );

    for (const item of langMusic) {
      // Clean slug: remove language prefix and file extension
      const cleanSlug = item.id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '');
      paths.push({
        params: {
          lang,
          slug: cleanSlug,
        },
        props: { entry: item },
      });
    }
  }

  return paths;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

// Convert string dates to Date objects for MarkdownLayout compatibility
const frontmatterWithDateObjects = {
  ...entry.data,
  publishDate: entry.data.firstPublishedAt ? new Date(entry.data.firstPublishedAt) : undefined,
  firstPublishDate: entry.data.firstPublishedAt ? new Date(entry.data.firstPublishedAt) : undefined,
  modifiedDate: entry.data.updatedAt ? new Date(entry.data.updatedAt) : undefined,
  lastChangeDate: entry.data.updatedAt ? new Date(entry.data.updatedAt) : undefined,
};
---

<MarkdownLayout frontmatter={frontmatterWithDateObjects}>
  <Content />

  {/* Audio player if audio URL provided */}
  {
    entry.data.audioUrl && (
      <section class="mt-6">
        <MediaPlayer
          src={entry.data.audioUrl}
          title={entry.data.title}
          artist={entry.data.artist || 'Seez'}
          description={entry.data.linerNotes || ''}
        />
      </section>
    )
  }

  {/* Figure reference (if any) */}
  {
    entry.data.figureRef && (
      <section class="mt-8">
        <h2 class="text-xl font-semibold mb-3">{Astro.params.lang === 'de' ? 'Figur' : 'Figure'}</h2>
        <a
          class="underline hover:no-underline"
          href={getPermalink(`/${Astro.params.lang}/fragmente/${entry.data.figureRef.id}`)}
        >
          {entry.data.figureRef.id}
        </a>
      </section>
    )
  }

  {/* Placeholder for related content component (Phase 4.3) */}
  <RelatedContent entry={entry} lang={Astro.params.lang as 'en' | 'de'} />
</MarkdownLayout>
