---
/**
 * Homepage - Multilingual homepage showing main navigation sections
 * @props lang: SupportedLanguage - Current language from route params
 * @behavior Shows welcome message and main navigation cards to Books, Projects, Lab, Life sections
 * @dependencies SUPPORTED_LANGUAGES, getTranslations, Layout
 * @usedBy Direct navigation to /[lang] (root homepage)
 */
import Layout from '../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../utils/i18n';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { SupportedLanguage } from '../../utils/i18n';
import { getPermalink } from '../../utils/permalinks';

export const getStaticPaths = () => {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
};

const { lang } = Astro.params as { lang: SupportedLanguage };

const metadata = {
  title: lang === 'de' ? 'Kreativer Kosmos - seez.eu' : 'Creative Cosmos - seez.eu',
  description:
    lang === 'de'
      ? 'Entdecke Musik, Texte und Fragmente in einem kreativen Universum voller Möglichkeiten.'
      : 'Discover music, texts, and fragments in a creative universe of endless possibilities.',
  ignoreTitleTemplate: true,
};

// Fetch a few latest items per section - prioritizing creative content
const [music, texts, figures, life] = await Promise.all([
  getCollection('music'),
  getCollection('texts'),
  getCollection('fragments'),
  getCollection('life'),
]);

type Coll = 'texts' | 'fragments' | 'music' | 'life';
type Entry = CollectionEntry<Coll>;
type EntryData = {
  title: string;
  description?: string;
  firstPublishedAt?: string;
  publishDate?: string;
  date?: Date | string;
  language?: 'en' | 'de';
  draft?: boolean;
  publicationStatus?: 'draft' | 'published' | 'archived';
};

const baseAlias = (collection: Coll): string => {
  switch (collection) {
    case 'texts':
      return 'texte';
    case 'fragments':
      return 'fragmente';
    default:
      return collection;
  }
};

function normalize(list: Entry[]) {
  return list
    .filter((e) => {
      const d = e.data as unknown as EntryData;
      return d.language === lang && !d.draft && d.publicationStatus !== 'draft';
    })
    .map((e) => {
      const idNoExt = e.id.replace(/\.(md|mdx)$/i, '');
      const cleanSlug = idNoExt.replace(/^[a-z]{2}\//, '');
      const data = e.data as unknown as EntryData;
      const d = data.firstPublishedAt || data.publishDate || data.date;
      const date: Date = d instanceof Date ? d : d ? new Date(String(d)) : new Date(0);
      return {
        title: (data.title || '').toString(),
        description: data.description,
        url: `/${lang}/${baseAlias(e.collection as Coll)}/${cleanSlug}`,
        date,
      };
    })
    .sort((a, b) => b.date.getTime() - a.date.getTime())
    .slice(0, 3);
}

const sections = [
  {
    key: 'music',
    href: `/${lang}/musik`,
    icon: '🎵',
    title: lang === 'de' ? 'Musik' : 'Music',
    items: normalize(music),
  },
  {
    key: 'texts',
    href: `/${lang}/texte`,
    icon: '📝',
    title: lang === 'de' ? 'Texte' : 'Texts',
    items: normalize(texts),
  },
  {
    key: 'fragments',
    href: `/${lang}/fragmente`,
    icon: '🎭',
    title: lang === 'de' ? 'Fragmente' : 'Fragments',
    items: normalize(figures),
  },
  {
    key: 'life',
    href: `/${lang}/kreatives`,
    icon: '✨',
    title: lang === 'de' ? 'Kreatives' : 'Creative',
    items: normalize(life),
  },
];
---

<Layout metadata={metadata}>
  <main>
    <section class="py-16 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight dark:text-white">
        {lang === 'de' ? 'Kreativer Kosmos' : 'Creative Cosmos'}
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        {
          lang === 'de'
            ? 'Musik, Texte und Fragmente – ein Universum voller kreativer Möglichkeiten.'
            : 'Music, texts, and fragments – a universe of creative possibilities.'
        }
      </p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a href={getPermalink(`/${lang}/musik`)} class="px-5 py-2.5 rounded-md bg-blue-600 text-white hover:bg-blue-700"
          >{lang === 'de' ? 'Musik entdecken' : 'Discover Music'}</a
        >
        <a
          href="#random"
          id="random-content-btn"
          class="px-5 py-2.5 rounded-md border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800"
          >{lang === 'de' ? 'Zufall' : 'Random'}</a
        >
      </div>
    </section>

    <section class="px-6 sm:px-6 pb-16 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
        {
          sections.map((s) => (
            <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-5 bg-white dark:bg-gray-900">
              <a href={getPermalink(s.href)} class="inline-flex items-center gap-2 text-lg font-semibold">
                <span class="text-2xl">{s.icon}</span>
                {s.title}
              </a>
              <ul class="mt-4 space-y-3">
                {s.items.map((it) => (
                  <li>
                    <a href={getPermalink(it.url)} class="block group">
                      <div class="text-sm text-gray-500 dark:text-gray-400">
                        {new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(it.date)}
                      </div>
                      <div class="font-medium group-hover:text-blue-600 dark:group-hover:text-blue-400">{it.title}</div>
                      {it.description && (
                        <div class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{it.description}</div>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="mt-4">
                <a href={getPermalink(s.href)} class="text-sm underline underline-offset-2 hover:no-underline">
                  {lang === 'de' ? 'Mehr' : 'More'}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Neu/New Section -->
    <section class="px-6 sm:px-6 pb-8 max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold mb-6 text-center">
        {lang === 'de' ? 'Neu' : 'New'}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          (() => {
            // Get latest 3 items across all collections
            const allItems = [
              ...normalize(music).map((item) => ({ ...item, type: 'music', icon: '🎵' })),
              ...normalize(texts).map((item) => ({ ...item, type: 'texts', icon: '📝' })),
              ...normalize(figures).map((item) => ({ ...item, type: 'fragments', icon: '🎭' })),
              ...normalize(life).map((item) => ({ ...item, type: 'creative', icon: '✨' })),
            ]
              .sort((a, b) => b.date.getTime() - a.date.getTime())
              .slice(0, 3);

            return allItems.map((item) => (
              <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-5 bg-white dark:bg-gray-900">
                <a href={item.url} class="block group">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-xl">{item.icon}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400 capitalize">{item.type}</span>
                  </div>
                  <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">
                    {new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(item.date)}
                  </div>
                  <div class="font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 mb-2">
                    {item.title}
                  </div>
                  {item.description && (
                    <div class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{item.description}</div>
                  )}
                </a>
              </div>
            ));
          })()
        }
      </div>
    </section>
  </main>

  <script>
    // Random content functionality
    document.getElementById('random-content-btn')?.addEventListener('click', (e) => {
      e.preventDefault();

      // Get all available content URLs from the page
      const contentLinks = document.querySelectorAll('section a[href*="/"]');
      const urls = Array.from(contentLinks)
        .map((link) => link.getAttribute('href'))
        .filter((href) => href && href.startsWith('/') && !href.includes('#'))
        .filter((url, index, arr) => arr.indexOf(url) === index); // Remove duplicates

      if (urls.length > 0) {
        const randomUrl = urls[Math.floor(Math.random() * urls.length)];
        if (randomUrl) {
          window.location.href = randomUrl;
        }
      }
    });
  </script>
</Layout>
