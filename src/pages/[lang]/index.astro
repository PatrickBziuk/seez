---
import Layout from '../../layouts/PageLayout.astro';
import { SUPPORTED_LANGUAGES } from '../../utils/i18n';
import type { SupportedLanguage } from '../../utils/i18n';
import { getCollection } from 'astro:content';

export const getStaticPaths = () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params as { lang: SupportedLanguage };

const collections = ['books', 'projects', 'lab', 'life', 'music', 'pages'] as const;
type Coll = (typeof collections)[number];
type Entry = Awaited<ReturnType<typeof getCollection<Coll>>>[number];
type EntryData = {
  title?: string;
  description?: string;
  language?: 'en' | 'de';
  draft?: boolean;
  publicationStatus?: 'draft' | 'published' | 'archived';
  firstPublishedAt?: string;
  publishDate?: string;
  date?: Date | string;
};

function toDate(entry: Entry): Date | null {
  const data = entry.data as unknown as EntryData;
  const d = data.firstPublishedAt || data.publishDate || data.date;
  if (!d) return null;
  try {
    return d instanceof Date ? d : new Date(d as string);
  } catch {
    return null;
  }
}

function toUrl(entry: Entry): string {
  const data = entry.data as unknown as EntryData;
  const entryLang = data.language || 'en';
  const idNoExt = entry.id.replace(/\.(md|mdx)$/i, '');
  const cleanSlug = idNoExt.replace(/^[a-z]{2}\//, '');

  if (entry.collection === 'pages') {
    if (cleanSlug.startsWith('about/')) return `/${entryLang}/about`;
    if (cleanSlug.startsWith('tech-stack/')) return `/${entryLang}/tech-stack`;
  }

  return `/${entryLang}/${entry.collection}/${cleanSlug}`;
}

const latestBlogItems = (await Promise.all(collections.map((c) => getCollection(c))))
  .flat()
  .filter((entry) => {
    const data = entry.data as unknown as EntryData;
    return data.language === lang && !data.draft && data.publicationStatus !== 'draft';
  })
  .map((entry) => {
    const data = entry.data as unknown as EntryData;
    return {
      title: (data.title || '').toString(),
      description: data.description,
      date: toDate(entry),
      href: toUrl(entry),
      collection: entry.collection,
    };
  })
  .filter((entry) => !!entry.date)
  .sort((a, b) => b.date!.getTime() - a.date!.getTime())
  .slice(0, 4);

const modules = [
  {
    id: 'logs',
    title: lang === 'de' ? 'System Logs' : 'System Logs',
    subtitle: lang === 'de' ? 'Vergangenheit und Beweise' : 'Past and evidence',
    href: `/${lang}/system-logs`,
    status: 'ARCHIVE ONLINE',
  },
  {
    id: 'core',
    title: lang === 'de' ? 'Creative Core' : 'Creative Core',
    subtitle: lang === 'de' ? 'Prozess und Architektur' : 'Process and architecture',
    href: `/${lang}/kreatives`,
    status: 'ENGINE READY',
  },
  {
    id: 'sonic',
    title: lang === 'de' ? 'Sonic Archive' : 'Sonic Archive',
    subtitle: lang === 'de' ? 'Tracks und Stimmen' : 'Tracks and voices',
    href: `/${lang}/musik`,
    status: 'AUDIO MOUNTED',
  },
  {
    id: 'fragments',
    title: lang === 'de' ? 'Fragments' : 'Fragments',
    subtitle: lang === 'de' ? 'Identität und Rollen' : 'Identity and roles',
    href: `/${lang}/fragmente`,
    status: 'DOSSIERS READY',
  },
  {
    id: 'inventory',
    title: lang === 'de' ? 'Inventory' : 'Inventory',
    subtitle: lang === 'de' ? 'Action und Zugang' : 'Action and access',
    href: `/${lang}/inventory`,
    status: 'LOOT ACTIVE',
  },
  {
    id: 'blog',
    title: 'Blog',
    subtitle: lang === 'de' ? 'Alle Inhalte in Timeline' : 'All content in one timeline',
    href: `/${lang}/blog`,
    status: 'LIVE FEED',
  },
];

const metadata = {
  title: lang === 'de' ? 'Seez Erlebnis' : 'Seez Experience',
  description:
    lang === 'de'
      ? 'Ein kreatives Erlebnis mit System Logs, Creative Core, Sonic Archive, Fragments, Inventory und Blog.'
      : 'An immersive creative experience with System Logs, Creative Core, Sonic Archive, Fragments, Inventory and Blog.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="experience-shell">
    <div class="bg-grid" aria-hidden="true"></div>

    <header class="hero max-w-6xl mx-auto px-4 sm:px-6 pt-12 md:pt-20 pb-10">
      <p class="boot">&gt; BOOTING EXPERIENCE_PROTOCOL v2</p>
      <h1 class="text-4xl md:text-7xl font-bold tracking-tight uppercase">
        {lang === 'de' ? 'Seez Universe' : 'Seez Universe'}
      </h1>
      <p class="max-w-3xl text-gray-300 mt-5 text-sm md:text-base leading-relaxed">
        {
          lang === 'de'
            ? 'Kein normales Portfolio. Ein begehbares System aus Vergangenheit, Prozess, Musik, Charakteren, Aktionen und dem vollständigen Blog-Feed.'
            : 'Not a standard portfolio. A navigable system of past, process, music, characters, action, and the full blog feed.'
        }
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="cta cta-primary" href={`/${lang}/kreatives`}>{lang === 'de' ? 'Erlebnis starten' : 'Enter experience'}</a>
        <a class="cta" href={`/${lang}/blog`}>{lang === 'de' ? 'Zum Blog' : 'Open blog'}</a>
      </div>
    </header>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          modules.map((module) => (
            <a href={module.href} class="module-card group">
              <p class="text-xs text-cyan-300">{module.status}</p>
              <h2 class="text-2xl font-bold mt-2">{module.title}</h2>
              <p class="text-sm text-gray-400 mt-2">{module.subtitle}</p>
              <span class="open-link mt-5 inline-block text-xs">&gt;&gt; OPEN</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
      <div class="timeline-shell">
        <div class="flex items-center justify-between gap-3 pb-3 border-b border-gray-800">
          <h2 class="text-2xl font-bold">{lang === 'de' ? 'Live Blog Feed' : 'Live Blog Feed'}</h2>
          <a class="text-xs text-cyan-300 hover:underline" href={`/${lang}/blog`}>
            {lang === 'de' ? 'Alle Beiträge' : 'All entries'}
          </a>
        </div>

        {
          latestBlogItems.length === 0 ? (
            <p class="text-sm text-gray-400 mt-4">
              {lang === 'de' ? 'Noch keine veröffentlichten Einträge.' : 'No published entries yet.'}
            </p>
          ) : (
            <ul class="mt-4 space-y-4">
              {latestBlogItems.map((item) => (
                <li>
                  <a href={item.href} class="timeline-item block">
                    <div class="text-xs text-gray-500">
                      {new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(item.date!)} · {item.collection}
                    </div>
                    <h3 class="text-lg font-semibold mt-1 text-white">{item.title}</h3>
                    {item.description && <p class="text-sm text-gray-400 mt-1 line-clamp-2">{item.description}</p>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </section>
</Layout>

<style>
  .experience-shell {
    --bg: #05070d;
    --panel: rgba(8, 10, 17, 0.86);
    --line: rgba(0, 224, 255, 0.25);
    --text: #d9e2ec;
    position: relative;
    color: var(--text);
    background: radial-gradient(circle at 20% -10%, rgba(0, 194, 255, 0.2), transparent 35%),
      radial-gradient(circle at 90% 10%, rgba(22, 78, 99, 0.25), transparent 30%), var(--bg);
    min-height: calc(100vh - 6rem);
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.35;
  }

  .hero,
  .timeline-shell,
  .module-card {
    position: relative;
    z-index: 1;
  }

  .boot {
    color: #67e8f9;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    margin-bottom: 1rem;
  }

  .cta {
    border: 1px solid #2c3650;
    padding: 0.65rem 1rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: 0.25s ease;
  }

  .cta:hover {
    border-color: #67e8f9;
    color: #67e8f9;
  }

  .cta-primary {
    background: #67e8f9;
    border-color: #67e8f9;
    color: #030712;
    font-weight: 700;
  }

  .cta-primary:hover {
    background: #22d3ee;
    color: #020617;
  }

  .module-card {
    background: var(--panel);
    border: 1px solid #21283b;
    padding: 1.2rem;
    transition: 0.2s ease;
  }

  .module-card:hover {
    border-color: #67e8f9;
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(103, 232, 249, 0.18);
  }

  .open-link {
    color: #67e8f9;
    letter-spacing: 0.08em;
  }

  .timeline-shell {
    background: var(--panel);
    border: 1px solid #21283b;
    padding: 1rem 1rem 1.2rem;
  }

  .timeline-item {
    border-left: 2px solid #1f2937;
    padding-left: 0.75rem;
    transition: 0.2s ease;
  }

  .timeline-item:hover {
    border-left-color: #67e8f9;
    transform: translateX(3px);
  }
</style>
