---
import { getCollection } from 'astro:content';
import SeezRedirect from '../../../components/SeezRedirect.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries
    .filter((entry) => !entry.data.draft && entry.data.language === 'de')
    .map((entry) => ({ params: { slug: entry.id.replace('de/', '').replace(/\.mdx?$/, '') } }));
}
---

<SeezRedirect target="/de/projects" title="SEEZ Projektindex" />
