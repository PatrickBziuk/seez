---
import { getCollection } from 'astro:content';
import SeezRedirect from '../../../components/SeezRedirect.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries
    .filter((entry) => !entry.data.draft && entry.data.language === 'en')
    .map((entry) => ({ params: { slug: entry.id.replace('en/', '').replace(/\.mdx?$/, '') } }));
}
---

<SeezRedirect target="/en/projects" title="SEEZ Project Index" />
