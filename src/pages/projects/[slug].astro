---
import { getCollection } from 'astro:content';
import SeezRedirect from '../../components/SeezRedirect.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id.replace(/\.mdx?$/, '') } }));
}
---

<SeezRedirect target="/de/projects" title="SEEZ Projektindex" />
