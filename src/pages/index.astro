---
// Root page serves English content directly - no redirect page shown
import Layout from '../layouts/PageLayout.astro';
import Hero from '~/components/marketing/hero/Hero.astro';

// Get English homepage data
const metadata = {
  title: 'seez - Creative Cosmos of Music, Texts & Figures',
  description: '🎨 A creative universe where music, texts, and characters intertwine in endless possibilities.',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
  },
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Welcome to the creative cosmos"
    title="Music, Texts & Figures"
    subtitle="🎨 A creative universe where music, texts, and characters intertwine in endless possibilities."
    actions={[
      {
        variant: 'primary',
        text: 'English',
        href: '/en',
        icon: 'tabler:world',
      },
      {
        variant: 'secondary',
        text: 'Deutsch',
        href: '/de',
        icon: 'tabler:world',
      },
    ]}
  />
</Layout>
