---
/**
 * Root: language choice (German first). Plain links, no redirect, so both languages stay crawlable.
 */
import Layout from '~/layouts/Layout.astro';
import Wordmark from '~/components/seez/Wordmark.astro';

const metadata = {
  title: 'Seez',
  description: 'Seez – Musik, Figuren, Archiv. Music, figures, archive.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main id="main" class="root">
    <Wordmark size="lg" />
    <p class="sz-lead">Ein Mensch, sechs Splitter, ein offenes Archiv.</p>
    <p class="sz-lead sz-muted" lang="en">One person, six splinters, an open archive.</p>
    <div class="sz-btn-row">
      <a class="sz-btn sz-btn--primary" href="/de" hreflang="de" lang="de">Deutsch</a>
      <a class="sz-btn" href="/en" hreflang="en" lang="en">English</a>
    </div>
  </main>
</Layout>

<style>
  .root {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: var(--sp-5);
    padding: var(--sp-6) var(--gutter);
  }
</style>
