---
/**
 * ArticleFooter - Modern, scannable article footer with transparent AI impact
 * @props title - Article title for sharing
 * @props url - Article URL for sharing
 * @props wordCount - Word count from frontmatter
 * @props readingTime - Reading time from frontmatter
 * @props readingFormatted - Formatted reading time from frontmatter
 * @props publishDate - Article publish date
 * @props lastModified - Last modified date from frontmatter
 * @props canonicalId - Unique content identifier for AI metrics
 * @props language - Content language
 * @props slug - Article slug for GitHub links
 * @props tags - Article tags (optional, as they're moving to top)
 * @behavior Ordered structure: Share → Facts → AI Impact → License
 * @dependencies SocialShareFooter, ArticleFacts, AIImpact components
 * @usedBy MarkdownLayout and content layouts for unified footer experience
 */

import SocialShareFooter from './SocialShareFooter.astro';
import ArticleFacts from './ArticleFacts.astro';
import AIImpact from './AIImpact.astro';

interface Props {
  title: string;
  url: string | URL;
  wordCount?: number;
  readingTime?: number;
  readingFormatted?: string;
  publishDate?: Date | string;
  lastModified?: string;
  canonicalId?: string;
  language?: string;
  slug?: string;
  tags?: string[];
  showTags?: boolean;
  licenseUrl?: string;
  licenseText?: string;
}

const {
  title,
  url,
  wordCount,
  readingTime,
  readingFormatted,
  publishDate,
  lastModified,
  canonicalId,
  language = 'en',
  slug,
  tags = [],
  licenseUrl = 'https://creativecommons.org/licenses/by-sa/4.0/',
  licenseText,
} = Astro.props;

const defaultLicenseText =
  language === 'de' ? 'Dieser Inhalt steht unter CC BY-SA 4.0 Lizenz' : 'This content is licensed under CC BY-SA 4.0';

const currentYear = new Date().getFullYear();
---

<footer class="article-footer mt-12 space-y-8">
  <!-- 1. Share & Follow - Most engaged readers -->
  <section aria-label={language === 'de' ? 'Artikel teilen und folgen' : 'Share article and follow updates'}>
    <SocialShareFooter text={title} url={url} language={language} tags={tags} />
  </section>

  <!-- 2. Article Facts - Compact metadata with details toggle -->
  <section aria-label={language === 'de' ? 'Artikel-Details' : 'Article details'}>
    <ArticleFacts
      wordCount={wordCount}
      readingTime={readingTime}
      readingFormatted={readingFormatted}
      publishDate={publishDate}
      lastModified={lastModified}
      canonicalId={canonicalId}
      language={language}
      slug={slug}
    />
  </section>

  <!-- 3. AI Usage & Environmental Impact - Default collapsed, transparent methodology -->
  <section aria-label={language === 'de' ? 'KI-Umweltauswirkung' : 'AI environmental impact'}>
    <AIImpact canonicalId={canonicalId} />
  </section>

  <!-- 4. Tech Stack CTA - Inspiring call-to-action for similar projects -->
  <section aria-label={language === 'de' ? 'Tech Stack' : 'Tech Stack'} class="text-center py-6">
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
        {language === 'de' ? 'Möchtest du etwas Ähnliches bauen?' : 'Want to build something similar?'}
      </h3>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        {
          language === 'de'
            ? 'Entdecke die Technologien, Frameworks und Prinzipien hinter diesem Projekt.'
            : 'Discover the technologies, frameworks, and principles behind this project.'
        }
      </p>
      <a
        href={language === 'de' ? '/de/tech-stack' : '/en/tech-stack'}
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
      >
        {language === 'de' ? 'Tech Stack ansehen' : 'View Tech Stack'}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- 5. License & Timestamp - Tiny footer line -->
  <section
    aria-label={language === 'de' ? 'Lizenz und Urheberrecht' : 'License and copyright'}
    class="border-t border-gray-200 dark:border-gray-700 pt-4"
  >
    <div class="text-xs text-gray-500 dark:text-gray-500 space-y-2">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
        <div>
          <a
            href={licenseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
          >
            {licenseText || defaultLicenseText}
          </a>
        </div>
        <div>
          © {currentYear} Patrick Bziuk
        </div>
      </div>
      <div class="text-center sm:text-left">
        {
          language === 'de'
            ? 'Erstellt mit Astro, gehostet auf GitHub Pages & Codeberg Pages'
            : 'Built with Astro, hosted on GitHub Pages & Codeberg Pages'
        }
      </div>
    </div>
  </section>
</footer>

<style>
  .article-footer {
    margin-top: 3rem;
  }

  .article-footer section {
    scroll-margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .article-footer {
      margin-top: 2rem;
    }
  }
</style>
