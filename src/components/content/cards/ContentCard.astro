---
/**
 * ContentCard - Enhanced card for category pages showing content with TLDR and metadata
 * @props {item: CollectionEntry, lang: SupportedLanguage, basePath: string}
 * @behavior Shows title, TLDR summary, date, and collapsible tags section
 * @dependencies Icon (astro-icon), getTranslations, date formatting utilities
 * @usedBy Category index pages (books, projects, lab, life, music)
 */
import { Icon } from 'astro-icon/components';
import { getTranslations } from '~/utils/i18n';
import { getPermalink } from '~/utils/permalinks';
import type { SupportedLanguage } from '~/utils/i18n';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  item: CollectionEntry<'books' | 'projects' | 'lab' | 'life' | 'music'>;
  lang: SupportedLanguage;
  basePath: string;
}

const { item, lang, basePath } = Astro.props;
const translations = await getTranslations(lang);

// Helper function to extract clean slug from content ID
const getCleanSlug = (id: string) => {
  return id.replace(/^[a-z]{2}\//, '').replace(/\.mdx?$/, '');
};

// Generate new canonical URL format: slug-canonicalId
const generateItemUrl = (
  item: CollectionEntry<'books' | 'projects' | 'lab' | 'life' | 'music'>,
  lang: string,
  basePath: string
) => {
  const cleanSlug = getCleanSlug(item.id);
  const canonicalId = item.data.canonicalId;

  if (canonicalId) {
    // New canonical URL format
    return `/${lang}/${basePath}/${cleanSlug}-${canonicalId}`;
  } else {
    // Fallback to old format if no canonical ID (backwards compatibility)
    return `/${lang}/${basePath}/${cleanSlug}`;
  }
};

// Format dates
const formatDate = (date: Date | string | undefined) => {
  if (!date) return null;
  const dateObj = typeof date === 'string' ? new Date(date) : date;
  return dateObj.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const publishDate = formatDate(item.data.publishDate || item.data.timestamp);
const summary = item.data.ai_tldr || item.data.description;
---

<div
  class="flex flex-col min-h-80 p-6 rounded-lg bg-white dark:bg-slate-900 border border-gray-200 dark:border-gray-700 hover:border-primary-500 dark:hover:border-primary-400 hover:shadow-lg transition-all duration-200"
>
  <!-- Title -->
  <a href={getPermalink(generateItemUrl(item, lang, basePath))} class="group">
    <h2
      class="text-xl font-semibold mb-3 font-heading dark:text-gray-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2"
    >
      {item.data.title}
    </h2>
  </a>

  <!-- TLDR Summary - Flexible space with max height -->
  <div class="flex-1 mb-4 min-h-0">
    {
      summary ? (
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-tldr overflow-hidden">
          {summary}
        </p>
      ) : (
        <p class="text-slate-400 dark:text-slate-500 text-sm italic">
          {translations?.metadata?.no_summary || 'No summary available'}
        </p>
      )
    }
  </div>

  <!-- Bottom Section: Date and Tags -->
  <div class="mt-auto">
    <!-- Date Published -->
    {
      publishDate && (
        <div class="flex items-center gap-1.5 mb-3 text-xs text-slate-500 dark:text-slate-400">
          <Icon name="tabler:calendar" class="w-3.5 h-3.5" />
          <span>{publishDate}</span>
        </div>
      )
    }

    <!-- Collapsible Tags Section -->
    {
      item.data.tags && item.data.tags.length > 0 && (
        <div class="border-t border-slate-200/60 dark:border-slate-700/60 pt-3">
          <details class="group">
            <summary class="flex items-center justify-between cursor-pointer text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors">
              <span class="flex items-center gap-1.5">
                <Icon name="tabler:tags" class="w-3.5 h-3.5" />
                {translations?.metadata?.tags || 'Tags'} ({item.data.tags.length})
              </span>
              <Icon name="tabler:chevron-down" class="w-3 h-3 transition-transform group-open:rotate-180" />
            </summary>
            <div class="mt-2 flex flex-wrap gap-2 max-h-20 overflow-y-auto">
              {item.data.tags.map((tag) => (
                <a
                  href={getPermalink(`/${lang}/tags/${encodeURIComponent(tag)}`)}
                  class="inline-block bg-primary-100 dark:bg-primary-900 text-primary-800 dark:text-primary-200 text-xs px-2 py-1 rounded hover:bg-primary-200 dark:hover:bg-primary-800 transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          </details>
        </div>
      )
    }
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-tldr {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Custom scrollbar for tags section */
  .overflow-y-auto::-webkit-scrollbar {
    width: 4px;
  }

  .overflow-y-auto::-webkit-scrollbar-track {
    background: transparent;
  }

  .overflow-y-auto::-webkit-scrollbar-thumb {
    background: rgb(148 163 184 / 0.3);
    border-radius: 2px;
  }

  .dark .overflow-y-auto::-webkit-scrollbar-thumb {
    background: rgb(71 85 105 / 0.3);
  }

  .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: rgb(148 163 184 / 0.5);
  }

  .dark .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: rgb(71 85 105 / 0.5);
  }
</style>
