---
/**
 * RelatedProjects - Shows mentioned projects with links to their pages
 * @props projects: ProjectLink[] - Array of project links to display
 * @behavior Displays a grid of project cards with links, descriptions, and existence status
 * @dependencies ProjectLink interface from projectLinks utility
 * @usedBy About pages, project pages for cross-references
 */

import type { ProjectLink } from '../../utils/content/projectLinks';

export interface Props {
  projects: ProjectLink[];
  title?: string;
  className?: string;
}

const { 
  projects = [], 
  title = 'Related Projects',
  className = ''
} = Astro.props;

// Filter to only show existing projects
const existingProjects = projects.filter(p => p.exists && p.url);
---

{existingProjects.length > 0 && (
  <section class={`related-projects ${className}`}>
    <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
      {title}
    </h3>
    
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {existingProjects.map((project) => (
        <a 
          href={project.url}
          class="block p-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200 group"
          aria-label={`View ${project.name} project`}
        >
          <div class="flex items-start gap-3">
            <div class="text-2xl" aria-hidden="true">
              {project.name.split(' ')[0]}
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                {project.name.split(' ').slice(1).join(' ')}
              </h4>
              {project.description && (
                <p class="text-sm text-gray-600 dark:text-gray-300 mt-1 line-clamp-2">
                  {project.description}
                </p>
              )}
            </div>
          </div>
          
          <div class="mt-3 flex items-center text-xs text-primary font-medium">
            Learn more
            <svg 
              class="w-3 h-3 ml-1 transition-transform group-hover:translate-x-1" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .related-projects {
    margin: 2rem 0;
  }
</style>
