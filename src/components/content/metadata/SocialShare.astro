---
/**
 * SocialShare - Social media sharing buttons for content
 * @props {text: string, url: string | URL, class?: string} - Share text, URL, and optional CSS classes
 * @behavior Renders social sharing buttons for Twitter/X, Facebook, LinkedIn, Mastodon, WhatsApp, and Email
 * @dependencies astro-icon/components, social sharing utilities
 * @usedBy Blog posts, article pages, content sharing sections
 */
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
  showMastodon?: boolean;
}

const { text, url, class: className = 'inline-block', showMastodon = true } = Astro.props;
---

<div class={`${className} flex items-center gap-1`}>
  <span class="text-xs text-slate-500 dark:text-slate-400 mr-2 font-medium">Share:</span>
  <a
    class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
    title="Share on Twitter/X"
    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url.toString())}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Twitter/X (opens in new tab)"
    ><Icon
      name="tabler:brand-x"
      class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    />
  </a>
  <a
    class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
    title="Share on Facebook"
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url.toString())}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Facebook (opens in new tab)"
    ><Icon
      name="tabler:brand-facebook"
      class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    />
  </a>
  <a
    class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
    title="Share on LinkedIn"
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url.toString())}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn (opens in new tab)"
    ><Icon
      name="tabler:brand-linkedin"
      class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    />
  </a>
  {
    showMastodon && (
      <a
        class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
        title="Share on Mastodon"
        href={`https://mastodon.social/share?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url.toString())}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Mastodon (opens in new tab)"
      >
        <Icon
          name="tabler:brand-mastodon"
          class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
        />
      </a>
    )
  }
  <a
    class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
    title="Share via WhatsApp"
    href={`https://wa.me/?text=${encodeURIComponent(text + ' ' + url.toString())}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share via WhatsApp (opens in new tab)"
    ><Icon
      name="tabler:brand-whatsapp"
      class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    />
  </a>
  <a
    class="inline-flex items-center justify-center w-6 h-6 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-200"
    title="Share via Email"
    href={`mailto:?subject=${encodeURIComponent(text)}&body=${encodeURIComponent(text + '\n\n' + url.toString())}`}
    aria-label="Share via Email"
    ><Icon
      name="tabler:mail"
      class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200"
    />
  </a>
</div>
