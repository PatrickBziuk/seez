---
/**
 * Footer - Site footer with navigation links and social media
 * @props links, secondaryLinks, socialLinks, theme, locale, footNote
 * @behavior Renders responsive footer with version indicator and site branding
 * @dependencies Icon (astro-icon), seez.config for site info, VersionIndicator
 * @usedBy Layout.astro, MarkdownLayout.astro, PageLayout.astro
 */
import { Icon } from 'astro-icon/components';
import { getSiteInfo } from '~/config/seez.config';
import { getLocalizedUrl } from '~/utils/i18n';
import VersionIndicator from '../../common/VersionIndicator.astro';

const siteInfo = getSiteInfo();

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  theme?: string;
  locale?: 'en' | 'de';
  footNote?: string;
}

const { secondaryLinks = [], links = [], theme = 'light', locale = 'en', footNote = '' } = Astro.props;
// Ensure locale is 'en' or 'de'
const safeLocale: 'en' | 'de' = locale === 'de' ? 'de' : 'en';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="lg:col-span-1">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl" href={getLocalizedUrl('/', safeLocale)}>{siteInfo.name}</a>
        </div>
        <div class="text-sm text-muted flex flex-wrap gap-1.5 mb-4">
          {
            secondaryLinks.map(({ text, href }: Link, index: number) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a href={href} class="hover:text-default transition-colors">
                  {text}
                </a>
              </>
            ))
          }
        </div>
        <VersionIndicator locale={safeLocale} position="footer" />
      </div>
      {
        links.map(({ title, links }: Links) => (
          <div class="lg:col-span-1">
            <details class="footer-section" data-footer-section>
              <summary class="footer-section-summary">
                <span class="dark:text-gray-200 font-semibold text-sm tracking-wide uppercase">{title}</span>
                <Icon name="tabler:chevron-down" class="h-4 w-4 footer-chevron md:hidden" />
              </summary>
              {links && Array.isArray(links) && links.length > 0 && (
                <ul class="footer-links mt-3 space-y-2">
                  {links.map(({ text, href, ariaLabel, icon }) => (
                    <li>
                      <a
                        href={href}
                        aria-label={text || ariaLabel}
                        class="text-sm text-muted hover:text-default dark:hover:text-white transition-colors inline-flex items-center gap-2 leading-6 py-0.5"
                        target={href?.startsWith('http') ? '_blank' : undefined}
                        rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                      >
                        {icon && <Icon name={icon} class="w-4 h-4" />}
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      <div class="text-sm text-muted mr-4">
        {footNote}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section-summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    list-style: none;
    min-height: 44px;
  }

  .footer-section-summary::-webkit-details-marker {
    display: none;
  }

  .footer-chevron {
    transition: transform 0.2s ease;
  }

  .footer-section[open] .footer-chevron {
    transform: rotate(180deg);
  }

  @media (min-width: 768px) {
    .footer-section-summary {
      cursor: default;
      min-height: auto;
      pointer-events: none;
    }

    .footer-links {
      display: block !important;
    }
  }
</style>
