---
/**
 * Header - Main site header/navigation bar
 * @props id?: string; links?: MenuLink[]; actions?: CallToAction[]; isSticky?: boolean; isDark?: boolean; isFullWidth?: boolean; showToggleTheme?: boolean; showRssFeed?: boolean; position?: string; locale?: 'en' | 'de'
 * @behavior Renders logo, navigation links, theme toggle, LanguageSwitcher, and optional actions. Responsive, accessible, visually balanced. Only one LanguageSwitcher instance rendered.
 * @dependencies Logo, ToggleTheme, ToggleMenu, Button, LanguageSwitcher, getTranslations
 * @usedBy PageLayout.astro, MarkdownLayout.astro
 */

import { Icon } from 'astro-icon/components';
import Logo from '~/components/core/brand/Logo.astro';
import ToggleTheme from '~/components/core/layout/ToggleTheme.astro';
import ToggleMenu from '~/components/core/layout/ToggleMenu.astro';
import Button from '~/components/ui/forms/Button.astro';
import LanguageSwitcher from '~/components/core/layout/LanguageSwitcher.astro';

import { trimSlash, getAsset } from '~/utils/permalinks';
import { getLocalizedUrl } from '~/utils/i18n';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  locale?: 'en' | 'de';
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  locale = 'en',
} = Astro.props;
// Ensure locale is 'en' or 'de'
const safeLocale: 'en' | 'de' = locale === 'de' ? 'de' : 'en';

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Helper function to check if a navigation link is active
const isLinkActive = (href: string) => {
  if (!href) return false;

  // Handle root/home page
  if (href === `/${safeLocale}` || href === '/') {
    return currentPath === `/${safeLocale}` || currentPath === '/';
  }

  // For category pages like /en/books, /en/projects, etc.
  const normalizedHref = href.replace(/^\//, '').replace(/\/$/, '');
  const normalizedPath = currentPath.replace(/^\//, '').replace(/\/$/, '');

  // Check if current path starts with the href (for category pages)
  return normalizedPath.startsWith(normalizedHref);
};

// Debug URL generation
const logoUrl = getLocalizedUrl('/', safeLocale);
// Ensure no trailing slash for logo URL
const cleanLogoUrl = logoUrl.endsWith('/') && logoUrl !== '/' ? logoUrl.slice(0, -1) : logoUrl;
// Show debug nav-mode indicator only in development
const showDebugIndicator = import.meta.env.DEV;
---

<style>
  #language-menu-dropdown {
    min-width: 10rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    border-radius: 0.75rem;
    padding: 0.5rem 0;
  }

  /* Navigation Active State with Animated Underline */
  .nav-list {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 1rem;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: #000;
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    width: calc(100% - 2rem);
  }

  /* Dark mode support */
  :global(.dark) .nav-link::after {
    background: #fff;
  }

  /* Ensure smooth transitions for mobile */
  @media (max-width: 768px) {
    .nav-link::after {
      display: none;
    }
  }

  /* Small, subtle indicator for current nav mode */
  .nav-mode-indicator {
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    background: rgba(55, 65, 81, 0.12);
    color: #6b7280;
    user-select: none;
  }
  :global(.dark) .nav-mode-indicator {
    background: rgba(255, 255, 255, 0.12);
    color: #9ca3af;
  }

  /* Hardening: enforce nav visibility based on header state */
  :where(header[data-active-nav='desktop']) nav[data-nav='desktop'] {
    display: flex !important;
  }
  :where(header[data-active-nav='desktop']) nav[data-nav='mobile'] {
    display: none !important;
  }
  /* Ensure burger button is hidden in desktop mode even if rendered by a child component */
  :where(header[data-active-nav='desktop']) :global([data-aw-toggle-menu]) {
    display: none !important;
  }

  :where(header[data-active-nav='mobile']) nav[data-nav='desktop'] {
    display: none !important;
  }
  /* Allow mobile toggle button in mobile mode; visibility still responds to breakpoints */
  :where(header[data-active-nav='mobile']) :global([data-aw-toggle-menu]) {
    display: flex;
  }

  /* Hardening: unconditional desktop enforcement via media query */
  @media (min-width: 1280px) {
    nav[data-nav='desktop'] {
      display: flex !important;
    }
    nav[data-nav='mobile'] {
      display: none !important;
    }
    /* Target the burger globally so scoping doesn't prevent hiding on desktop */
    :global([data-aw-toggle-menu]) {
      display: none !important;
    }
  }
</style>

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
  data-active-nav="unknown"
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      { 'xl:flex xl:justify-between': position !== 'center' },
      { 'xl:grid xl:grid-cols-[auto_1fr_auto] xl:items-center': position === 'center' },
      { 'max-w-7xl': !isFullWidth },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={cleanLogoUrl}>
        <Logo />
      </a>
      <div class="flex items-center xl:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      aria-label={locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}
      class="main-nav items-center w-full xl:w-auto hidden xl:flex xl:mx-5 text-default overflow-y-auto overflow-x-hidden xl:overflow-y-visible xl:overflow-x-auto xl:justify-self-center"
      data-nav="desktop"
    >
      <ul
        class="nav-list flex flex-col xl:flex-row xl:self-center w-full xl:w-auto text-xl xl:text-[0.875rem] tracking-[0.01rem] font-medium xl:justify-center"
      >
        {
          links.map(({ text, href, links }: MenuLink) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    aria-label={text}
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu xl:backdrop-blur-md dark:xl:bg-dark rounded xl:absolute pl-4 xl:pl-0 xl:hidden font-medium xl:bg-white/90 xl:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }: MenuLink) => (
                      <li>
                        <a
                          aria-label={text2}
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5.5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  aria-label={text}
                  class:list={[
                    'nav-link hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { active: isLinkActive(href || '') },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Navigation -->
    <nav
      aria-label={locale === 'de' ? 'Mobile Navigation' : 'Mobile navigation'}
      class="mobile-nav xl:hidden w-full bg-white dark:bg-gray-800 shadow-xl rounded-xl mt-3 border border-gray-200 dark:border-gray-700 overflow-hidden hidden"
      data-nav="mobile"
      id="mobile-navigation"
    >
      <ul class="flex flex-col py-2">
        {
          links.map(({ text, href, links }: MenuLink) => (
            <li>
              {links?.length ? (
                <div class="mobile-dropdown">
                  <button
                    type="button"
                    aria-label={text}
                    class="w-full text-left hover:bg-gray-100 dark:hover:bg-gray-700 px-5 py-3.5 min-h-[44px] flex items-center justify-between text-[0.95rem] leading-6"
                  >
                    {text}
                    <Icon name="tabler:chevron-down" class="w-4 h-4" />
                  </button>
                  <ul class="mobile-submenu hidden pl-4 bg-gray-50 dark:bg-gray-700">
                    {links.map(({ text: text2, href: href2 }: MenuLink) => (
                      <li>
                        <a
                          aria-label={text2}
                          class:list={[
                            'block px-5 py-3 min-h-[44px] text-[0.95rem] leading-6 hover:bg-gray-100 dark:hover:bg-gray-600',
                            {
                              'active bg-blue-50 dark:bg-blue-900 text-blue-600 dark:text-blue-400':
                                href2 === currentPath,
                            },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <a
                  aria-label={text}
                  class:list={[
                    'block px-5 py-3.5 min-h-[44px] text-[0.95rem] leading-6 hover:bg-gray-100 dark:hover:bg-gray-700 border-l-4 border-transparent',
                    {
                      'active bg-blue-50 dark:bg-blue-900 text-blue-600 dark:text-blue-400 border-blue-500':
                        isLinkActive(href || ''),
                    },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="header-icons flex items-center gap-2 md:gap-4" style="position:relative;">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          <LanguageSwitcher currentLanguage={safeLocale} />
          <!-- Search Button -->
          <button
            id="search-button"
            class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
            aria-label="Search"
            title="Search (Press / to open)"
          >
            <Icon name="tabler:search" class="w-5 h-5" />
          </button>
          {
            showRssFeed && (
              <a
                class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
          <!-- Nav mode indicator (desktop/mobile) - visible only in development -->
          {
            showDebugIndicator && (
              <span id="nav-mode-indicator" class="nav-mode-indicator" data-mode="unknown" aria-live="polite">
                unknown
              </span>
            )
          }
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps: CallToAction) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden" style="display: none;">
  <div class="flex items-start justify-center min-h-screen pt-16 px-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-2xl">
      <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Search</h2>
        <button id="search-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300" aria-label="Close">
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
      </div>
      <div id="search-container" class="min-h-[200px]">
        <!-- Search content will be loaded here -->
      </div>
    </div>
  </div>
</div>

<script>
  const DESKTOP_NAV_QUERY = '(min-width: 1280px)';

  // Mobile navigation toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    // Minimal Pagefind typings to avoid using `any` and satisfy ESLint
    type PagefindResultData = {
      url: string;
      excerpt?: string;
      meta: { title?: string };
    };
    type PagefindResultItem = { data(): Promise<PagefindResultData> };
    type PagefindSearchResponse = { results: PagefindResultItem[] };
    interface PagefindGlobal {
      search: (query: string) => Promise<PagefindSearchResponse>;
    }
    const getPagefind = (): PagefindGlobal | undefined => (window as unknown as { pagefind?: PagefindGlobal }).pagefind;
    const toggleButton = document.querySelector('[data-aw-toggle-menu]');
    const mobileNav = document.getElementById('mobile-navigation');

    if (toggleButton && mobileNav) {
      toggleButton.addEventListener('click', () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';

        // Toggle mobile nav visibility
        mobileNav.classList.toggle('hidden');

        // Update button state
        toggleButton.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
        toggleButton.classList.toggle('expanded');

        // Handle mobile dropdown toggles
        const mobileDropdowns = mobileNav.querySelectorAll('.mobile-dropdown button');
        mobileDropdowns.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const submenu = button.nextElementSibling;
            if (submenu) {
              submenu.classList.toggle('hidden');
              button.classList.toggle('expanded');
            }
          });
        });
      });

      // Close mobile nav when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileNav.contains(e.target as Node) && !toggleButton.contains(e.target as Node)) {
          mobileNav.classList.add('hidden');
          toggleButton.setAttribute('aria-expanded', 'false');
          toggleButton.classList.remove('expanded');
        }
      });
    }

    // Search modal functionality
    const searchButton = document.getElementById('search-button');
    const searchModal = document.getElementById('search-modal');
    const searchModalClose = document.getElementById('search-close');
    const searchContainer = document.getElementById('search-container');

    let searchInitialized = false;

    const openSearchModal = async () => {
      if (searchModal) {
        searchModal.style.display = 'block';
        searchModal.classList.remove('hidden');

        // Initialize search if not already done
        if (!searchInitialized && searchContainer) {
          await initializeSearch();
          searchInitialized = true;
        }

        // Focus the search input if available
        setTimeout(() => {
          const searchInput = searchContainer?.querySelector('input[type="search"]') as HTMLInputElement;
          if (searchInput) {
            searchInput.focus();
          }
        }, 100);
      }
    };

    const closeSearchModal = () => {
      if (searchModal) {
        searchModal.style.display = 'none';
        searchModal.classList.add('hidden');
      }
    };

    const initializeSearch = async () => {
      if (!searchContainer) return;

      console.log('Search: Initializing search functionality...');

      try {
        // Try to load Pagefind directly
        console.log('Search: Attempting to load Pagefind...');
        await loadPagefind();
      } catch (error) {
        console.log('Search: Failed to initialize search:', error);

        // Check if we're likely in development mode
        const errorMessage = error instanceof Error ? error.message : String(error);
        console.log('Search error details:', errorMessage);

        // More specific development mode detection
        // Determine environment by checking asset availability rather than relying on ports
        const isDevelopment =
          errorMessage.includes('404') ||
          errorMessage.includes('Failed to load') ||
          errorMessage.includes('timeout') ||
          errorMessage.includes('net::ERR');

        if (isDevelopment) {
          console.log('Search: Likely development mode detected');
          searchContainer.innerHTML = `
            <div class="p-6 text-center text-gray-500 dark:text-gray-400">
              <div class="mb-4">
                <svg class="w-12 h-12 mx-auto mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <p class="text-sm mb-2 font-medium">🔍 Search in Development Mode</p>
              <p class="text-xs mb-3">Search requires a production build to generate the search index.</p>
              <div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-xs">
                <p class="font-mono mb-1">pnpm run build</p>
                <p class="font-mono">pnpm run preview</p>
              </div>
            </div>
          `;
        } else {
          searchContainer.innerHTML = `
            <div class="p-6 text-center text-gray-500 dark:text-gray-400">
              <div class="mb-4">
                <svg class="w-12 h-12 mx-auto mb-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <p class="text-sm mb-2 font-medium">Search Unavailable</p>
              <p class="text-xs">Unable to load search functionality. Please try again later.</p>
            </div>
          `;
        }
      }
    };

    // Helper function to load and initialize Pagefind
    const loadPagefind = async () => {
      try {
        console.log('Loading pagefind script...');

        // Quick preflight: verify the script exists (works in preview/build; will fail in dev)
        try {
          const headResp = await fetch('/pagefind/pagefind.js', { method: 'HEAD' });
          if (!headResp.ok) {
            throw new Error(`pagefind.js not reachable: status ${headResp.status}`);
          }
        } catch (preflightErr) {
          throw new Error(
            `Preflight check failed for Pagefind: ${preflightErr instanceof Error ? preflightErr.message : String(preflightErr)}`
          );
        }

        // Load the Pagefind script
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind.js';
        script.type = 'text/javascript';

        await new Promise<void>((resolve, reject) => {
          const timeout = setTimeout(() => {
            reject(new Error('Script loading timeout after 10 seconds'));
          }, 10000); // Increased timeout to 10 seconds

          script.onload = () => {
            clearTimeout(timeout);
            console.log('Pagefind script loaded successfully');
            resolve();
          };
          script.onerror = () => {
            clearTimeout(timeout);
            reject(new Error('Failed to load pagefind.js'));
          };
          document.head.appendChild(script);
        });

        // Wait for Pagefind to be available with longer timeout
        console.log('Waiting for pagefind to be available...');
        let attempts = 0;
        while (attempts < 25 && !getPagefind()) {
          await new Promise((resolve) => setTimeout(resolve, 200));
          attempts++;
          if (attempts % 5 === 0) {
            console.log(`Still waiting for pagefind... attempt ${attempts}/25`);
          }
        }

        if (!getPagefind()) {
          console.error('Pagefind object not found on window after script load');
          console.log(
            'Window keys containing "pagefind":',
            Object.keys(window).filter((k) => k.toLowerCase().includes('pagefind'))
          );
          throw new Error(`Pagefind not available after ${attempts} attempts (${attempts * 200}ms)`);
        }

        console.log('Pagefind is ready and available on window object');
      } catch (error) {
        console.error('Failed to load pagefind:', error);
        throw error;
      }

      // Initialize the search UI
      if (!searchContainer) return;

      searchContainer.innerHTML = `
        <div class="p-4">
          <div class="relative mb-4">
            <input 
              type="search" 
              id="pagefind-search" 
              placeholder="Search content..." 
              class="w-full px-4 py-3 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              autocomplete="off"
            />
            <div class="absolute inset-y-0 right-0 flex items-center pr-3">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>
          <div id="search-results" class="min-h-[100px] max-h-[400px] overflow-y-auto"></div>
        </div>
      `;

      // Set up search functionality
      const searchInput = document.getElementById('pagefind-search') as HTMLInputElement;
      const resultsContainer = document.getElementById('search-results')!;

      let debounceTimer: number;

      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(async () => {
          const query = (e.target as HTMLInputElement).value.trim();

          if (query.length < 2) {
            resultsContainer.innerHTML =
              '<p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">Type at least 2 characters to search...</p>';
            return;
          }

          try {
            resultsContainer.innerHTML =
              '<p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">Searching...</p>';

            const pf = getPagefind();
            if (!pf) {
              throw new Error('Pagefind not initialized');
            }
            const search = await pf.search(query);

            if (search.results.length === 0) {
              resultsContainer.innerHTML =
                '<p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">No results found</p>';
              return;
            }

            const resultsHtml = await Promise.all(
              search.results.slice(0, 8).map(async (result: PagefindResultItem) => {
                const data = await result.data();
                return `
                  <div class="p-3 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg border-b border-gray-100 dark:border-gray-600 last:border-b-0">
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white mb-1">
                      <a href="${data.url}" class="hover:text-blue-600 dark:hover:text-blue-400">${data.meta.title || 'Untitled'}</a>
                    </h3>
                    <p class="text-xs text-gray-600 dark:text-gray-300 mb-2">${data.excerpt}</p>
                    <p class="text-xs text-gray-400">${data.url}</p>
                  </div>
                `;
              })
            );

            resultsContainer.innerHTML = resultsHtml.join('');

            // Add click handlers to close modal when clicking results
            resultsContainer.querySelectorAll('a').forEach((link) => {
              link.addEventListener('click', () => {
                closeSearchModal();
              });
            });
          } catch (error) {
            console.error('Search error:', error);
            resultsContainer.innerHTML = '<p class="text-red-500 text-sm text-center py-4">Search error occurred</p>';
          }
        }, 300);
      });

      console.log('Search: Pagefind initialized successfully');
    };

    // Event listeners
    if (searchButton) {
      searchButton.addEventListener('click', openSearchModal);
    }

    if (searchModalClose) {
      searchModalClose.addEventListener('click', closeSearchModal);
    }

    // Close modal when clicking outside
    if (searchModal) {
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) {
          closeSearchModal();
        }
      });
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // Open search with / key
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
        // Don't trigger if user is typing in an input/textarea
        const target = e.target as HTMLElement;
        if (target && target.tagName !== 'INPUT' && target.tagName !== 'TEXTAREA') {
          e.preventDefault();
          openSearchModal();
        }
      }

      // Close search with Escape key
      if (e.key === 'Escape') {
        closeSearchModal();
      }
    });

    // Initialize nav mode indicator on first load
    const mqInitial = window.matchMedia(DESKTOP_NAV_QUERY);
    if (mqInitial.matches) {
      updateNavModeIndicator('desktop');
    } else {
      updateNavModeIndicator('mobile');
    }
  });

  // Helpers to manage mobile nav state defensively
  const forceMobileNavHidden = () => {
    const toggleButton = document.querySelector('[data-aw-toggle-menu]') as HTMLElement | null;
    const mobileNav = document.getElementById('mobile-navigation');
    const desktopNav = document.querySelector('nav[data-nav="desktop"]') as HTMLElement | null;
    if (toggleButton && mobileNav) {
      mobileNav.classList.add('hidden');
      mobileNav.setAttribute('aria-hidden', 'true');
      toggleButton.setAttribute('aria-expanded', 'false');
      toggleButton.classList.remove('expanded');
    }
    if (desktopNav) {
      desktopNav.classList.remove('hidden');
      desktopNav.setAttribute('aria-hidden', 'false');
    }
  };

  const updateNavModeIndicator = (mode: 'desktop' | 'mobile' | 'unknown') => {
    try {
      const indicator = document.getElementById('nav-mode-indicator');
      const header = document.getElementById('header') as HTMLElement | null;
      if (indicator) {
        indicator.textContent = mode;
        indicator.setAttribute('data-mode', mode);
      }
      if (header) {
        header.setAttribute('data-active-nav', mode);
      }
      console.log('[Header] mode updated:', {
        mode,
        hasIndicator: !!indicator,
        hasHeader: !!header,
      });
    } catch (e) {
      console.warn('[Header] Failed to update mode indicator', e);
    }
  };

  const applyMode = () => {
    const mq = window.matchMedia(DESKTOP_NAV_QUERY);
    if (mq.matches) {
      // Synchronously enforce desktop mode
      updateNavModeIndicator('desktop');
      forceMobileNavHidden();
    } else {
      updateNavModeIndicator('mobile');
    }
  };

  const resetMobileNavState = async () => {
    // Small delay to allow CSS and layout to settle after navigation
    await new Promise((resolve) => setTimeout(resolve, 50));
    await new Promise(requestAnimationFrame);

    // If we are at/above desktop breakpoint, ensure mobile nav is hidden
    const mq = window.matchMedia(DESKTOP_NAV_QUERY);
    if (mq.matches) {
      forceMobileNavHidden();
      updateNavModeIndicator('desktop');
    } else {
      // In mobile mode, ensure ARIA reflects state
      const desktopNav = document.querySelector('nav[data-nav="desktop"]') as HTMLElement | null;
      const mobileNav = document.getElementById('mobile-navigation');
      if (desktopNav) desktopNav.setAttribute('aria-hidden', 'true');
      if (mobileNav) mobileNav.setAttribute('aria-hidden', 'false');
      updateNavModeIndicator('mobile');
    }
  };

  // Also initialize on client-side navigation (Astro View Transitions)
  document.addEventListener('astro:page-load', async () => {
    applyMode();
    await resetMobileNavState();
  });

  // Reset after Astro swaps DOM content during transitions
  document.addEventListener('astro:after-swap', async () => {
    applyMode();
    await resetMobileNavState();
  });

  // Watch for viewport changes explicitly
  const mediaQuery = window.matchMedia('(min-width: 1280px)');
  const mqHandler = (e: MediaQueryList | MediaQueryListEvent) => {
    const matches = 'matches' in e ? e.matches : (e as MediaQueryList).matches;
    if (matches) {
      forceMobileNavHidden();
      updateNavModeIndicator('desktop');
    } else {
      updateNavModeIndicator('mobile');
    }
  };
  // Support older and newer APIs
  if (typeof mediaQuery.addEventListener === 'function') {
    mediaQuery.addEventListener('change', mqHandler);
  } else {
    // Legacy browsers: addListener/removeListener
    // Use a loose cast to access legacy methods without strict typing conflicts
    const legacyMql = mediaQuery as unknown as {
      addListener?: (listener: (this: MediaQueryList, ev: MediaQueryListEvent) => void) => void;
      removeListener?: (listener: (this: MediaQueryList, ev: MediaQueryListEvent) => void) => void;
    };
    if (typeof legacyMql.addListener === 'function') {
      const legacyHandler = (ev: MediaQueryListEvent) => mqHandler(ev);
      legacyMql.addListener(legacyHandler);
    }
  }

  // Fallback: on resize, enforce state when entering desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280) {
      forceMobileNavHidden();
      updateNavModeIndicator('desktop');
    } else {
      updateNavModeIndicator('mobile');
    }
  });

  // Initialize mode immediately on first load (no dependency on DOMContentLoaded)
  (async () => {
    try {
      applyMode();
      await resetMobileNavState();
    } catch (err) {
      console.warn('[Header] Initial mode setup failed', err);
    }
  })();
</script>
