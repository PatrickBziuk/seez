---
/**
 * CustomStyles - Injects custom global styles for the site
 * @props None
 * @behavior Adds custom CSS to the document head for global overrides and tweaks, includes font optimization
 * @dependencies None
 * @usedBy Layout.astro, MarkdownLayout.astro, PageLayout.astro
 */
import '@fontsource-variable/inter';
---

<!-- Font Optimization: Preload critical fonts for better performance -->
<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<style is:inline>
  /* Font optimization with font-display: swap for better FID */
  @font-face {
    font-family: 'Inter Variable';
    src: url('/fonts/inter-variable.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-display: swap; /* T30-008: Improves FID by showing fallback font immediately */
    font-style: normal;
  }

  :root {
    --aw-font-sans: 'Inter Variable', sans-serif;
    --aw-font-serif: 'Inter Variable', sans-serif;
    --aw-font-heading: 'Inter Variable', sans-serif;

    --aw-color-primary: rgb(69, 37, 249); /* Gentle lavender accent */
    --aw-color-secondary: rgb(25, 8, 156);
    --aw-color-accent: rgb(171, 144, 255);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(20 20 20);
    --aw-color-text-muted: rgb(60 60 60 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(10 10 10);

    ::selection {
      background-color: lavender;
      color: black;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable', sans-serif;
    --aw-font-serif: 'Inter Variable', sans-serif;
    --aw-font-heading: 'Inter Variable', sans-serif;

    --aw-color-primary: rgb(171, 144, 255);
    --aw-color-secondary: rgb(130, 110, 255);
    --aw-color-accent: rgb(195, 160, 255);

    --aw-color-text-heading: rgb(245, 245, 245);
    --aw-color-text-default: rgb(220, 220, 220);
    --aw-color-text-muted: rgb(160 160 160 / 66%);
    --aw-color-bg-page: rgb(10 10 10);

    ::selection {
      background-color: snow;
      color: black;
    }
  }
</style>
