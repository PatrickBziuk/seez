---
/**
 * MusicIndex (KONZEPT B8/B10): the released EP with player and tracklist, its music
 * videos, all lyrics (merged from the former /lyrics page) and the songs that are
 * still work in progress. Audio and video come from seez.eu itself (no embeds, no cookies).
 */
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import SongRow from '~/components/seez/SongRow.astro';
import FigureStrip from '~/components/seez/FigureStrip.astro';
import AudioPlayer from '~/components/seez/media/AudioPlayer.astro';
import FilmPlayer from '~/components/seez/media/FilmPlayer.astro';
import LyricsIndex from '~/components/seez/LyricsIndex.astro';
import { playableEp } from '~/utils/media';
import { EP, EP_TRACKS, SONG_EXTRAS, SINGLES } from '~/data/songs';
import { getFigure } from '~/data/figures';
import { getSongRecords, pickEntry, isSong } from '~/utils/music';
import { filmsForSong } from '~/utils/videothek';
import { sectionUrl, type Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const records = await getSongRecords();
const bySlug = new Map(records.map((r) => [r.slug, r]));
const epSlugs = new Set(EP_TRACKS.map((t) => t.slug));
const others = records
  .filter((r) => !epSlugs.has(r.slug) && isSong(pickEntry(r, lang)))
  .map((r) => {
    const e = pickEntry(r, lang);
    const ref = getFigure(e.data.figureRef?.id?.replace(/^en\//, ''));
    return {
      slug: r.slug,
      title: e.data.title,
      figures: SONG_EXTRAS[r.slug]?.figures || (ref ? [ref.id] : []),
      lyrics: SONG_EXTRAS[r.slug]?.lyricsId,
      note: SONG_EXTRAS[r.slug]?.note?.[lang],
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title, 'de'));
const texts = records.filter((r) => r[lang] && !isSong(r[lang]!));
const playable = playableEp();
const playIndex = new Map(playable.map((p, i) => [p.track.slug, i]));
const withFilm = playable.filter((p) => p.film?.released);

const released = new Date(EP.released).toLocaleDateString(de ? 'de-DE' : 'en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

const metadata = {
  title: de ? 'Musik & Lyrics' : 'Music & lyrics',
  description: de
    ? `${EP.title}, die EP von Seez, direkt hier anhören: alle Songs, Musikvideos, Figuren und Lyrics. Dazu die Songs, an denen gerade gearbeitet wird.`
    : `Listen to ${EP.title}, the Seez EP, right here: all songs, music videos, figures and lyrics, plus the songs still in progress.`,
};
---

<Layout metadata={metadata}>
  <PageHead
    title={de ? 'Musik' : 'Music'}
    label={de ? 'Veröffentlicht: eine EP · alles andere in Arbeit' : 'Released: one EP · everything else in progress'}
  />

  <section class="sz-container sz-section ep" aria-labelledby="ep-title">
    <div class="ep__head">
      <p class="sz-label">
        EP · {released} · {EP_TRACKS.length} Tracks · {EP.length}
      </p>
      <h2 class="sz-h1 ep__title" id="ep-title">{EP.title}</h2>
      <FigureStrip height={6} class="ep__strip" />
      <p class="sz-lead ep__claim">{EP.claim[lang]}</p>
      <div class="sz-btn-row ep__actions">
        <a class="sz-btn" href={EP.spotify} rel="noopener">{de ? 'Auf Spotify' : 'On Spotify'}</a>
        {withFilm.length > 0 && <a class="sz-btn" href="#videos">{de ? 'Musikvideos' : 'Music videos'}</a>}
        <a class="sz-btn" href="#lyrics">Lyrics</a>
      </div>
    </div>

    {
      playable.length > 0 && (
        <AudioPlayer
          items={playable}
          lang={lang}
          id="ep"
          showList={false}
          label={de ? `EP ${EP.title} anhören` : `Listen to the EP ${EP.title}`}
          class="ep__player"
        />
      )
    }

    <h3 class="sz-label ep__listlabel">{de ? 'Tracklist' : 'Tracklist'}</h3>
    <ol class="sz-songlist">
      {
        EP_TRACKS.map((t) => (
          <SongRow
            lang={lang}
            no={t.no}
            title={t.title}
            href={bySlug.has(t.slug) ? sectionUrl(lang, 'music', t.slug) : undefined}
            figures={t.figures}
            note={t.note?.[lang]}
            length={t.length}
            explicit={t.explicit}
            listen={t.spotify}
            play={playIndex.has(t.slug) ? { player: 'ep', index: playIndex.get(t.slug)! } : undefined}
            videoHref={bySlug.has(t.slug) && filmsForSong(t.filmKey).some((f) => f.released) ? `${sectionUrl(lang, 'music', t.slug)}#video` : undefined}
            lyricsHref={t.lyricsId && bySlug.has(t.slug) ? `${sectionUrl(lang, 'music', t.slug)}#lyrics` : undefined}
            hasVideo={filmsForSong(t.filmKey).length > 0}
          />
        ))
      }
    </ol>
    <p class="sz-muted ep__source">
      {
        de
          ? 'Reihenfolge, Titel und Laufzeiten wie auf Spotify.'
          : 'Order, titles and running times as on Spotify.'
      }{' '}
      {
        SINGLES.map((x) => (
          <>
            {de ? 'Vorab als Single: ' : 'Earlier single: '}
            <a class="sz-link" href={x.spotify} rel="noopener">
              {x.title}
            </a>{' '}
            ({new Date(x.released).toLocaleDateString(de ? 'de-DE' : 'en-GB')}, {x.length}
            {de ? ', längere Fassung' : ', longer version'}).
          </>
        ))
      }
    </p>
  </section>

  {
    withFilm.length > 0 && (
      <section class="sz-container sz-section" id="videos" aria-labelledby="videos-title">
        <div class="sz-section-head">
          <div>
            <p class="sz-label">{de ? `${withFilm.length} Filme · Figuren-Reihe` : `${withFilm.length} films · figure series`}</p>
            <h2 class="sz-h2" id="videos-title">
              {de ? 'Musikvideos' : 'Music videos'}
            </h2>
          </div>
        </div>
        <div class="vids">
          {withFilm.map((p) => (
            <FilmPlayer filmKey={p.track.filmKey} lang={lang} title={p.track.title} withLink={false} />
          ))}
        </div>
      </section>
    )
  }

  <section class="sz-container sz-section" id="lyrics" aria-labelledby="lyrics-title">
    <div class="sz-section-head">
      <div>
        <p class="sz-label">{de ? 'Alle Songtexte' : 'All lyrics'}</p>
        <h2 class="sz-h2" id="lyrics-title">Lyrics</h2>
      </div>
    </div>
    <p class="sz-muted sz-measure">
      {
        de
          ? `Zuerst die EP in Spotify-Reihenfolge, danach die Entwürfe der Songs, an denen gearbeitet wird.`
          : `First the EP in Spotify order, then the drafts of the songs still in progress.`
      }
    </p>
    <LyricsIndex lang={lang} />
  </section>

  {
    others.length > 0 && (
      <section class="sz-container sz-section" aria-labelledby="wip">
        <div class="sz-section-head">
          <div>
            <p class="sz-label">{de ? 'Nicht auf der EP' : 'Not on the EP'}</p>
            <h2 class="sz-h2" id="wip">
              {de ? 'In Arbeit' : 'Work in progress'}
            </h2>
          </div>
        </div>
        <p class="sz-muted sz-measure">
          {de
            ? 'Diese Songs sind noch nicht veröffentlicht. Hier stehen Entwürfe, Notizen und frühe Hörproben.'
            : 'These songs are not released yet. Here you find drafts, notes and early listening samples.'}
        </p>
        <ul class="sz-songlist">
          {others.map((o) => (
            <SongRow
              lang={lang}
              title={o.title}
              href={sectionUrl(lang, 'music', o.slug)}
              figures={o.figures}
              note={o.note}
              status={de ? 'in Arbeit' : 'in progress'}
              lyricsHref={o.lyrics ? `${sectionUrl(lang, 'music', o.slug)}#lyrics` : undefined}
            />
          ))}
        </ul>
      </section>
    )
  }

  <section class="sz-container sz-section" aria-labelledby="more">
    <h2 class="sz-h2" id="more">{de ? 'Mehr zur Musik' : 'More about the music'}</h2>
    <ul class="more">
      {
        texts.map((r) => (
          <li>
            <a class="sz-link" href={sectionUrl(lang, 'music', r.slug)}>
              {pickEntry(r, lang).data.title}
            </a>{' '}
            <span class="sz-muted">– {pickEntry(r, lang).data.subtitle}</span>
          </li>
        ))
      }
      <li>
        <a class="sz-link" href={sectionUrl(lang, 'license')}>{de ? 'Lizenz für Auftritte' : 'Performer license'}</a>
        <span class="sz-muted">
          – {de ? 'Songs von Seez live performen: Sinn fix, Form frei.' : 'Performing Seez songs live: meaning fixed, form free.'}
        </span>
      </li>
      <li>
        <a class="sz-link" href={sectionUrl(lang, 'workshop')}>{de ? 'Werkstatt' : 'Workshop'}</a>
        <span class="sz-muted">– {de ? 'Wie die Songs und Videos entstehen.' : 'How the songs and videos are made.'}</span>
      </li>
    </ul>
  </section>
</Layout>

<style>
  .ep {
    padding-top: 0;
  }
  .ep__head {
    max-width: 880px;
  }
  .ep__title {
    margin-top: var(--sp-2);
  }
  .ep__source {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .ep :global(.ep__strip) {
    margin-top: var(--sp-4);
    max-width: 420px;
  }
  .ep__claim {
    margin-top: var(--sp-5);
  }
  .ep__actions {
    margin-top: var(--sp-5);
  }
  .ep :global(.ep__player) {
    margin-top: var(--sp-6);
    max-width: 880px;
  }
  .vids {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: var(--sp-6) var(--sp-5);
    margin-top: var(--sp-5);
  }
  #lyrics,
  #videos {
    scroll-margin-top: 80px;
  }
  .ep__listlabel {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-2);
  }
  .sz-songlist {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .more {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
</style>
