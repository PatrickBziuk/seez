---
/**
 * ArchivePage - everything that is kept but not part of the five main sections
 * (user decision 10: nothing deleted, only filed). Recommendations are in the relaunch report.
 */
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import { sectionUrl, type Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const groups = [
  {
    title: de ? 'Lesen' : 'Read',
    items: [
      { href: `/${lang}/texte`, title: de ? 'Texte' : 'Texts', text: de ? 'Prolog und Essays aus dem Kosmos.' : 'Prologue and essays from the cosmos.' },
      { href: `/${lang}/blog`, title: de ? 'Chronik' : 'Timeline', text: de ? 'Alle Einträge in zeitlicher Folge.' : 'All entries in order of time.' },
      { href: `/${lang}/tags`, title: 'Tags', text: de ? 'Schlagworte über alle Inhalte.' : 'Keywords across all content.' },
    ],
  },
  {
    title: de ? 'Über Seez' : 'About Seez',
    items: [
      { href: `/${lang}/about`, title: de ? 'Über Seez' : 'About Seez', text: de ? 'Wer hinter Seez steht.' : 'Who is behind Seez.' },
      { href: `/${lang}/authors/seez`, title: 'Seez', text: de ? 'Autorenseite.' : 'Author page.' },
      { href: `/${lang}/authors/echo`, title: 'Echo', text: de ? 'Autorenseite der KI-Mitarbeit.' : 'Author page for the AI collaboration.' },
    ],
  },
  {
    title: de ? 'Kontakt und Presse' : 'Contact and press',
    items: [
      { href: `/${lang}/press`, title: de ? 'Presse' : 'Press', text: de ? 'Material und Kontakt für Presse.' : 'Material and contact for press.' },
      { href: `/${lang}/contact`, title: de ? 'Kontakt' : 'Contact', text: de ? 'Schreib Seez.' : 'Write to Seez.' },
      { href: sectionUrl(lang, 'license'), title: de ? 'Lizenz für Auftritte' : 'Performer license', text: 'Sinn fix, Form frei.' },
    ],
  },
];
const metadata = {
  title: de ? 'Archiv' : 'Archive',
  description: de ? 'Texte, Chronik, Über Seez, Presse und Kontakt.' : 'Texts, timeline, about Seez, press and contact.',
};
---

<Layout metadata={metadata}>
  <PageHead
    title={de ? 'Archiv' : 'Archive'}
    lead={de ? 'Alles, was neben Musik, Fragmenten, Lyrics und Werkstatt zu Seez gehört.' : 'Everything else that belongs to Seez besides music, fragments, lyrics and the workshop.'}
  />
  <div class="sz-container arc">
    {
      groups.map((g) => (
        <section aria-label={g.title}>
          <h2 class="sz-label">{g.title}</h2>
          <ul>
            {g.items.map((i) => (
              <li>
                <a href={i.href}>{i.title}</a>
                <span class="sz-muted">{i.text}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .arc {
    display: grid;
    gap: var(--sp-7);
  }
  .arc ul {
    list-style: none;
    margin: var(--sp-3) 0 0;
    padding: 0;
  }
  .arc li {
    display: grid;
    gap: 2px;
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--line);
  }
  .arc a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }
  .arc a:hover {
    text-decoration: underline;
  }
  @media (min-width: 900px) {
    .arc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
