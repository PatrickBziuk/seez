---
/**
 * FigurePage: a collectible card on top, a wiki entry below (infobox, contents, sections).
 * Every fact comes from figures.json, the dossier (gated content), songs.ts / lyrics.json
 * and the BPM noted in the Videothek catalog. Nothing is estimated or invented: sections
 * without data are left out.
 *
 * Media slots (components from the media branch; placeholders here render nothing):
 *   - TrackPlayer (compact): inside FragmentCard, under the card's move (the EP track)
 *   - FilmPlayer: section "Auftritte" → "Musikvideo" (#musikvideo) below
 * Early sketches (Skizzenbuch 2011–2013, shared motifs): end of "Wissenswertes", see FigureSketches.
 */
import { render, type CollectionEntry } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import FigureGlyph from '~/components/seez/FigureGlyph.astro';
import FigureWorld from '~/components/seez/FigureWorld.astro';
import SongRow from '~/components/seez/SongRow.astro';
import HelpNotice from '~/components/seez/HelpNotice.astro';
import VhsCard from '~/components/seez/VhsCard.astro';
import FragmentCard from '~/components/seez/figure/FragmentCard.astro';
import FigureInfobox from '~/components/seez/figure/FigureInfobox.astro';
import MotionToggle from '~/components/seez/figure/MotionToggle.astro';
import FilmPlayer from '~/components/seez/media/FilmPlayer.astro';
import FigureSketches from '~/components/seez/sketch/FigureSketches.astro';
import { FIGURES, getFigure, figureStyle, type Figure } from '~/data/figures';
import { EP, SONG_EXTRAS } from '~/data/songs';
import { getSongRecords, pickEntry, isSong } from '~/utils/music';
import { filmsForFigure, filmsForSong } from '~/utils/videothek';
import { songFilm } from '~/utils/media';
import { epTrackFor, bpmFor, lyricsFor, singlesFor, dossierSignature } from '~/utils/fragments';
import { sectionUrl, type Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
  figure: Figure;
  entry: CollectionEntry<'fragments'>;
}
const { lang, figure: f, entry } = Astro.props;
const de = lang === 'de';
const { Content, headings } = await render(entry);
const isFallbackLang = (entry.data.language || 'de') !== lang;
const entryLang = isFallbackLang ? entry.data.language : undefined;

/* ---- Music ---- */
const records = await getSongRecords();
const has = (slug: string) => records.some((r) => r.slug === slug);
const track = epTrackFor(f.id);
const bpm = bpmFor(track?.filmKey);
const trackPage = track && has(track.slug) ? sectionUrl(lang, 'music', track.slug) : undefined;
const trackHref = trackPage || track?.spotify;
const otherSongs = records
  .filter((r) => r.slug !== track?.slug)
  .map((r) => ({ r, e: pickEntry(r, lang) }))
  .filter(
    ({ r, e }) =>
      isSong(e) &&
      ((SONG_EXTRAS[r.slug]?.figures || []).includes(f.id) ||
        e.data.figureRef?.id?.replace(/^en\//, '') === entry.id.replace(/^en\//, ''))
  );
const lyrics = lyricsFor(f.id);
const lyricsDrafts = lyrics.filter((l) => !l.ep).length;
const singles = singlesFor(track);
const songFilms = filmsForSong(track?.filmKey);
const mainFilm = songFilm(track?.filmKey);
// Further films of this figure (the EP track's own video is shown by FilmPlayer above them)
const films = filmsForFigure(f.id).filter((x) => x.id !== mainFilm?.id);
const showVideo = songFilms.length > 0 || films.length > 0;

/* Songs in progress shared with other figures (songs.ts SONG_EXTRAS) */
const crossovers = otherSongs
  .map(({ r, e }) => ({
    title: e.data.title,
    href: sectionUrl(lang, 'music', r.slug),
    with: (SONG_EXTRAS[r.slug]?.figures || []).filter((id) => id !== f.id).map((id) => getFigure(id)!),
  }))
  .filter((c) => c.with.length > 0);

/* ---- Dossier ---- */
const signature = dossierSignature(entry);
const symbols = entry.data.symbolism || [];
const dossierHeads = headings.filter((h) => h.depth === 2);
const since = entry.data.firstPublishedAt
  ? new Date(entry.data.firstPublishedAt).toLocaleDateString(de ? 'de-DE' : 'en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'Europe/Berlin',
    })
  : undefined;

/* ---- Lead: composed only from data ---- */
const ORD_DE = ['erste', 'zweite', 'dritte', 'vierte', 'fünfte', 'sechste'];
const ORD_EN = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth'];
const lead = de
  ? `${f.name} (${f.sz}) ist das ${ORD_DE[f.order - 1]} von sechs Fragmenten, Beiname „${f.alias.de}“. Medium: ${f.medium.de}.` +
    (track ? ` Auf der EP ${EP.title} gehört Track ${track.no}, ${track.title}, zu ${f.name}.` : '')
  : `${f.name} (${f.sz}) is the ${ORD_EN[f.order - 1]} of six fragments, also called “${f.alias.en}”. Medium: ${f.medium.en.toLowerCase()}.` +
    (track ? ` On the EP ${EP.title}, track ${track.no}, ${track.title}, belongs to ${f.name}.` : '');

/* ---- Trivia: one line per real data point ---- */
const terminal = 'media' in f ? (f.media as { terminal?: string }).terminal : undefined;
const trivia: string[] = [];
trivia.push(
  de
    ? `Die Farbe von ${f.name} heißt ${f.accent.label.de} (${f.accent.dark}). Auf seez.eu steht Farbe immer für eine Figur.`
    : `${f.name}'s colour is called ${f.accent.label.en} (${f.accent.dark}). On seez.eu, colour always stands for a figure.`
);
if (terminal)
  trivia.push(
    de
      ? `Terminal-Grün (${terminal}) erscheint nur in ${f.name}s eigenem Medium ${f.medium.de}, nie als Farbe der Website.`
      : `Terminal green (${terminal}) only appears inside ${f.name}'s own medium, ${f.medium.en}, never as a site colour.`
  );
if (track && bpm) trivia.push(de ? `${track.title} läuft mit ${bpm} BPM.` : `${track.title} runs at ${bpm} BPM.`);
if (track?.explicit)
  trivia.push(
    de ? `${track.title} ist auf Spotify als explizit markiert.` : `${track.title} is marked explicit on Spotify.`
  );
for (const s of singles) {
  const d = new Date(s.released).toLocaleDateString(de ? 'de-DE' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
  trivia.push(
    de
      ? `${track!.title} erschien schon am ${d} als Single, in einer längeren Fassung (${s.length} statt ${track!.length}).`
      : `${track!.title} came out earlier as a single on ${d}, in a longer version (${s.length} instead of ${track!.length}).`
  );
}
for (const c of crossovers)
  trivia.push(
    de
      ? `${c.title} (in Arbeit) teilt sich ${f.name} mit ${c.with.map((o) => o.name).join(' und ')}.`
      : `${f.name} shares ${c.title} (in progress) with ${c.with.map((o) => o.name).join(' and ')}.`
  );
if (lyrics.length > 0)
  trivia.push(
    de
      ? `Im Songtext-Archiv liegen ${lyrics.length} Texte zu ${f.name}${lyricsDrafts > 0 ? `, ${lyricsDrafts} davon sind Entwürfe für Songs in Arbeit` : ''}.`
      : `The lyrics archive holds ${lyrics.length} texts for ${f.name}${lyricsDrafts > 0 ? `, ${lyricsDrafts} of them drafts for songs in progress` : ''}.`
  );
if (since)
  trivia.push(de ? `Das Dossier ist seit dem ${since} online.` : `The dossier has been online since ${since}.`);

const q = (s: string) => (de ? `„${s}“` : `“${s}”`);
const others = FIGURES.filter((o) => o.id !== f.id);

const toc: { id: string; text: string; sub?: { id: string; text: string }[] }[] = [
  { id: 'erscheinung', text: de ? 'Erscheinung' : 'Appearance' },
  { id: 'medium', text: 'Medium' },
  { id: 'dossier', text: 'Dossier', sub: dossierHeads.map((h) => ({ id: h.slug, text: h.text })) },
  { id: 'auftritte', text: de ? 'Auftritte' : 'Appearances' },
  { id: 'zitate', text: de ? 'Zitate' : 'Quotes' },
  { id: 'wissenswertes', text: de ? 'Wissenswertes' : 'Trivia' },
  { id: 'andere', text: de ? 'Die anderen Splitter' : 'The other splinters' },
];

const metadata = {
  title: `${f.sz} · ${f.name} – ${de ? 'Fragmente' : 'Fragments'}`,
  description: `${f.name}, ${f.alias[lang]}. ${f.quote[lang]}`,
  canonical: new URL(sectionUrl(lang, 'fragments', f.id), 'https://seez.eu').toString(),
};
---

<Layout metadata={metadata} mainStyle={figureStyle(f)} mainClass={`fig fig--${f.id}`}>
  <!-- ======================= Card ======================= -->
  <section class="fhero" aria-labelledby="fig-name">
    <div class="sz-container fhero__grid">
      <nav class="sz-crumbs fhero__crumbs" aria-label="Breadcrumb">
        <a href={sectionUrl(lang, 'fragments')}>{de ? 'Fragmente' : 'Fragments'}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{f.sz} · {f.name}</span>
      </nav>

      <header class="fhero__head">
        <p class="fhero__label">
          <FigureGlyph id={f.id} size={20} />
          <span class="sz-label">{f.sz} · Fragment {f.order}/{FIGURES.length} · {f.medium[lang]}</span>
        </p>
        <h1 class="sz-display fhero__name" id="fig-name">{f.name}</h1>
        <p class="fhero__alias">{f.alias[lang]}</p>
      </header>

      <div class="fhero__card">
        <FragmentCard figure={f} lang={lang} variant="hero" eager />
      </div>

      <div class="fhero__body">
        <p class="sz-lead fhero__lead">{lead}</p>
        <div class="sz-btn-row fhero__actions">
          {
            track && trackHref && (
              <a class="sz-btn sz-btn--primary" href={trackHref} rel={trackPage ? undefined : 'noopener'}>
                ▶ {track.title}
                {!trackPage && <span class="fhero__ext">{de ? 'auf Spotify' : 'on Spotify'}</span>}
              </a>
            )
          }
          <a class="sz-btn" href="#dossier">Dossier ↓</a>
          <a class="sz-btn" href="#auftritte">{de ? 'Auftritte' : 'Appearances'} ↓</a>
        </div>
        <MotionToggle lang={lang} class="fhero__motion" />
      </div>
    </div>
  </section>

  <!-- ======================= Wiki ======================= -->
  <div class="sz-container wiki">
    <div class="wiki__side" data-wiki-side>
      <FigureInfobox
        figure={f}
        lang={lang}
        entry={entry}
        track={track}
        trackHref={trackHref}
        bpm={bpm}
        singles={singles}
        songsInProgress={otherSongs.length}
        lyricsCount={lyrics.length}
        lyricsDrafts={lyricsDrafts}
      />
    </div>

    <article class="wiki__main" aria-labelledby="fig-name">
      <nav class="wiki-toc" aria-labelledby="toc-h">
        <h2 class="wiki-toc__h" id="toc-h">{de ? 'Inhalt' : 'Contents'}</h2>
        <ol>
          {
            toc.map((t, i) => (
              <li>
                <a href={`#${t.id}`}>
                  <span class="wiki-toc__no">{i + 1}</span> {t.text}
                </a>
                {t.sub && t.sub.length > 0 && (
                  <ol lang={entryLang}>
                    {t.sub.map((s, j) => (
                      <li>
                        <a href={`#${s.id}`}>
                          <span class="wiki-toc__no">
                            {i + 1}.{j + 1}
                          </span>{' '}
                          {s.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <!-- Appearance -->
      <section class="wiki-sec" aria-labelledby="erscheinung">
        <h2 class="wiki-h2" id="erscheinung"><span class="wiki-h2__no">1</span>{de ? 'Erscheinung' : 'Appearance'}</h2>
        <p class="wiki-p">
          <span class="sz-label">{de ? 'Figurenblatt' : 'Character sheet'}</span><br />
          {f.portrait.alt[lang]}.
        </p>
        {
          symbols.length > 0 && (
            <>
              <h3 class="wiki-h3">{de ? 'Symbole' : 'Symbols'}</h3>
              <ul class="wiki-symbols" lang={entryLang}>
                {symbols.map((s) => {
                  const [name, ...rest] = s.meaning.split(/\s+[—–-]\s+/);
                  return (
                    <li>
                      <FigureGlyph id={f.id} size={18} />
                      <strong>{name}</strong>
                      {rest.length > 0 && <span>{rest.join(' – ')}</span>}
                    </li>
                  );
                })}
              </ul>
            </>
          )
        }
      </section>

      <!-- Medium -->
      <section class="wiki-sec" aria-labelledby="medium">
        <h2 class="wiki-h2" id="medium"><span class="wiki-h2__no">2</span>Medium</h2>
        <p class="wiki-p">
          {
            de
              ? `Jede Figur hat ein eigenes Medium. Bei ${f.name}: ${f.medium.de}. So sieht das Zitat dort aus:`
              : `Each figure has its own medium. For ${f.name}: ${f.medium.en.toLowerCase()}. This is the quote as it appears there:`
          }
        </p>
        <div class="wiki-world">
          <FigureWorld figure={f} lang={lang} />
        </div>
      </section>

      <!-- Dossier -->
      <section class="wiki-sec" aria-labelledby="dossier">
        <h2 class="wiki-h2" id="dossier"><span class="wiki-h2__no">3</span>Dossier</h2>
        <p class="wiki-note">
          {de ? `In eigenen Worten: ${f.name} erzählt selbst.` : `In ${f.name}'s own words.`}
          {
            isFallbackLang &&
              (de ? ' Dieses Dossier liegt nur auf Englisch vor.' : ' This dossier is only available in German.')
          }
        </p>
        <div class="sz-prose wiki-dossier" lang={entryLang}>
          <Content />
        </div>
        {
          f.id === 'drift' && (
            <div class="wiki-help">
              <HelpNotice lang={lang} />
            </div>
          )
        }
      </section>

      <!-- Appearances -->
      <section class="wiki-sec" aria-labelledby="auftritte">
        <h2 class="wiki-h2" id="auftritte"><span class="wiki-h2__no">4</span>{de ? 'Auftritte' : 'Appearances'}</h2>

        {
          track && (
            <>
              <h3 class="wiki-h3">{de ? `Auf der EP ${EP.title}` : `On the EP ${EP.title}`}</h3>
              <ul class="wiki-songs">
                <SongRow
                  lang={lang}
                  title={track.title}
                  href={trackPage}
                  figures={track.figures}
                  note={track.note?.[lang]}
                  status={`EP · Track ${track.no}`}
                  length={track.length}
                  explicit={track.explicit}
                  listen={track.spotify}
                  lyricsHref={trackPage && track.lyricsId ? `${trackPage}#lyrics` : undefined}
                />
              </ul>
            </>
          )
        }

        {
          otherSongs.length > 0 && (
            <>
              <h3 class="wiki-h3">{de ? 'In Arbeit' : 'In progress'}</h3>
              <ul class="wiki-songs">
                {otherSongs.map(({ r, e }) => (
                  <SongRow
                    lang={lang}
                    title={e.data.title}
                    href={sectionUrl(lang, 'music', r.slug)}
                    figures={SONG_EXTRAS[r.slug]?.figures || [f.id]}
                    status={de ? 'in Arbeit' : 'in progress'}
                  />
                ))}
              </ul>
            </>
          )
        }

        {
          showVideo && track?.filmKey && (
            <>
              <h3 class="wiki-h3" id="musikvideo">
                {de ? 'Musikvideo' : 'Music video'}
              </h3>
              {/* ===== SLOT: FilmPlayer – the released video of the figure's EP track, renders nothing until one is released ===== */}
              <div class="wiki-film">
                <FilmPlayer filmKey={track.filmKey} lang={lang} title={track.title} />
              </div>
              {films.length > 0 && (
                <ul class="wiki-films">
                  {films.map((film) => (
                    <li>
                      <VhsCard film={film} lang={lang} />
                    </li>
                  ))}
                </ul>
              )}
            </>
          )
        }

        {
          lyrics.length > 0 && (
            <>
              <h3 class="wiki-h3">{de ? 'Songtexte' : 'Lyrics'}</h3>
              <ul class="wiki-lyrics" lang="de">
                {lyrics.map(({ lyrics: l, ep }) => (
                  <li>
                    <span class="wiki-lyrics__title">{l.title}</span>
                    <span class="sz-label" lang={lang}>
                      {ep ? `EP · Track ${ep.no}` : de ? 'Entwurf · in Arbeit' : 'Draft · in progress'}
                    </span>
                  </li>
                ))}
              </ul>
              <p class="wiki-more">
                <a class="sz-link" href={sectionUrl(lang, 'lyrics')}>
                  {de ? 'Alle Songtexte' : 'All lyrics'} →
                </a>
                {!de && <span class="sz-muted"> (German)</span>}
              </p>
            </>
          )
        }
      </section>

      <!-- Quotes -->
      <section class="wiki-sec" aria-labelledby="zitate">
        <h2 class="wiki-h2" id="zitate"><span class="wiki-h2__no">5</span>{de ? 'Zitate' : 'Quotes'}</h2>
        <div class="wiki-quotes">
          <figure>
            <blockquote>{q(f.quote[lang])}</blockquote>
            <figcaption>– {f.name}</figcaption>
          </figure>
          {
            signature && (
              <figure lang={entryLang}>
                <blockquote>{q(signature)}</blockquote>
                <figcaption>– {f.name}, Dossier</figcaption>
              </figure>
            )
          }
          {
            track?.quote && (
              <figure>
                <blockquote lang="de">{de ? `„${track.quote}“` : `“${track.quote}”`}</blockquote>
                <figcaption>
                  – {track.title}, {de ? 'EP-Track' : 'EP track'} {track.no}
                  {!de && ' (German lyrics)'}
                </figcaption>
              </figure>
            )
          }
        </div>
      </section>

      <!-- Trivia -->
      <section class="wiki-sec" aria-labelledby="wissenswertes">
        <h2 class="wiki-h2" id="wissenswertes"><span class="wiki-h2__no">6</span>{de ? 'Wissenswertes' : 'Trivia'}</h2>
        <ul class="wiki-trivia">
          {trivia.map((t) => <li>{t}</li>)}
        </ul>
        <FigureSketches figure={f.id} lang={lang} />
      </section>
    </article>
  </div>

  <script>
    /*
     * Infobox taller than the window: let it scroll with the page until its end is visible,
     * then stick there (top = window height - box height). Shorter boxes stick below the header.
     */
    const side = document.querySelector<HTMLElement>('[data-wiki-side]');
    if (side) {
      const header = 64 + 24;
      const fit = () => {
        const h = side.offsetHeight;
        const room = window.innerHeight - header - 24;
        side.style.setProperty('--side-top', `${h > room ? window.innerHeight - h - 24 : header}px`);
      };
      fit();
      window.addEventListener('resize', fit, { passive: true });
      if ('ResizeObserver' in window) new ResizeObserver(fit).observe(side);
    }
  </script>

  <!-- ======================= The other five ======================= -->
  <section class="sz-container sz-section wiki-others" aria-labelledby="andere">
    <h2 class="wiki-h2" id="andere">
      <span class="wiki-h2__no">7</span>{de ? 'Die anderen Splitter' : 'The other splinters'}
    </h2>
    <ul class="wiki-others__deck" data-deal>
      {
        others.map((o, i) => (
          <li>
            <FragmentCard
              figure={o}
              lang={lang}
              variant="deck"
              href={sectionUrl(lang, 'fragments', o.id)}
              nameTag="h3"
              index={i}
            />
          </li>
        ))
      }
    </ul>
    <script is:inline>
      (function () {
        const l = document.currentScript && document.currentScript.previousElementSibling;
        if (l && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) l.classList.add('will-deal');
      })();
    </script>
  </section>
</Layout>

<style>
  /* ---------- Hero: card + title ---------- */
  .fhero {
    position: relative;
    overflow-x: clip;
    padding-block: var(--sp-6) var(--sp-8);
    background:
      radial-gradient(ellipse 60% 70% at 22% 45%, var(--fig-glow), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--fig-ground) 80%, var(--bg)), var(--bg));
    border-bottom: 1px solid var(--line);
  }
  .fhero__grid {
    display: grid;
    grid-template-areas: 'crumbs' 'head' 'card' 'body';
    gap: var(--sp-5);
  }
  .fhero__crumbs {
    grid-area: crumbs;
  }
  .fhero__head {
    grid-area: head;
  }
  .fhero__card {
    grid-area: card;
    width: 100%;
    max-width: 340px;
    justify-self: center;
  }
  .fhero__body {
    grid-area: body;
  }
  .fhero__label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fig);
  }
  .fhero__name {
    text-transform: none;
    color: var(--fig);
    margin-top: var(--sp-2);
  }
  .fhero__alias {
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin-top: var(--sp-2);
  }
  .fhero__lead {
    max-width: 46ch;
  }
  .fhero__actions {
    margin-top: var(--sp-5);
  }
  .fhero__ext {
    font-weight: 400;
    font-size: var(--fs-xs);
  }
  .fhero :global(.fhero__motion) {
    margin-top: var(--sp-4);
  }
  @media (min-width: 900px) {
    .fhero {
      padding-block: var(--sp-6) var(--sp-9);
    }
    .fhero__grid {
      grid-template-columns: minmax(300px, 400px) 1fr;
      grid-template-areas: 'crumbs crumbs' 'card head' 'card body';
      grid-template-rows: auto auto 1fr;
      column-gap: var(--sp-8);
      row-gap: var(--sp-4);
    }
    .fhero__card {
      max-width: none;
      align-self: start;
      margin-top: var(--sp-4);
    }
    .fhero__head {
      align-self: end;
      padding-top: var(--sp-8);
    }
  }

  /* ---------- Wiki layout: article + sticky infobox ---------- */
  .wiki {
    display: grid;
    grid-template-areas: 'side' 'main';
    gap: var(--sp-7);
    padding-block: var(--sp-7) var(--sp-6);
  }
  .wiki__side {
    grid-area: side;
    min-width: 0;
  }
  .wiki__main {
    grid-area: main;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .wiki {
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-areas: 'main side';
      column-gap: var(--sp-8);
    }
    .wiki__side {
      align-self: start;
      position: sticky;
      top: var(--side-top, calc(64px + var(--sp-5)));
    }
  }

  /* Contents box */
  .wiki-toc {
    display: inline-block;
    min-width: min(100%, 320px);
    max-width: 100%;
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--fig);
  }
  .wiki-toc__h {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--sp-2);
  }
  .wiki-toc ol {
