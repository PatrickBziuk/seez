---
/**
 * Zeitstrahl / Timeline (/de/zeitstrahl, /en/timeline): facts only, from src/data/timeline.ts.
 * Motion: the line fills with the scroll position (scroll-driven animation where supported,
 * otherwise it is simply drawn), entries reveal along it (.reveal), dots pop in.
 * All of it off with prefers-reduced-motion. Thumbnails are small and lazy (WebP).
 * Below: "Einflüsse", the compass drawing whose ring lists music influences.
 */
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import PageHead from '~/components/seez/PageHead.astro';
import FigureStrip from '~/components/seez/FigureStrip.astro';
import SketchInk from '~/components/seez/sketch/SketchInk.astro';
import { TIMELINE, INFLUENCES } from '~/data/timeline';
import { FIGURES } from '~/data/figures';
import { showVideothek } from '~/utils/videothek';
import type { Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const entries = TIMELINE.filter((e) => e.id !== 'videos' || showVideothek());
// The line fills in the six figure accents, in SZ order (like the Splitterleiste)
const fillGradient = `linear-gradient(180deg, ${FIGURES.map((f) => f.accent.dark).join(', ')})`;
const hrefOf = (h: { de: string; en: string } | string) => (typeof h === 'string' ? h : h[lang]);

const metadata = {
  title: de ? 'Zeitstrahl' : 'Timeline',
  description: de
    ? 'Von den ersten Speedarts und dem Skizzenbuch 2011–2013 bis zur EP GENERIERUNG LÄUFT: die Geschichte von Seez in Daten.'
    : 'From the first speedarts and the 2011–2013 sketchbook to the EP GENERIERUNG LÄUFT: the story of Seez in dates.',
};
---

<Layout metadata={metadata}>
  <PageHead
    title={de ? 'Zeitstrahl' : 'Timeline'}
    label={de ? 'Seez · von Anfang an' : 'Seez · from the start'}
    lead={de
      ? 'Was belegt ist, steht mit Datum. Was kein Datum hat, steht ohne.'
      : 'What is on record has a date. What has no date stays without one.'}
  >
    <FigureStrip height={6} class="tl__strip" motion="boot" />
  </PageHead>

  <section class="sz-container sz-section tl" aria-label={de ? 'Zeitstrahl' : 'Timeline'}>
    <div class="tl__wrap">
      <span class="tl__line" aria-hidden="true"
        ><span class="tl__fill" style={`background:${fillGradient}`}></span></span
      >
      <ol class="tl__list">
        {
          entries.map((e) => (
            <li class="tl__item reveal" id={e.id}>
              <span class="tl__dot" aria-hidden="true" />
              <p class="tl__when sz-mono">{e.date ? <time datetime={e.date}>{e.when[lang]}</time> : e.when[lang]}</p>
              <h2 class="tl__title">{e.title[lang]}</h2>
              <p class="tl__text">{e.text[lang]}</p>
              {e.thumbs && (
                <ul class="tl__thumbs">
                  {e.thumbs.map((t) => (
                    <li>
                      <Image
                        src={t.image}
                        alt={t.alt[lang]}
                        widths={[240, 480]}
                        sizes="240px"
                        format="webp"
                        quality={72}
                        loading="lazy"
                        decoding="async"
                      />
                    </li>
                  ))}
                </ul>
              )}
              {e.marks && (
                <ul class="tl__marks">
                  {e.marks.map((m) => (
                    <li>
                      <SketchInk ink={m.ink} label={m.alt[lang]} colour="var(--text)" />
                    </li>
                  ))}
                </ul>
              )}
              {e.link && (
                <p class="tl__link">
                  <a class="sz-link" href={hrefOf(e.link.href)} rel={e.link.external ? 'noopener' : undefined}>
                    {e.link.text[lang]}
                    {e.link.external ? ' ↗' : ' →'}
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sz-container sz-section influences" aria-labelledby="einfluesse">
    <figure class="influences__fig reveal">
      <div class="influences__img">
        <Image
          src={INFLUENCES.image}
          alt={INFLUENCES.alt[lang]}
          widths={[360, 720]}
          sizes="(min-width: 900px) 360px, calc(100vw - 32px)"
          format="webp"
          quality={76}
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="influences__text">
        <p class="sz-label">{de ? 'Bleistift, ohne Datum' : 'Pencil, undated'}</p>
        <h2 class="sz-h2" id="einfluesse">{de ? 'Einflüsse' : 'Influences'}</h2>
        <p class="sz-muted">
          {
            de
              ? 'Ein Kompass mit Uhrzeigern. Auf dem Ring stehen diese Namen, so wie sie gezeichnet sind:'
              : 'A compass with clock hands. The ring carries these names, as drawn:'
          }
        </p>
        <ul class="influences__names reveal-stagger">
          {INFLUENCES.names.map((n) => <li>{n}</li>)}
        </ul>
      </figcaption>
    </figure>
  </section>
</Layout>

<style>
  :global(.tl__strip) {
    margin-top: var(--sp-5);
    max-width: 420px;
  }
  .tl__wrap {
    position: relative;
    padding-left: var(--sp-6);
    max-width: 820px;
  }
  .tl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-7);
  }
  /* The line: a faint track, filled with the reading position where scroll timelines exist */
  .tl__line {
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .tl__fill {
    position: absolute;
    inset: 0;
    transform-origin: top center;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tl__fill {
        animation: tl-fill linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
      }
    }
  }
  @keyframes tl-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .tl__item {
    position: relative;
    min-width: 0;
  }
  .tl__dot {
    position: absolute;
    left: calc(-1 * var(--sp-6) + 1px);
    top: 4px;
    width: 14px;
    height: 14px;
    background: var(--bg);
    border: 2px solid var(--text);
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tl__item.is-in .tl__dot {
      animation: tl-dot var(--motion-slow) var(--ease-stamp) both;
      animation-delay: 120ms;
    }
  }
  @keyframes tl-dot {
    from {
      transform: rotate(45deg) scale(0);
    }
  }
  .tl__when {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tl__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    line-height: 1.1;
    margin-top: var(--sp-2);
  }
  .tl__text {
    margin-top: var(--sp-3);
    max-width: var(--measure);
  }
  .tl__link {
    margin-top: var(--sp-3);
  }
  .tl__thumbs,
  .tl__marks {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    max-width: 640px;
  }
  .tl__thumbs :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .tl__marks li {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: var(--sp-3);
    border: 1px solid var(--line);
  }
  .tl__marks :global(.sz-ink) {
    width: 100%;
    height: 100%;
  }

  .influences__fig {
    margin: 0;
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }
  .influences__img {
    max-width: 360px;
    border: 1px solid var(--line);
  }
  .influences__img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .influences__text .sz-h2 {
    margin-top: var(--sp-2);
  }
  .influences__text .sz-muted {
    margin-top: var(--sp-3);
    max-width: var(--measure);
  }
  .influences__names {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .influences__names li {
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    font-size: var(--fs-sm);
  }
  @media (min-width: 900px) {
    .influences__fig {
      grid-template-columns: 360px minmax(0, 1fr);
    }
  }
</style>
