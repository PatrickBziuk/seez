---
/**
 * SongPage (KONZEPT B10): the song as the node — listen, lyrics, video(s), figure(s), workshop.
 * Content comes through the publication gate; films only when released (or in draft preview).
 */
import { render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import FigureChip from '~/components/seez/FigureChip.astro';
import FigureStrip from '~/components/seez/FigureStrip.astro';
import FigureCard from '~/components/seez/FigureCard.astro';
import LyricsBlock from '~/components/seez/LyricsBlock.astro';
import Notice from '~/components/seez/Notice.astro';
import SongRow from '~/components/seez/SongRow.astro';
import HelpNotice from '~/components/seez/HelpNotice.astro';
import { EP, EP_TRACKS, SONG_EXTRAS, epTrack, getLyrics } from '~/data/songs';
import { getFigure, figureStyle, type FigureId } from '~/data/figures';
import { pickEntry, isSong, type SongRecord } from '~/utils/music';
import { filmsForSong } from '~/utils/videothek';
import { sectionUrl, type Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
  record: SongRecord;
  all: SongRecord[];
}
const { lang, record, all } = Astro.props;
const de = lang === 'de';
const entry = pickEntry(record, lang);
const { Content } = await render(entry);
const isFallbackLang = (entry.data.language || 'de') !== lang;
const track = epTrack(record.slug);
const extra = SONG_EXTRAS[record.slug];
const figureFromRef = entry.data.figureRef?.id?.replace(/^en\//, '');
const figures: FigureId[] =
  track?.figures || extra?.figures || (getFigure(figureFromRef) ? [getFigure(figureFromRef)!.id] : []);
const main = getFigure(figures[0]);
const lyrics = getLyrics(track?.lyricsId || extra?.lyricsId);
const quote = track?.quote || extra?.quote;
const films = filmsForSong(track?.filmKey);
const song = isSong(entry);
const audio = (entry.data as { audioUrl?: string }).audioUrl;
const title = entry.data.title;

const related = EP_TRACKS.filter((t) => t.slug !== record.slug && t.figures.some((f) => figures.includes(f)));
const exists = (slug: string) => all.some((r) => r.slug === slug);

const metadata = {
  title: `${title} – ${de ? 'Musik' : 'Music'}`,
  description: entry.data.subtitle || entry.data.description || track?.note?.[lang],
  canonical: new URL(sectionUrl(lang, 'music', record.slug), 'https://seez.eu').toString(),
};
---

<Layout metadata={metadata} mainStyle={figureStyle(main)}>
  <article class="song" lang={isFallbackLang ? entry.data.language : undefined}>
    <div class="sz-container song__head">
      <nav class="sz-crumbs" aria-label="Breadcrumb" lang={lang}>
        <a href={sectionUrl(lang, 'music')}>{de ? 'Musik' : 'Music'}</a>
        <span aria-hidden="true"> / </span>
        {
          track ? (
            <a href={`${sectionUrl(lang, 'music')}#ep-title`}>{EP.title}</a>
          ) : (
            <span>{song ? (de ? 'In Arbeit' : 'Work in progress') : de ? 'Archiv' : 'Archive'}</span>
          )
        }
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class:list={['song__hero', { 'song__hero--text': !films[0] && !main }]}>
        {
          (films[0] || main) && (
            <div class="song__visual">
              {films[0] ? (
                <img src={films[0].media.poster} alt="" loading="eager" />
              ) : (
                <img
                  src={main!.portrait.src}
                  alt={main!.portrait.alt[lang]}
                  width={main!.portrait.width}
                  height={main!.portrait.height}
                  loading="eager"
                />
              )}
            </div>
          )
        }
        <div class="song__intro" lang={lang}>
          <p class="sz-label">
            {
              track
                ? `EP · ${EP.title} · Track ${track.no} · ${track.length}`
                : song
                  ? de
                    ? 'Song · in Arbeit, nicht auf der EP'
                    : 'Song · work in progress, not on the EP'
                  : de
                    ? 'Text'
                    : 'Text'
            }
          </p>
          <h1 class="sz-display song__title">
            {title}
            {
              track?.explicit && (
                <abbr class="song__e" title={de ? 'Explizit' : 'Explicit'}>
                  E
                </abbr>
              )
            }
          </h1>
          {
            entry.data.subtitle && (
              <p class="sz-lead song__sub" lang={isFallbackLang ? entry.data.language : undefined}>
                {entry.data.subtitle}
              </p>
            )
          }
          {
            figures.length > 0 && (
              <div class="song__figs">
                {figures.map((f) => (
                  <FigureChip figure={f} lang={lang} />
                ))}
              </div>
            )
          }
          {figures.length > 1 && <FigureStrip highlight={figures} height={4} class="song__strip" />}
          <div class="sz-btn-row song__actions">
            {
              track && (
                <a class="sz-btn sz-btn--primary" href={track.spotify} rel="noopener">
                  {de ? 'Auf Spotify hören' : 'Listen on Spotify'}
                </a>
              )
            }
            {
              films.length > 0 && (
                <a class="sz-btn" href="#video">
                  ▶ Video
                </a>
              )
            }
            {
              lyrics && (
                <a class="sz-btn" href="#lyrics">
                  Lyrics ↓
                </a>
              )
            }
          </div>
          {
            audio && (
              <div class="song__audio">
                <p class="sz-label">{de ? 'Hörprobe' : 'Listen here'}</p>
                <audio controls preload="none" src={audio}>
                  <a href={audio}>{de ? 'Audiodatei' : 'Audio file'}</a>
                </audio>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <section class="sz-section sz-container" aria-labelledby="about">
      <h2 class="sz-label" id="about" lang={lang}>
        {song ? (de ? 'Worum es geht' : 'What it is about') : de ? 'Text' : 'Text'}
      </h2>
      {
        isFallbackLang && (
          <p class="sz-muted song__langnote" lang={lang}>
            {de ? 'Dieser Text liegt nur auf Englisch vor.' : 'This text is only available in German.'}
          </p>
        )
      }
      {
        quote && (
          <blockquote class="song__quote" lang="de">
            „{quote}“
          </blockquote>
        )
      }
      <div class="sz-prose song__body">
        <Content />
      </div>
      {
        track?.help && (
          <div class="song__help" lang={lang}>
            <HelpNotice lang={lang} />
          </div>
        )
      }
    </section>

    {
      films.length > 0 && (
        <section class="sz-section sz-container" id="video" aria-labelledby="video-h" lang={lang}>
          <h2 class="sz-h2" id="video-h">
            Video
          </h2>
          <div class="song__films">
            {films.map((f) => (
              <figure class="song__film">
                <video controls preload="none" poster={f.media.poster} src={f.media.full} />
                <figcaption>
                  <strong>{f.title}</strong> · {f.subtitle} · {f.length}
                  <br />
                  <span class="sz-muted">
                    {de
                      ? 'Musik und Figurenbilder KI-gestützt · Apps und Marken im Bild sind erfunden'
                      : 'Music and figure art AI-assisted · apps and brands shown are fictional'}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      lyrics && (
        <section class="sz-section sz-container" id="lyrics" aria-labelledby="lyrics-h">
          <h2 class="sz-h2" id="lyrics-h" lang={lang}>
            Lyrics
          </h2>
          <div lang="de">
            <LyricsBlock text={lyrics.text} />
          </div>
        </section>
      )
    }

    {
      (related.length > 0 || main) && (
        <section class="sz-section sz-container" aria-labelledby="cosmos" lang={lang}>
          <h2 class="sz-h2" id="cosmos">
            {de ? 'Figur und weitere Songs' : 'Figure and more songs'}
          </h2>
          <div class="song__cosmos">
            <div class="song__cosmos-figs">
              {figures.map((f) => (
                <FigureCard figure={f} lang={lang} showQuote={false} />
              ))}
            </div>
            {related.length > 0 && (
              <ul class="song__related">
                {related.map((t) => (
                  <SongRow
                    lang={lang}
                    title={t.title}
                    href={exists(t.slug) ? sectionUrl(lang, 'music', t.slug) : undefined}
                    figures={t.figures}
                    note={t.note?.[lang]}
                    no={t.no}
                    length={t.length}
                  />
                ))}
              </ul>
            )}
          </div>
        </section>
      )
    }

    {
      !track && song && (
        <div class="sz-container" lang={lang}>
          <Notice title={de ? 'Stand' : 'Status'}>
            {de
              ? 'Dieser Song ist in Arbeit und nicht Teil der EP GENERIERUNG LÄUFT.'
              : 'This song is a work in progress and not part of the EP GENERIERUNG LÄUFT.'}
          </Notice>
        </div>
      )
    }
  </article>
</Layout>

<style>
  .song__head {
    padding-top: var(--sp-6);
  }
  .song__hero {
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
  }
  .song__visual {
    background: var(--fig-ground, var(--surface));
    border: 1px solid var(--line);
    border-top: 4px solid var(--fig, var(--line-strong));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    max-width: 420px;
  }
  .song__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .song__title {
    margin-top: var(--sp-3);
  }
  .song__e {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.15em;
    border-radius: 2px;
    background: var(--text-muted);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.32em;
    vertical-align: middle;
    text-decoration: none;
  }
  .song__sub {
    margin-top: var(--sp-4);
    color: var(--text-muted);
  }
  .song__figs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }
  .song__figs + :global(.song__strip) {
    margin-top: var(--sp-3);
    max-width: 240px;
  }
  .song__actions {
    margin-top: var(--sp-6);
  }
  .song__audio {
    margin-top: var(--sp-5);
  }
  .song__audio audio {
    width: 100%;
    max-width: 420px;
    margin-top: var(--sp-2);
  }
  .song__langnote {
    margin-top: var(--sp-2);
  }
  .song__quote {
    margin-top: var(--sp-5);
    border-left: 4px solid var(--fig, var(--line-strong));
    padding-left: var(--sp-4);
    font-size: var(--fs-md);
    max-width: var(--measure);
  }
  .song__body {
    margin-top: var(--sp-4);
  }
  .song__help {
    margin-top: var(--sp-6);
  }
  .song__films {
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
  }
  .song__film video {
    width: 100%;
    background: #000;
    border: 1px solid var(--line);
  }
  .song__film figcaption {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
  }
  .song__cosmos {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* keep long song titles from widening the page at 390px */
    gap: var(--sp-6);
    margin-top: var(--sp-5);
  }
  .song__cosmos-figs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--sp-4);
    max-width: 720px;
  }
  .song__related {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 900px) {
    .song__hero {
      grid-template-columns: minmax(260px, 380px) 1fr;
      align-items: end;
    }
    .song__hero--text {
      grid-template-columns: 1fr;
    }
  }
</style>
