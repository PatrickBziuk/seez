---
/**
 * Music video of a song from seez.eu itself (released, sha256-pinned films only).
 * preload="none": the poster is shown, the film loads only after "play".
 * Controls: SzPlayer (own player bar, native controls without JS).
 * Renders nothing when the song has no released film.
 */
import { songFilm } from '~/utils/media';
import { characterAccent } from '~/utils/videothek';
import SzPlayer from './SzPlayer.astro';

export interface Props {
  filmKey: string | undefined;
  lang: 'de' | 'en';
  title?: string;
  /** Show the link to the Videothek under the film */
  withLink?: boolean;
  class?: string;
}

const { filmKey, lang, title, withLink = true, class: className = '' } = Astro.props;
const de = lang === 'de';
const film = songFilm(filmKey);
const accent = film ? characterAccent(film.characters[0]) : undefined;
const videothek = `/${lang}/videothek`;
---

{
  film && film.released && (
    <figure class:list={['sz-film', className]} style={`--film-accent:${accent}`}>
      <div class="sz-film__frame">
        <SzPlayer
          src={film.media.full}
          poster={film.media.poster}
          label={de ? `Musikvideo: ${title || film.title}` : `Music video: ${title || film.title}`}
          lang={lang}
          length={film.length}
          accent={accent}
        />
      </div>
      <figcaption class="sz-film__cap">
        <span class="sz-film__kicker">{de ? 'Musikvideo' : 'Music video'}</span>
        <span class="sz-film__title">{title || film.title}</span>
        <span class="sz-film__meta">
          {film.length}
          {film.subtitle ? ` · ${film.subtitle}` : ''}
        </span>
        {withLink && (
          <a class="sz-film__more" href={videothek}>
            {de ? 'Mehr in der Videothek →' : 'More in the Videothek →'}
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<style>
  .sz-film {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .sz-film__frame {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--film-accent) 0%, transparent);
    transition: box-shadow 0.4s var(--ease);
  }
  .sz-film__frame:hover,
  .sz-film__frame:focus-within {
    box-shadow: 0 0 0 1px var(--film-accent), 0 18px 60px -30px var(--film-accent);
  }
  .sz-film__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-3);
  }
  .sz-film__kicker {
    font: 500 var(--fs-xs) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--film-accent);
  }
  .sz-film__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    text-transform: uppercase;
  }
  .sz-film__meta {
    font: 500 var(--fs-xs) var(--font-mono);
    color: var(--text-muted);
  }
  .sz-film__more {
    margin-left: auto;
    font-size: var(--fs-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .sz-film__frame {
      transition: none;
    }
  }
</style>

