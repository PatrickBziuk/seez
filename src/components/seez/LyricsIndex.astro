---
/**
 * LyricsIndex (KONZEPT B8): every lyric from src/data/lyrics.json, filterable by figure.
 * Part of the music page (#lyrics) since the separate /lyrics page was merged into it.
 * EP lyrics come first in Spotify order and link to their song page; all others are
 * drafts of songs in progress and open in place.
 */
import FigureChip from '~/components/seez/FigureChip.astro';
import FigureGlyph from '~/components/seez/FigureGlyph.astro';
import LyricsBlock from '~/components/seez/LyricsBlock.astro';
import { FIGURES, getFigure } from '~/data/figures';
import { EP_TRACKS, LYRICS, songSlugForLyrics } from '~/data/songs';
import { getSongRecords } from '~/utils/music';
import { sectionUrl, type Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const records = await getSongRecords();
const epLyrics = new Set(EP_TRACKS.map((t) => t.lyricsId).filter(Boolean));
const trackNo = (id: string) => EP_TRACKS.find((t) => t.lyricsId === id)?.no;
const order = new Map(FIGURES.map((f, i) => [f.id, i]));
const items = LYRICS.map((l) => {
  const slug = songSlugForLyrics(l.id);
  return {
    ...l,
    onEp: epLyrics.has(l.id),
    no: trackNo(l.id),
    href: slug && records.some((r) => r.slug === slug) ? sectionUrl(lang, 'music', slug) : undefined,
  };
}).sort(
  (a, b) =>
    Number(b.onEp) - Number(a.onEp) ||
    (a.no ?? 99) - (b.no ?? 99) ||
    (order.get(a.figure) ?? 9) - (order.get(b.figure) ?? 9) ||
    a.title.localeCompare(b.title, 'de')
);
---

<div class="ly">
  <div
    class="ly__filter"
    role="group"
    aria-label={de ? 'Nach Figur filtern' : 'Filter by figure'}
    data-ly-filter
    hidden
  >
    <button type="button" aria-pressed="true" data-fig="">{de ? 'Alle' : 'All'}</button>
    {
      FIGURES.map((f) => (
        <button type="button" aria-pressed="false" data-fig={f.id} style={`--fig:${f.accent.dark}`}>
          <FigureGlyph id={f.id} size={16} />
          {f.name}
        </button>
      ))
    }
  </div>
  <p class="sz-muted ly__count" aria-live="polite" data-ly-count></p>

  {!de && <p class="sz-muted">Lyrics are in German.</p>}
  <ul class="ly__list reveal-stagger" lang="de">
    {
      items.map((l) => (
        <li
          class="ly__item"
          id={`lyrics-${l.id}`}
          data-fig={l.figure}
          style={`--fig:${getFigure(l.figure)?.accent.dark}`}
        >
          <div class="ly__head">
            <h3 class="ly__title">{l.title}</h3>
            <FigureChip figure={l.figure} lang={lang} />
            <span class="sz-label" lang={lang}>
              {l.onEp ? `EP · Track ${l.no}` : de ? 'in Arbeit' : 'in progress'}
            </span>
          </div>
          <div class="ly__actions">
            <details class="ly__details">
              <summary lang={lang}>{de ? 'Text anzeigen' : 'Show lyrics'}</summary>
              <LyricsBlock text={l.text} idPrefix={`all-${l.id}`} />
            </details>
            {l.href && (
              <a class="sz-link ly__go" href={l.href} lang={lang}>
                {de ? 'Zur Songseite' : 'Song page'} →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<script is:inline define:vars={{ de }}>
  (() => {
    const bar = document.querySelector('[data-ly-filter]');
    const count = document.querySelector('[data-ly-count]');
    if (!bar) return;
    bar.hidden = false;
    const items = [...document.querySelectorAll('.ly__item')];
    const apply = (fig) => {
      let n = 0;
      items.forEach((li) => {
        const show = !fig || li.dataset.fig === fig;
        li.hidden = !show;
        if (show) n += 1;
      });
      bar
        .querySelectorAll('button')
        .forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.fig || '') === fig)));
      if (count) count.textContent = fig ? (de ? `${n} Texte` : `${n} lyrics`) : '';
    };
    bar.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (b) apply(b.dataset.fig || '');
    });
    // Links from the song overview (#lyrics-<id>): show the text and open it.
    const openFromHash = () => {
      const li = location.hash.startsWith('#lyrics-') && document.getElementById(location.hash.slice(1));
      if (!li) return;
      if (li.hidden) apply('');
      const d = li.querySelector('details');
      if (d) d.open = true;
    };
    window.addEventListener('hashchange', openFromHash);
    openFromHash();
  })();
</script>

<style>
  .ly__item {
    scroll-margin-top: 80px;
  }
  .ly__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .ly__filter button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--sp-4);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--fig, var(--line-strong));
    border-radius: var(--radius);
    font: 500 var(--fs-sm) / 1 var(--font-sans);
    cursor: pointer;
  }
  .ly__filter button :global(.sz-glyph) {
    color: var(--fig);
  }
  .ly__filter button[aria-pressed='true'] {
    background: var(--invert-bg);
    color: var(--invert-text);
  }
  .ly__filter button[aria-pressed='true'] :global(.sz-glyph) {
    color: var(--invert-text);
  }
  .ly__count {
    min-height: 1.6em;
    margin-top: var(--sp-3);
  }
  .ly__list {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .ly__item {
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--line);
  }
  .ly__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .ly__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1.1;
    margin-right: var(--sp-2);
  }
  .ly__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-3);
  }
  .ly__go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .ly__details {
    flex: 1 1 100%;
    order: 2;
  }
  .ly__details summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ly__details[open] summary {
    margin-bottom: var(--sp-4);
  }
</style>
