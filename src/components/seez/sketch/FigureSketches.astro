---
/**
 * FigureSketches: "Frühe Skizzen" in the wiki part of a figure page (inside "Wissenswertes").
 * Shows drawings from the Skizzenbuch 2011–2013 that share visible motifs with the figure
 * sheet, in the figure's accent (var(--fig)). Worded as observations, never as intent.
 * Renders nothing for figures without a match (Drift, Shift).
 */
import { Image } from 'astro:assets';
import SketchInk from './SketchInk.astro';
import { FIGURE_SKETCHES, PROFILE, PROFILE_NOTE, SKETCH_YEARS, getSketch } from '~/data/sketches';
import type { FigureId } from '~/data/figures';
import type { Lang } from '~/utils/routes';

interface Props {
  figure: FigureId;
  lang: Lang;
}
const { figure, lang } = Astro.props;
const de = lang === 'de';
const items = (FIGURE_SKETCHES[figure] || [])
  .map((x) => ({ sketch: getSketch(x.sketch)!, note: x.note[lang] }))
  .filter((x) => x.sketch);
const withPhoto = figure === 'splinter';
const about = `/${lang}/about`;
---

{
  (items.length > 0 || withPhoto) && (
    <>
      <h3 class="fsk__h" id="fruehe-skizzen">
        {de ? 'Frühe Skizzen' : 'Early sketches'}
      </h3>
      <p class="fsk__intro">
        {de
          ? `Aus dem Skizzenbuch ${SKETCH_YEARS}: Zeichnungen mit Motiven, die auch zu dieser Figur gehören.`
          : `From the ${SKETCH_YEARS} sketchbook: drawings with motifs that also belong to this figure.`}
      </p>
      <ul class="fsk reveal-stagger">
        {withPhoto && (
          <li class="fsk__item">
            <a class="fsk__frame fsk__frame--photo" href={`${about}#ursprung`}>
              <Image
                src={PROFILE.image}
                alt={PROFILE.alt[lang]}
                widths={[320, 640]}
                sizes="(min-width: 900px) 240px, 45vw"
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
              />
            </a>
            <p class="fsk__note">{PROFILE_NOTE[lang]}</p>
          </li>
        )}
        {items.map(({ sketch, note }) => (
          <li class="fsk__item">
            <a class="fsk__frame" href={`${about}#skizze-${sketch.id}`}>
              <SketchInk ink={sketch.ink} label={sketch.alt[lang]} colour="var(--fig)" />
            </a>
            <p class="fsk__note">{note}</p>
          </li>
        ))}
      </ul>
      <p class="fsk__more">
        <a class="sz-link" href={`${about}#skizzenbuch`}>
          {de ? `Skizzenbuch ${SKETCH_YEARS}` : `Sketchbook ${SKETCH_YEARS}`}{' '}
          <span class="sz-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </>
  )
}

<style>
  /* same as .wiki-h3 in FigurePage (scoped there) */
  .fsk__h {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-md);
    text-transform: uppercase;
    margin-top: var(--sp-6);
    scroll-margin-top: calc(64px + var(--sp-4));
  }
  .fsk__intro {
    margin-top: var(--sp-3);
    max-width: var(--measure);
    color: var(--text-muted);
  }
  .fsk {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: var(--sp-5);
  }
  .fsk__item {
    min-width: 0;
  }
  .fsk__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: var(--sp-3);
    border: 1px solid var(--line);
    background: var(--bg);
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .fsk__frame:is(:hover, :focus-visible) {
    border-color: var(--fig);
  }
  .fsk__frame :global(.sz-ink) {
    width: 100%;
    height: 100%;
  }
  .fsk__frame--photo {
    padding: 0;
    overflow: hidden;
  }
  .fsk__frame--photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fsk__note {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .fsk__more {
    margin-top: var(--sp-4);
  }
</style>
