---
/**
 * FigureGlyph - one line glyph per figure (KONZEPT B4), 24px grid, 1.5px stroke, currentColor.
 * Replaces the emoji symbols. Decorative by default (aria-hidden); pass `label` to expose it.
 */
interface Props {
  id: string;
  size?: number;
  label?: string;
  class?: string;
}
const { id, size = 24, label, class: className = '' } = Astro.props;
---

<svg
  class:list={['sz-glyph', `sz-glyph--${id}`, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    id === 'splinter' && (
      <>
        {/* mirror oval with a crack */}
        <ellipse cx="12" cy="11" rx="6.5" ry="8.5" />
        <path class="g-draw" d="M10 3.6 12.6 8.4 10.4 11.2 13.4 15.2 12 19.4" />
        <path d="M12 19.5v1.8M9.5 21.3h5" />
      </>
    )
  }
  {
    id === 'lume' && (
      <>
        {/* flacon with a point of light */}
        <path d="M10 3h4M10.5 3v3.2L7 10.5v7.5a3 3 0 0 0 3 3h4a3 3 0 0 0 3-3v-7.5l-3.5-4.3V3" />
        <circle class="g-light" cx="12" cy="14.5" r="1.6" fill="currentColor" />
      </>
    )
  }
  {
    id === 'drift' && (
      <>
        {/* anchor without a chain */}
        <circle cx="12" cy="4.8" r="1.8" />
        <path d="M12 6.6v14.2M8 10h8M4.5 14.5c0 3.6 3.4 6.3 7.5 6.3s7.5-2.7 7.5-6.3" />
        <path d="M3 15.8l1.5-1.3 1.6 1.3M17.9 15.8l1.6-1.3 1.5 1.3" />
      </>
    )
  }
  {
    id === 'shift' && (
      <>
        {/* time card with punch holes */}
        <rect x="5" y="2.8" width="14" height="18.4" rx="1" />
        <path d="M8 7h8M8 10.5h8M8 14h5" />
        <circle class="g-stamp" cx="15.5" cy="17.4" r="1.1" fill="currentColor" />
        <circle cx="11.8" cy="17.4" r="1.1" />
      </>
    )
  }
  {
    id === 'gl1tch' && (
      <>
        {/* visor with three LED lines */}
        <rect x="2.8" y="6.5" width="18.4" height="11" rx="3" />
        <path class="g-led" d="M6.5 10h4.5M13 10h4.5M8 14h8" />
      </>
    )
  }
  {
    id === 'unknown' && (
      <>
        {/* stamp circle with a question mark */}
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="6.6" stroke-dasharray="1.6 1.8" />
        <path d="M10.2 10.2a1.9 1.9 0 1 1 2.7 1.7c-.6.3-.9.8-.9 1.4v.5M12 16.2v.01" />
      </>
    )
  }
</svg>
