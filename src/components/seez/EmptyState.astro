---
/**
 * EmptyState - an honest sentence instead of "LOCKED" tiles (KONZEPT B6).
 * Motion: reveals on scroll; three "generating" dots after the title run a few times and
 * rest (motion.css .sz-dots, static with reduced motion).
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="sz-empty reveal">
  <p class="sz-empty__title">
    {title}
    <span class="sz-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </p>
  <div class="sz-empty__body"><slot /></div>
</div>

<style>
  .sz-empty {
    border: 1px dashed var(--line-strong);
    padding: var(--sp-6) var(--sp-5);
    border-radius: var(--radius);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .sz-empty__title {
    color: var(--text);
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }
</style>
