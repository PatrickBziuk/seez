---
/**
 * SongRow (KONZEPT B6): title · figure chips · status · listen · lyrics · video mark.
 * Rendered inside an <ol>/<ul> by the caller.
 */
import FigureChip from './FigureChip.astro';
import type { Lang } from '~/utils/routes';

interface Props {
  lang: Lang;
  title: string;
  href?: string;
  figures: string[];
  note?: string;
  status?: string;
  listen?: string;
  lyricsHref?: string;
  hasVideo?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Track number on the release (Spotify) */
  no?: number;
  /** Duration m:ss (Spotify) */
  length?: string;
  explicit?: boolean;
  /** Play button that drives an AudioPlayer on the page (its id and the track's index there) */
  play?: { player: string; index: number };
  /** Link to the song's music video (song page #video) */
  videoHref?: string;
}
const {
  lang,
  title,
  href,
  figures,
  note,
  status,
  listen,
  lyricsHref,
  hasVideo,
  headingLevel = 'h3',
  no,
  length,
  explicit,
  play,
  videoHref,
} = Astro.props;
const de = lang === 'de';
const H = headingLevel;
---

<li class:list={['sz-songrow', no != null && 'sz-songrow--numbered']}>
  {
    no != null && (
      <span class="sz-songrow__no" aria-hidden="true">
        {String(no).padStart(2, '0')}
      </span>
    )
  }
  <div class="sz-songrow__main">
    <H class="sz-songrow__title">
      {no != null && <span class="sr-only">{de ? `Track ${no}: ` : `Track ${no}: `}</span>}
      {href ? <a href={href}>{title}</a> : title}
      {
        explicit && (
          <abbr class="sz-songrow__e" title={de ? 'Explizit' : 'Explicit'}>
            E
          </abbr>
        )
      }
    </H>
    {note && <p class="sz-songrow__note">{note}</p>}
  </div>
  <div class="sz-songrow__figs">
    {figures.map((f) => <FigureChip figure={f} lang={lang} compact />)}
  </div>
  <div class="sz-songrow__meta">
    {length && <span class="sz-mono sz-songrow__len">{length}</span>}
    {status && <span class="sz-label">{status}</span>}
    {hasVideo && !videoHref && <span class="sz-label">▶ Video</span>}
  </div>
  <div class="sz-songrow__actions">
    {
      play && (
        <button
          type="button"
          class="sz-songrow__play"
          data-ep-player={play.player}
          data-ep-play={play.index}
          aria-pressed="false"
        >
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
          <span>{de ? 'Abspielen' : 'Play'}</span>
          <span class="sr-only"> – {title}</span>
        </button>
      )
    }
    {
      videoHref && (
        <a href={videoHref}>
          Video<span class="sr-only"> – {title}</span>
        </a>
      )
    }
    {
      listen && !play && (
        <a href={listen} rel="noopener">
          {de ? 'Hören' : 'Listen'}
          <span class="sr-only"> – {title}</span>
        </a>
      )
    }
    {
      lyricsHref && (
        <a href={lyricsHref}>
          Lyrics<span class="sr-only"> – {title}</span>
        </a>
      )
    }
  </div>
</li>

<style>
  .sz-songrow {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2) var(--sp-5);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .sz-songrow__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-lg);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .sz-songrow__title a {
    color: var(--text);
    text-decoration: none;
  }
  .sz-songrow__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .sz-songrow__note {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin-top: 4px;
    max-width: 60ch;
  }
  .sz-songrow__figs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sz-songrow__meta {
    display: flex;
    gap: var(--sp-3);
  }
  .sz-songrow__actions {
    display: flex;
    justify-content: flex-start;
    gap: var(--sp-2);
  }
  .sz-songrow__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .sz-songrow__actions a:hover {
    border-color: var(--text);
  }
  .sz-songrow__play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--text);
    border-radius: var(--radius);
    background: var(--text);
    color: var(--bg);
    font: 600 var(--fs-sm) / 1 var(--font-sans);
    cursor: pointer;
    transition:
      transform var(--t-hover) var(--ease),
      background var(--t-hover) var(--ease);
  }
  .sz-songrow__play:hover {
    transform: translateY(-1px);
  }
  .sz-songrow__play svg {
    width: 14px;
    height: 14px;
  }
  .sz-songrow__play .i-pause,
  .sz-songrow__play.is-playing .i-play {
    display: none;
  }
  .sz-songrow__play.is-playing .i-pause {
    display: block;
  }
  .sz-songrow__play.is-playing {
    background: transparent;
    color: var(--text);
  }
  .sz-songrow__play:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sz-songrow__play {
      transition: none;
    }
  }
  .sz-songrow--numbered {
    grid-template-columns: 2.2em minmax(0, 1fr);
  }
  .sz-songrow--numbered > :not(.sz-songrow__no):not(.sz-songrow__main) {
    grid-column: 2;
  }
  .sz-songrow__no {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    align-self: start;
    padding-top: 0.35em;
  }
  .sz-songrow__e {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.5em;
    width: 1.3em;
    height: 1.3em;
    border-radius: 2px;
    background: var(--text-muted);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.5em;
    font-weight: 600;
    text-decoration: none;
    vertical-align: middle;
  }
  .sz-songrow__len {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 900px) {
    .sz-songrow {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.5fr) 110px 230px;
    }
    .sz-songrow--numbered {
      grid-template-columns: 2.6em minmax(0, 2.2fr) minmax(0, 1.5fr) 110px 230px;
    }
    .sz-songrow--numbered > :not(.sz-songrow__no):not(.sz-songrow__main) {
      grid-column: auto;
    }
  }
</style>
