---
/**
 * Layout - Main site layout, wraps all pages with header, footer, and global styles
 * @props {children: any} - Page content
 * @behavior Provides consistent structure, navigation, and global styles
 * @dependencies CustomStyles.astro, Favicons.astro, Header, Footer, PerformanceMonitor.astro
 * @usedBy All pages, MarkdownLayout.astro, PageLayout.astro
 */

import '~/assets/styles/tailwind.css';

import { getI18nConfig } from '~/config/seez.config';
import { buildAlternates, shouldHaveAlternates } from '~/utils/seo/alternates';

import CommonMeta from '~/components/core/meta/CommonMeta.astro';
import Favicons from '~/components/core/meta/Favicons.astro';
import CustomStyles from '~/components/core/meta/CustomStyles.astro';
import CriticalCSS from '~/components/core/meta/CriticalCSS.astro';
import ApplyColorMode from '~/components/core/meta/ApplyColorMode.astro';
import Metadata from '~/components/core/meta/Metadata.astro';
import SiteVerification from '~/components/core/meta/SiteVerification.astro';
import Analytics from '~/components/core/meta/Analytics.astro';
import BasicScripts from '~/components/core/meta/BasicScripts.astro';
import PerformanceMonitor from '~/components/core/performance/PerformanceMonitor.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

const i18nConfig = getI18nConfig();

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { defaultLanguage, supportedLanguages } = i18nConfig;
// Fix T36-001: Use actual page language from route params with fallback
const currentLang = Astro.params.lang ?? defaultLanguage;
const textDirection = 'ltr'; // Seez supports LTR languages

// Fix T36-002: Normalize route assumptions for alternates
const availableLanguages = supportedLanguages;
const alternateLanguages = shouldHaveAlternates(Astro.url.pathname) ? buildAlternates(Astro, availableLanguages) : [];
---

<!doctype html>
<html lang={currentLang} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CriticalCSS />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} alternateLanguages={alternateLanguages} />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
    <PerformanceMonitor debug={import.meta.env.DEV} />
  </body>
</html>
