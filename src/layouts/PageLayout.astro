---
/**
 * PageLayout - every page: site header, <main id="main">, site footer.
 * Header and footer follow KONZEPT B6/B8 (src/components/seez/).
 */
import Layout from '~/layouts/Layout.astro';
import SiteHeader from '~/components/seez/SiteHeader.astro';
import SiteFooter from '~/components/seez/SiteFooter.astro';
import type { MetaData } from '~/types';
import { langOf } from '~/utils/routes';

export interface Props {
  metadata?: MetaData;
  /** Extra class on <main>, e.g. a figure world */
  mainClass?: string;
  mainStyle?: string;
}

const { metadata, mainClass, mainStyle } = Astro.props;
const lang = langOf(Astro.url.pathname);
---

<Layout metadata={metadata}>
  <slot name="header">
    <SiteHeader lang={lang} />
  </slot>
  <main id="main" tabindex="-1" class={mainClass} style={mainStyle}>
    <slot />
  </main>
  <slot name="footer">
    <SiteFooter lang={lang} />
  </slot>
</Layout>
