---
/**
 * MarkdownLayout - Layout for rendering Markdown content with metadata and responsive design
 * @props {frontmatter: Object, entry: Object} - Markdown frontmatter and entry data
 * @behavior Displays Markdown content, injects metadata, supports badges and i18n, includes SEO
 * @dependencies ContentMetadata, SEO, CustomStyles.astro, Favicons.astro
 * @usedBy [slug].astro, books, projects, lab, life collections
 */

import Layout from '~/layouts/PageLayout.astro';
import Metadata from '~/components/core/meta/Metadata.astro';
import ContentMetadata from '~/components/content/metadata/ContentMetadata.astro';
import ArticleFooter from '~/components/article/ArticleFooter.astro';
import ContentFallbackNotice from '~/components/content/metadata/ContentFallbackNotice.astro';
import { getTranslations, detectLanguage } from '~/utils/i18n';
import { getEntry } from 'astro:content';

import type { MetaData, Status } from '~/types';
import type { ReferenceDataEntry } from 'astro:content';

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    language?: 'en' | 'de';
    timestamp?: string;
    publishDate?: Date;
    firstPublishDate?: Date;
    lastChangeDate?: Date;
    modifiedDate?: Date;
    publicationStatus?: 'draft' | 'published' | 'archived';
    changeLog?: Array<{
      date: string;
      description: string;
      author?: string;
      type: 'content' | 'metadata' | 'structure' | 'translation';
      automated: boolean;
    }>;
    status?: Status;
    tags?: string[];
    ai_tldr?: string;
    draft?: boolean;
    // Author system - supporting both reference format and legacy string format
    authors?: ReferenceDataEntry<'authors'>[] | string[];
    translators?: string[];
    // Sources and references
    sources?: Array<{
      title: string;
      url?: string;
      author?: string;
      date?: string;
      type: string;
      description?: string;
    }>;
    // Canonical ID system fields
    canonicalId?: string;
    originalLanguage?: 'en' | 'de';
    translationOf?: string;
    sourceLanguage?: 'en' | 'de';
    // AI metadata with new schema structure
    ai_metadata?: {
      translation?: {
        model?: string;
        at: string;
        sourceLanguage: 'en' | 'de';
        targetLanguage: 'en' | 'de';
        tokens?: number;
        cost?: number;
        co2?: number;
      };
      // Legacy support
      canonicalId?: string;
      translationOf?: string;
      tokenUsage?: {
        translation?: {
          // New schema format
          tokens?: number;
          cost?: number;
          co2?: number;
          // Legacy schema format - more detailed
          operation?: string;
          canonicalId?: string;
          model?: string;
          inputTokens?: number;
          outputTokens?: number;
          totalTokens?: number;
          co2Impact?: number;
          timestamp?: string;
          sourceLanguage?: string;
          targetLanguage?: string;
        };
        tldr?: {
          tokens?: number;
          cost?: number;
          co2?: number;
        };
        total?: {
          tokens?: number;
          cost?: number;
          co2?: number;
        };
      };
    };
    // Plan 10031: New frontmatter fields from remark plugins
    wordCount?: number;
    readingTime?: number;
    readingFormatted?: string;
    lastModified?: string;
  };
  entry?: {
    collection: string;
    slug: string;
    id: string;
  };
}

const { frontmatter, entry } = Astro.props;
const currentLanguage = detectLanguage(Astro.url.pathname);
const translations = await getTranslations(currentLanguage);

// Ensure frontmatter has the correct type with new fields
const typedFrontmatter = frontmatter as typeof frontmatter & {
  firstPublishDate?: Date;
  lastChangeDate?: Date;
  publicationStatus?: 'draft' | 'published' | 'archived';
  changeLog?: Array<{
    date: string;
    description: string;
    author?: string;
    type: 'content' | 'metadata' | 'structure' | 'translation';
    automated: boolean;
  }>;
};

// Try to import git metadata, fallback to empty object if file doesn't exist
let gitMetadata: Record<string, { publishDate?: string; modifiedDate?: string }> = {};
try {
  const gitModule = await import('../generated/git-metadata.json');
  gitMetadata = gitModule.default || gitModule;
} catch {
  if (import.meta.env.DEV) {
    console.warn('Git metadata not found, using frontmatter dates only');
  }
}

// Get entry content for reading statistics if entry is provided
let entryContent = '';
if (entry) {
  try {
    const entryData = await getEntry(entry.collection as 'projects' | 'pages' | 'post' | 'authors', entry.slug);
    if (entryData) {
      entryContent = entryData.body || '';
    }
  } catch (e) {
    console.warn('Failed to get entry content for reading stats:', e);
  }
}

const filePath = entry ? `src/content/${entry.collection}/${entry.id}` : '';
const gitData = gitMetadata[filePath];

// Combine frontmatter dates with git dates
const publishDate = frontmatter.publishDate
  ? new Date(frontmatter.publishDate)
  : gitData?.publishDate
    ? new Date(gitData.publishDate)
    : undefined;
const modifiedDate = frontmatter.modifiedDate
  ? new Date(frontmatter.modifiedDate)
  : gitData?.modifiedDate
    ? new Date(gitData.modifiedDate)
    : undefined;

// Generate alternate language URLs using canonical ID format
const alternateLocales = [];
if (entry && frontmatter.canonicalId) {
  if (frontmatter.language === 'de') {
    alternateLocales.push({
      locale: 'en',
      url: `https://seez.eu/en/${entry.collection}/${entry.slug}-${frontmatter.canonicalId}`,
    });
  } else {
    alternateLocales.push({
      locale: 'de',
      url: `https://seez.eu/de/${entry.collection}/${entry.slug}-${frontmatter.canonicalId}`,
    });
  }
}

const metadata: MetaData = {
  title: frontmatter?.title,
  description: frontmatter?.description,
};
---

<Layout metadata={metadata}>
  <Metadata
    canonicalId={frontmatter.canonicalId}
    title={frontmatter.title || 'Untitled'}
    description={frontmatter.description}
  />

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="mb-6">
      <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">
        {frontmatter.title}
      </h1>
    </div>

    <ContentMetadata
      language={typedFrontmatter.language}
      timestamp={typedFrontmatter.timestamp}
      publishDate={publishDate}
      firstPublishDate={typedFrontmatter.firstPublishDate}
      lastChangeDate={typedFrontmatter.lastChangeDate}
      modifiedDate={modifiedDate}
      publicationStatus={typedFrontmatter.publicationStatus}
      changeLog={typedFrontmatter.changeLog}
      status={typedFrontmatter.status}
      ai_tldr={typedFrontmatter.ai_tldr}
      ai_metadata={typedFrontmatter.ai_metadata}
      authors={typedFrontmatter.authors}
      translators={typedFrontmatter.translators}
      autoExpandTldr={false}
      translations={translations}
      locale={currentLanguage}
      content={entryContent}
      entry={entry}
    />
    {
      frontmatter.language && frontmatter.language !== currentLanguage && (
        <ContentFallbackNotice originalLanguage={frontmatter.language} currentLanguage={currentLanguage} />
      )
    }

    <div
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
    >
      <slot />
    </div>

    <!-- New Article Footer (Plan 10031) -->
    <ArticleFooter
      title={frontmatter.title || 'Untitled'}
      url={Astro.url}
      wordCount={frontmatter.wordCount}
      readingTime={frontmatter.readingTime}
      readingFormatted={frontmatter.readingFormatted}
      publishDate={publishDate}
      lastModified={frontmatter.lastModified}
      canonicalId={frontmatter.canonicalId}
      language={frontmatter.language}
      slug={entry?.slug}
      tags={frontmatter.tags}
    />
  </section>
</Layout>
