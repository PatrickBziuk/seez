{
  "name": "@patrickbziuk/seez",
  "version": "1.0.0-beta.52",
  "description": "Seez: A Blog about sovereignty in the digital world, built on Astrowind.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^18.17.1 || ^20.3.0 || >= 21.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist/",
    "preview": "astro preview",
    "preview:search": "pnpm run build && pnpm run preview",
    "astro": "astro",
    "check": "pnpm run check:astro && pnpm run check:eslint && pnpm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test:translations": "node scripts/ci/test-translations.js",
    "test:routing": "node scripts/ci/test-routing.js",
    "test:ci": "pnpm run test:translations && pnpm run test:routing",
    "test:success-rate": "npx tsx scripts/ci/calculate-test-success-rate.ts",
    "test:success-rate:verbose": "npx tsx scripts/ci/calculate-test-success-rate.ts --verbose",
    "test": "playwright test",
    "test:core": "playwright test tests/core-consolidated.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:navigation": "playwright test tests/navigation.spec.ts",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:validation": "npx tsx tests/validation/content-validation.spec.ts && npx tsx tests/validation/frontmatter-validation.spec.ts && npx tsx tests/validation/translation-validation.spec.ts && npx tsx tests/validation/metadata-validation.spec.ts",
    "validate:schema": "npx tsx scripts/ci/content-schema-validator.ts",
    "validate:schema:dry": "npx tsx scripts/ci/content-schema-validator.ts --dry-run",
    "validate:schema:fix": "npx tsx scripts/ci/content-schema-validator.ts --verbose",
    "test:e2e": "playwright test tests/e2e/",
    "test:e2e:navigation": "playwright test tests/e2e/navigation.spec.ts",
    "test:e2e:content": "playwright test tests/e2e/content-loading.spec.ts",
    "test:e2e:search": "playwright test tests/e2e/search.spec.ts",
    "test:e2e:language": "playwright test tests/e2e/language-switching.spec.ts",
    "test:e2e:multilingual": "playwright test tests/e2e/multilingual-content.spec.ts",
    "test:components": "playwright test tests/components/",
    "test:components:tldr": "playwright test tests/components/tldr-component.spec.ts",
    "test:components:metadata": "playwright test tests/components/content-metadata.spec.ts",
    "test:components:social": "playwright test tests/components/social-share.spec.ts",
    "test:components:github": "playwright test tests/components/github-integration.spec.ts",
    "test:components:language": "playwright test tests/components/language-switcher.spec.ts",
    "test:components:search": "playwright test tests/components/search-functionality.spec.ts",
    "test:components:navigation": "playwright test tests/components/navigation.spec.ts",
    "test:accessibility": "playwright test tests/accessibility/",
    "test:accessibility:full": "playwright test tests/accessibility/accessibility.spec.ts",
    "test:performance": "playwright test tests/performance/",
    "test:performance:core": "playwright test tests/performance/performance.spec.ts",
    "test:performance:seo": "playwright test tests/performance/seo.spec.ts",
    "test:performance:vitals": "playwright test tests/performance/core-web-vitals.spec.ts",
    "test:performance:monitoring": "playwright test tests/performance/monitoring.spec.ts",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=Mobile-Chrome --project=Mobile-Safari",
    "test:desktop": "playwright test --project=Desktop-Chrome --project=Desktop-Firefox --project=Desktop-Safari",
    "test:tablet": "playwright test --project=iPad",
    "test:large-screen": "playwright test --project=Large-Desktop",
    "test:smoke": "playwright test tests/e2e/navigation.spec.ts tests/performance/monitoring.spec.ts",
    "test:regression": "playwright test tests/performance/monitoring.spec.ts",
    "test:health": "playwright test tests/performance/monitoring.spec.ts --grep='Site Health Monitoring'",
    "test:full": "pnpm run test:validation && pnpm run test:e2e && pnpm run test:components && pnpm run test:accessibility && pnpm run test:performance",
    "test:quick": "pnpm run test:smoke && pnpm run test:accessibility",
    "test:pre-deploy": "pnpm run test:validation && pnpm run test:smoke && pnpm run test:performance:vitals",
    "translations:check": "npx tsx scripts/translations/check_translations.ts",
    "translations:check-registry": "npx tsx scripts/translations/check_translations_registry.ts",
    "translations:generate": "npx tsx scripts/translations/generate_translations.ts && pnpm ai:aggregate",
    "translations:generate-registry": "npx tsx scripts/translations/generate_translations_registry.ts",
    "translations:conflicts": "npx tsx scripts/translations/detect_conflicts.ts",
    "extract:git-metadata": "npx tsx scripts/utils/extract-git-metadata.ts",
    "validate:content": "npx tsx scripts/validation/validate-content.ts",
    "validate:registry": "npx tsx scripts/validation/validate-canonical-registry.ts",
    "sync:content-metadata": "npx tsx scripts/content/sync-content-metadata.ts",
    "sync:content-metadata:dry": "npx tsx scripts/content/sync-content-metadata.ts --dry-run",
    "validate:seo": "npx tsx scripts/validation/test-canonical-seo.ts",
    "validate:publication": "npx tsx scripts/validation/validate-publication-readiness.ts",
    "review:status": "npx tsx scripts/validation/review-helper.ts status",
    "review:approve": "npx tsx scripts/validation/review-helper.ts review",
    "review:translation": "npx tsx scripts/validation/review-helper.ts review-translation",
    "review:all": "npx tsx scripts/validation/review-helper.ts review-all",
    "lint:content": "pnpm run validate:content",
    "dev:full": "pnpm run extract:git-metadata && astro sync && pnpm run dev",
    "tags:analyze": "npx tsx scripts/ai/ai-tagging/analyze-existing-tags.ts",
    "tags:build-registry": "npx tsx scripts/ai/ai-tagging/build-master-registry.ts",
    "tags:suggest": "npx tsx scripts/ai/ai-tagging/suggest-tags.ts",
    "tags:apply": "npx tsx scripts/ai/ai-tagging/apply-tag-suggestions.ts",
    "tags:setup": "pnpm run tags:analyze && pnpm run tags:build-registry",
    "tags:full-workflow": "pnpm run tags:suggest && pnpm run tags:apply",
    "tldr:generate": "npx tsx scripts/translations/generate_tldr_pipeline.ts && pnpm ai:aggregate",
    "tldr:generate-force": "npx tsx scripts/translations/generate_tldr_pipeline.ts --force && pnpm ai:aggregate",
    "tldr:generate-en": "npx tsx scripts/translations/generate_tldr_pipeline.ts --lang=en && pnpm ai:aggregate",
    "tldr:generate-de": "npx tsx scripts/translations/generate_tldr_pipeline.ts --lang=de && pnpm ai:aggregate",
    "tokens:summary": "npx tsx scripts/ai/token-tracking/cli.ts summary",
    "tokens:usage": "npx tsx scripts/ai/token-tracking/cli.ts usage",
    "tokens:export": "npx tsx scripts/ai/token-tracking/cli.ts export",
    "tokens:add-test": "npx tsx scripts/ai/token-tracking/cli.ts add",
    "ai:aggregate": "npx tsx scripts/aggregate-ai-ledger.ts",
    "ai:ledger:aggregate": "npx tsx scripts/aggregate-ai-ledger.ts",
    "ai:test-log": "npx tsx -e \"import {logTLDR} from './scripts/log-ai-usage.js'; logTLDR('test-canonical-id', 'gpt-4o-mini', 100, 50, 0.001);\"",
    "content:scan": "npx tsx scripts/content/content-canonical-system.ts scan",
    "content:validate": "npx tsx scripts/content/content-canonical-system.ts validate",
    "content:sync": "npx tsx scripts/content/content-sync-manager.ts sync",
    "content:sync-scan": "npx tsx scripts/content/content-sync-manager.ts scan",
    "content:sync-clean": "npx tsx scripts/content/content-sync-manager.ts clean",
    "content:sync-regenerate": "npx tsx scripts/content/content-sync-manager.ts regenerate",
    "content:analyze": "npx tsx scripts/content/analyze-content-relationships.ts",
    "content:classify": "npx tsx scripts/content/classify-content-relationships.ts",
    "content:resolve": "npx tsx scripts/content/resolve-content-divergence.ts",
    "content:fix-paths": "npx tsx scripts/content/fix-registry-paths.ts",
    "content:precommit": "npx tsx scripts/validation/validate-content-precommit.ts",
    "content:promote": "npx tsx scripts/utils/promote-content.ts",
    "content:promote-all": "npx tsx scripts/utils/promote-content.ts --all",
    "content:list-drafts": "npx tsx scripts/utils/promote-content.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@fontsource-variable/inter": "^5.2.5",
    "astro": "^5.7.3",
    "astro-embed": "^0.9.0",
    "astro-i18next": "^1.0.0-beta.21",
    "astro-icon": "^1.1.5",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.6",
    "gsap": "^3.13.0",
    "i18next": "^23.7.6",
    "limax": "4.1.0",
    "lodash.merge": "^4.6.2",
    "octokit": "^5.0.3",
    "openai": "^5.11.0",
    "unpic": "^4.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.2.4",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/tailwind": "^5.1.5",
    "@eslint/js": "^9.24.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.17",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "astro-compress": "2.3.8",
    "astro-eslint-parser": "^1.2.2",
    "astro-pagefind": "^1.8.3",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "glob": "^11.0.3",
    "globals": "^16.0.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "i18next-scanner": "^4.4.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.34.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "ulid": "^3.0.1",
    "unist-util-visit": "^5.0.0"
  }
}
